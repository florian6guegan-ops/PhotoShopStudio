<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>CourrielProbe</AssemblyName>
    <!-- sans cible de plateforme, les binaires natifs d'ONNX Runtime et de DirectML ne
         sont pas copies dans la sortie, et le reseau ne peut pas demarrer -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Studio.Printing\Studio.Printing.csproj" />
  </ItemGroup>
</Project>
