<Application x:Class="Studio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Palette sombre, dans l'esprit de DiLand : les opérateurs de la boutique la
             connaissent, et un fond sombre fait ressortir les photos au lieu de leur
             faire concurrence. Contraste tenu élevé pour rester lisible de loin. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#2C9BD6"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#1B7CAE"/>
        <SolidColorBrush x:Key="PageBrush" Color="#12181E"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1E2731"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#2A3440"/>
        <SolidColorBrush x:Key="TextBrush" Color="#ECEFF1"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#93A3B1"/>
        <SolidColorBrush x:Key="TitleBrush" Color="#F0932B"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E53935"/>
        <SolidColorBrush x:Key="OkBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="SeparatorBrush" Color="#33FFFFFF"/>

        <!-- Bouton tactile principal : grand, contrasté -->
        <Style x:Key="BigButton" TargetType="Button">
            <Setter Property="MinHeight" Value="76"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="28,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="#7A8794"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Variante secondaire : panneau sombre bordé, lisible sur fond noir -->
        <Style x:Key="FlatButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6B7883"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3A4652"/>
                                <Setter TargetName="border" Property="Background" Value="#1A222A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bascule d'un réglage : elle doit dire d'un coup d'œil si elle est enclenchée.
             Le style par défaut de WPF marque l'état coché par un gris à peine plus
             foncé, invisible sur fond sombre — on ne savait pas si le noir et blanc était
             actif (signalé le 01/08/2026). Ici l'état coché change le fond, le liseré et
             la couleur du texte : trois signaux plutôt qu'un. -->
        <Style x:Key="ToggleTile" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="10" BorderBrush="#3A4652" BorderThickness="2"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel LastChildFill="True">
                                <!-- La pastille dit l'état même à qui ne distingue pas
                                     bien les couleurs, et de loin. -->
                                <TextBlock x:Name="marque" DockPanel.Dock="Left" Text="○"
                                           FontSize="18" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="marque" Property="Text" Value="✓"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6B7883"/>
                                <Setter TargetName="border" Property="Background" Value="#1A222A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Titre d'écran : orangé, comme les titres de DiLand -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TitleBrush}"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Texte courant posé sur le fond sombre.

             WPF donne le NOIR à tout TextBlock qui n'hérite pas d'autre chose : sur nos
             cartes (#1E2731), l'écriture disparaît purement et simplement. C'est ce qui
             rendait illisibles les quantités, les totaux et la moitié de la fiche produit
             (signalé le 02/08/2026).

             Aucun style IMPLICITE n'est posé, et c'est délibéré : il repeindrait aussi le
             contenu des menus déroulants et des listes, qui gardent le fond clair du
             système — on troquerait du noir sur noir contre du blanc sur blanc. Un
             TextBlock hérite en revanche de la couleur du Bouton ou du Contrôle qui le
             contient : à l'intérieur d'un BigButton ou d'un FlatButton, il n'y a rien à
             faire.

             RÈGLE : tout TextBlock posé directement dans un Grid, un Border ou une
             StackPanel doit porter une couleur — ce style, Hint, PageTitle, ou la sienne. -->
        <Style x:Key="Texte" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- Valeur chiffrée d'un réglage : quantité, nombre de copies, total. -->
        <Style x:Key="Valeur" TargetType="TextBlock" BasedOn="{StaticResource Texte}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- ===== Menus déroulants =====

             Ils gardaient l'habillage de Windows : cadre gris clair, liste blanche, texte
             noir — une tache claire au milieu d'un écran sombre, et la seule pièce de
             l'application qui ne ressemblait pas au reste. Le style est IMPLICITE : les
             vingt-neuf listes de l'application en héritent sans qu'on ait à les toucher
             une à une.

             C'est aussi ce qui lève la réserve notée plus haut sur le style « Texte » : le
             contenu d'une liste n'a plus de fond clair à préserver, puisque la liste est
             sombre elle aussi. -->

        <SolidColorBrush x:Key="FieldBrush" Color="#232D38"/>

        <!-- La partie fermée : ce qu'on voit tant que la liste n'est pas ouverte. -->
        <Style x:Key="MenuDeroulantBascule" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="fond" Background="{StaticResource FieldBrush}"
                                CornerRadius="10" BorderBrush="#3A4652" BorderThickness="2">
                            <!-- La flèche est à DROITE et hors du flux du texte : le
                                 libellé passe dessous sinon, et « Automatique — selon le
                                 rouleau » finit sous le chevron. -->
                            <Path x:Name="chevron" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,14,0" Data="M 0,0 L 10,0 L 5,6 Z"
                                  Fill="{StaticResource AccentBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fond" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="fond" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="chevron" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fond" Property="Background" Value="#1A222A"/>
                                <Setter TargetName="fond" Property="BorderBrush" Value="#2A3440"/>
                                <Setter TargetName="chevron" Property="Fill" Value="#6B7883"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Une ligne de la liste ouverte. Le survol et la sélection prennent l'accent :
             sur un fond sombre, le gris à peine plus clair de Windows ne se voyait pas. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="fond" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" Margin="4,2">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="fond" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="fond" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6B7883"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          Style="{StaticResource MenuDeroulantBascule}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"/>

                            <!-- Le libellé vit dans un Border qui RÉSERVE la place du
                                 chevron à droite. Posé seul dans la grille, il passait
                                 dessous : « WPA / WPA2 / WPA3 (le cas courant) » recouvrait
                                 la flèche, qui disparaissait purement et simplement. -->
                            <Border Padding="{TemplateBinding Padding}" Margin="0,0,30,0"
                                    IsHitTestVisible="False">
                                <ContentPresenter
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Le nom « PART_Popup » n'est PAS décoratif : `ComboBox` le
                                 cherche dans son gabarit, et c'est ce qui déclenche le
                                 calcul de `SelectionBoxItemTemplate`. Sous un autre nom, la
                                 ligne fermée retombe sur le `ToString()` de l'objet — la
                                 liste des papiers affichait
                                 « ProductChoice { Product = Studio.Core.Domain.Product, … } »
                                 au lieu du libellé de `DisplayMemberPath`. -->
                            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                                   AllowsTransparency="True" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   MinWidth="{Binding ActualWidth,
                                              RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{StaticResource CardBrush}" CornerRadius="10"
                                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                                        Margin="0,4,0,0" Padding="0,4"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6B7883"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
