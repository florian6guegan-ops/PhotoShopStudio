<Application x:Class="Studio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Palette sombre, dans l'esprit de DiLand : les opérateurs de la boutique la
             connaissent, et un fond sombre fait ressortir les photos au lieu de leur
             faire concurrence. Contraste tenu élevé pour rester lisible de loin. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#2C9BD6"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#1B7CAE"/>
        <SolidColorBrush x:Key="PageBrush" Color="#12181E"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1E2731"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#2A3440"/>
        <SolidColorBrush x:Key="TextBrush" Color="#ECEFF1"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#93A3B1"/>
        <SolidColorBrush x:Key="TitleBrush" Color="#F0932B"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E53935"/>
        <SolidColorBrush x:Key="OkBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="SeparatorBrush" Color="#33FFFFFF"/>

        <!-- Bouton tactile principal : grand, contrasté -->
        <Style x:Key="BigButton" TargetType="Button">
            <Setter Property="MinHeight" Value="76"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="28,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="#7A8794"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Variante secondaire : panneau sombre bordé, lisible sur fond noir -->
        <Style x:Key="FlatButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6B7883"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3A4652"/>
                                <Setter TargetName="border" Property="Background" Value="#1A222A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Titre d'écran : orangé, comme les titres de DiLand -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TitleBrush}"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

    </Application.Resources>
</Application>
