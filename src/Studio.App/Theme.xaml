<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- LE THÈME DE STUDIO PHOTO, sorti de App.xaml pour être partageable.

         Il vivait dans <Application.Resources> de Studio.App, donc chargé par la seule
         application qui l'y déclarait. Studio Photo Identité est une AUTRE application, dans
         le même dépôt et sur le même moteur : elle a besoin des mêmes pinceaux et des mêmes
         gabarits de contrôles, sans quoi les écrans réutilisés sortent en noir sur noir.

         Rien n'a changé ici : c'est le contenu d'avant, déplacé. Les deux applications le
         fusionnent, et Identité repose sa propre palette par-dessus. -->

        <!-- Palette sombre, dans l'esprit de DiLand : les opérateurs de la boutique la
             connaissent, et un fond sombre fait ressortir les photos au lieu de leur
             faire concurrence. Contraste tenu élevé pour rester lisible de loin. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#2C9BD6"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#1B7CAE"/>
        <SolidColorBrush x:Key="PageBrush" Color="#12181E"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1E2731"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#2A3440"/>
        <SolidColorBrush x:Key="TextBrush" Color="#ECEFF1"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#93A3B1"/>
        <SolidColorBrush x:Key="TitleBrush" Color="#F0932B"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#E53935"/>
        <SolidColorBrush x:Key="OkBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="SeparatorBrush" Color="#33FFFFFF"/>

        <!-- Les gris des GABARITS, jusqu'ici ecrits en dur dans chaque ControlTemplate.
             Ils deviennent des cles pour qu'une AUTRE palette puisse les reposer : Studio
             Photo Identite est clair, et un lisere #3A4652 y serait une rayure noire.
             Valeurs inchangees, le Studio ne voit rien bouger. -->
        <SolidColorBrush x:Key="LigneBrush" Color="#3A4652"/>
        <SolidColorBrush x:Key="InactifFondBrush" Color="#1A222A"/>
        <SolidColorBrush x:Key="InactifTexteBrush" Color="#6B7883"/>

        <!-- Le fond de la scene de cadrage, sur lequel la photo se detache. -->
        <SolidColorBrush x:Key="SceneBrush" Color="#263238"/>

        <!-- Bouton tactile principal : grand, contrasté -->
        <Style x:Key="BigButton" TargetType="Button">
            <Setter Property="MinHeight" Value="76"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="28,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource InactifFondBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource InactifTexteBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Variante secondaire : panneau sombre bordé, lisible sur fond noir -->
        <Style x:Key="FlatButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource InactifTexteBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource LigneBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource InactifFondBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bascule d'un réglage : elle doit dire d'un coup d'œil si elle est enclenchée.
             Le style par défaut de WPF marque l'état coché par un gris à peine plus
             foncé, invisible sur fond sombre — on ne savait pas si le noir et blanc était
             actif (signalé le 01/08/2026). Ici l'état coché change le fond, le liseré et
             la couleur du texte : trois signaux plutôt qu'un. -->
        <Style x:Key="ToggleTile" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="10" BorderBrush="{DynamicResource LigneBrush}" BorderThickness="2"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel LastChildFill="True">
                                <!-- La pastille dit l'état même à qui ne distingue pas
                                     bien les couleurs, et de loin. -->
                                <TextBlock x:Name="marque" DockPanel.Dock="Left" Text="○"
                                           FontSize="18" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="marque" Property="Text" Value="✓"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource InactifTexteBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource InactifFondBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- LA CASE À COCHER, HABILLÉE COMME LES TUILES.
             Les cases de Windows font douze pixels de côté : à un mètre de l'écran, avec
             un client en face, on ne voit pas si « Contour de découpe » ou « N&amp;B » est
             actif — et l'on tire une planche entière pour s'en apercevoir. Celle-ci reprend
             exactement l'habillage de ToggleTile : même carte, même pastille, même fond
             accentué quand c'est coché. Le comportement, lui, ne change pas d'un pouce. -->
        <Style x:Key="CaseCochable" TargetType="CheckBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="10" BorderBrush="{DynamicResource LigneBrush}" BorderThickness="2"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel LastChildFill="True">
                                <TextBlock x:Name="marque" DockPanel.Dock="Left" Text="○"
                                           FontSize="18" Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="marque" Property="Text" Value="✓"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource InactifTexteBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource InactifFondBrush}"/>
                                <Setter TargetName="marque" Property="Text" Value="—"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Titre d'écran : orangé, comme les titres de DiLand -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBrush}"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Texte courant posé sur le fond sombre.

             WPF donne le NOIR à tout TextBlock qui n'hérite pas d'autre chose : sur nos
             cartes (#1E2731), l'écriture disparaît purement et simplement. C'est ce qui
             rendait illisibles les quantités, les totaux et la moitié de la fiche produit
             (signalé le 02/08/2026).

             Aucun style IMPLICITE n'est posé, et c'est délibéré : il repeindrait aussi le
             contenu des menus déroulants et des listes, qui gardent le fond clair du
             système — on troquerait du noir sur noir contre du blanc sur blanc. Un
             TextBlock hérite en revanche de la couleur du Bouton ou du Contrôle qui le
             contient : à l'intérieur d'un BigButton ou d'un FlatButton, il n'y a rien à
             faire.

             RÈGLE : tout TextBlock posé directement dans un Grid, un Border ou une
             StackPanel doit porter une couleur — ce style, Hint, PageTitle, ou la sienne. -->
        <Style x:Key="Texte" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>

        <!-- Valeur chiffrée d'un réglage : quantité, nombre de copies, total. -->
        <Style x:Key="Valeur" TargetType="TextBlock" BasedOn="{StaticResource Texte}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- ===== Menus déroulants =====

             Ils gardaient l'habillage de Windows : cadre gris clair, liste blanche, texte
             noir — une tache claire au milieu d'un écran sombre, et la seule pièce de
             l'application qui ne ressemblait pas au reste. Le style est IMPLICITE : les
             vingt-neuf listes de l'application en héritent sans qu'on ait à les toucher
             une à une.

             C'est aussi ce qui lève la réserve notée plus haut sur le style « Texte » : le
             contenu d'une liste n'a plus de fond clair à préserver, puisque la liste est
             sombre elle aussi. -->

        <SolidColorBrush x:Key="FieldBrush" Color="#232D38"/>

        <!-- La partie fermée : ce qu'on voit tant que la liste n'est pas ouverte. -->
        <Style x:Key="MenuDeroulantBascule" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="fond" Background="{DynamicResource FieldBrush}"
                                CornerRadius="10" BorderBrush="{DynamicResource LigneBrush}" BorderThickness="2">
                            <!-- La flèche est à DROITE et hors du flux du texte : le
                                 libellé passe dessous sinon, et « Automatique — selon le
                                 rouleau » finit sous le chevron. -->
                            <Path x:Name="chevron" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,14,0" Data="M 0,0 L 10,0 L 5,6 Z"
                                  Fill="{DynamicResource AccentBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fond" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="fond" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="chevron" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fond" Property="Background" Value="{DynamicResource InactifFondBrush}"/>
                                <Setter TargetName="fond" Property="BorderBrush" Value="{DynamicResource LigneBrush}"/>
                                <Setter TargetName="chevron" Property="Fill" Value="{DynamicResource InactifTexteBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Une ligne de la liste ouverte. Le survol et la sélection prennent l'accent :
             sur un fond sombre, le gris à peine plus clair de Windows ne se voyait pas. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="fond" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" Margin="4,2">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="fond" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="fond" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource InactifTexteBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          Style="{StaticResource MenuDeroulantBascule}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"/>

                            <!-- Le libellé vit dans un Border qui RÉSERVE la place du
                                 chevron à droite. Posé seul dans la grille, il passait
                                 dessous : « WPA / WPA2 / WPA3 (le cas courant) » recouvrait
                                 la flèche, qui disparaissait purement et simplement. -->
                            <Border Padding="{TemplateBinding Padding}" Margin="0,0,30,0"
                                    IsHitTestVisible="False">
                                <ContentPresenter
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Le nom « PART_Popup » n'est PAS décoratif : `ComboBox` le
                                 cherche dans son gabarit, et c'est ce qui déclenche le
                                 calcul de `SelectionBoxItemTemplate`. Sous un autre nom, la
                                 ligne fermée retombe sur le `ToString()` de l'objet — la
                                 liste des papiers affichait
                                 « ProductChoice { Product = Studio.Core.Domain.Product, … } »
                                 au lieu du libellé de `DisplayMemberPath`. -->
                            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                                   AllowsTransparency="True" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   MinWidth="{Binding ActualWidth,
                                              RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource CardBrush}" CornerRadius="10"
                                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                                        Margin="0,4,0,0" Padding="0,4"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource InactifTexteBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Cases à cocher, boutons radio et champs de saisie : WPF leur donne la couleur
            de TEXTE DU SYSTÈME, c'est-à-dire du NOIR, et un fond blanc aux seconds. Sur nos
            panneaux bleu-gris (CardBrush #1E2731, PanelBrush #2A3440), une vingtaine de
            libellés étaient donc écrits en noir sur bleu : « Noir et blanc », « Actif »,
            « Contour de découpe », les trois choix de détourage des paramètres…

            C'est le même défaut que le noir sur noir des TextBlock, et il se corrige ici
            plutôt qu'à chaque écran : ces trois types portent leur couleur EUX-MÊMES
            (Control.Foreground), et rien ne la leur transmet depuis le conteneur.

            Sans danger, contrairement à un style implicite de TextBlock : ces contrôles ne
            paraissent jamais dans une liste au fond clair du système.
        -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Le champ de mot de passe des paramètres restait BLANC au milieu de champs
             sombres : il n'est pas un TextBox et n'héritait donc de rien. -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LigneBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LigneBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <!-- Sans ces deux-là, le curseur est noir sur fond sombre — donc invisible —
                 et le texte sélectionné reste noir sous le bleu de la sélection. -->
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionTextBrush" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    
</ResourceDictionary>
