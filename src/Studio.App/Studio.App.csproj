<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <!-- L'icône de l'exécutable : bureau, barre des tâches, explorateur. Elle est
         VERSIONNÉE et non fabriquée à la compilation ; c'est tools/Studio.Logo qui la
         redessine, et seulement quand la marque change. -->
    <ApplicationIcon>Assets\studio-photo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- la même, embarquée : c'est celle que porte la fenêtre elle-même -->
    <Resource Include="Assets\studio-photo.ico" />

    <!-- Le curseur d'attente : le diaphragme du logo qui tourne, à la place du cercle
         bleu de Windows. Versionné et redessiné par tools/Studio.Logo, comme l'icône. -->
    <Resource Include="Assets\studio-attente.ani" />

    <!-- L'ÉCRAN D'ATTENTE DU DÉMARRAGE.
         Le raccourci passe par Lancer-Studio.cmd, qui recompile avant d'ouvrir : entre le
         clic et la fenêtre, l'opérateur n'avait qu'une console noire à l'icône de Windows,
         devant un client. WPF affiche cette image dès le lancement du processus et la fait
         disparaître d'elle-même quand la fenêtre principale paraît — sans une ligne de
         code, et sans rien retarder. -->
    <SplashScreen Include="Assets\studio-photo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- modèle de détection de visage embarqué à côté de l'exécutable -->
    <Content Include="..\..\models\face_detection_yunet_2023mar.onnx"
             Link="models\face_detection_yunet_2023mar.onnx"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Le suivi d'impression avance par des méthodes internes, appelées par
         l'orchestrateur et par les callbacks du minilab. C'est pourtant lui qui décide de
         ce que l'opérateur lit pendant qu'une commande sort, et il n'avait aucun essai :
         le compte a reculé pendant des semaines sans que rien ne le signale. Même
         mécanique que Studio.Imaging, Studio.Printing et Studio.Store. -->
    <InternalsVisibleTo Include="Studio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Studio.Core\Studio.Core.csproj" />
    <ProjectReference Include="..\Studio.Imaging\Studio.Imaging.csproj" />
    <ProjectReference Include="..\Studio.Printing\Studio.Printing.csproj" />
    <ProjectReference Include="..\Studio.Store\Studio.Store.csproj" />
    <ProjectReference Include="..\Studio.Sources\Studio.Sources.csproj" />
    <ProjectReference Include="..\Studio.Web\Studio.Web.csproj" />
  </ItemGroup>

</Project>
