<UserControl x:Class="Studio.App.Views.PrevenirClientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}"
                   Text="Prévenir le client"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="ResumeText" Style="{StaticResource Texte}"
                                   FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>

                        <TextBlock Text="Adresse du client" Style="{StaticResource Hint}"
                                   Margin="0,20,0,0"/>
                        <TextBox x:Name="AdresseBox" FontSize="22" Padding="12,10" Margin="0,6,0,0"
                                 TextChanged="OnSaisieChangee"/>

                        <TextBlock Text="Mot à ajouter (facultatif)" Style="{StaticResource Hint}"
                                   Margin="0,18,0,0"/>
                        <TextBox x:Name="MotBox" FontSize="18" Padding="12,10" Margin="0,6,0,0"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="OnSaisieChangee"/>

                        <TextBlock x:Name="EtatText" Style="{StaticResource Texte}" FontSize="17"
                                   Margin="0,18,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Ce que le client va lire, mot pour mot. Un message qui part chez un
                     client se relit avant, pas après. -->
                <TextBlock Text="Aperçu du message" Style="{StaticResource Texte}"
                           FontSize="20" FontWeight="SemiBold" Margin="0,24,0,8"/>

                <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="18">
                    <TextBlock x:Name="ApercuText" Style="{StaticResource Texte}"
                               FontSize="16" TextWrapping="Wrap" FontFamily="Consolas"/>
                </Border>

                <TextBlock Style="{StaticResource Hint}" FontSize="14" Margin="0,12,0,0"
                           TextWrapping="Wrap"
                           Text="Ce message ne contient AUCUNE photo : il annonce seulement que la commande attend en magasin. L'envoi des fichiers est une prestation à part, depuis « ✉ Envoyer »."/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource FlatButton}" MinWidth="160" Click="OnRetour">Retour</Button>
            <Button x:Name="EnvoyerButton" Style="{StaticResource BigButton}" MinWidth="280"
                    Margin="12,0,0,0" Click="OnEnvoyer" IsEnabled="False">🔔  Prévenir le client</Button>
        </StackPanel>
    </Grid>
</UserControl>
