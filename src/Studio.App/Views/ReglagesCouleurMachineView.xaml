<UserControl x:Class="Studio.App.Views.ReglagesCouleurMachineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Le titre et les explications viennent de la MACHINE réglée : le même écran sert
             la DNP et le minilab DE100, et les mots ne peuvent donc plus être en dur.
             Voir MachineCouleur. -->
        <TextBlock x:Name="TitreText" Grid.Row="0" Style="{StaticResource PageTitle}"/>

        <TextBlock x:Name="ExplicationText" Grid.Row="1" Style="{StaticResource Hint}"
                   TextWrapping="Wrap" Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- LE CHOIX. Un seul profil pour la machine : voir ProfilCouleurMachine. -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Texte}" FontSize="19" FontWeight="SemiBold"
                                   Text="Le profil appliqué"/>

                        <ComboBox x:Name="ProfilCombo" Margin="0,14,0,0" MinHeight="46" FontSize="17"
                                  SelectionChanged="OnProfilChange"/>

                        <TextBlock x:Name="EtatText" Style="{StaticResource Texte}" FontSize="16"
                                   Margin="0,12,0,0" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource FlatButton}" MinWidth="260" MinHeight="46"
                                    FontSize="16" Click="OnImporter">Ajouter un profil du poste…</Button>
                        </StackPanel>

                        <TextBlock x:Name="AideProfilsText" Style="{StaticResource Hint}"
                                   FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- CE QUE ÇA TOUCHE. L'opérateur doit voir la liste AVANT d'enregistrer :
                     c'est ainsi qu'on a découvert que l'E-Photo n'avait aucun profil alors
                     qu'elle sort de la même machine que la planche d'identité. -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Texte}" FontSize="19" FontWeight="SemiBold"
                                   Text="Ce que ce réglage touche"/>
                        <TextBlock x:Name="ProduitsText" Style="{StaticResource Texte}" FontSize="15"
                                   Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource FlatButton}" MinWidth="180" MinHeight="52" FontSize="19"
                    Click="OnRetour">Retour</Button>
            <Button x:Name="EnregistrerButton" Style="{StaticResource BigButton}" MinWidth="240"
                    MinHeight="52" FontSize="19" Margin="12,0,0,0" Click="OnEnregistrer">Enregistrer</Button>
        </StackPanel>
    </Grid>
</UserControl>
