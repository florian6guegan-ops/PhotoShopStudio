<UserControl x:Class="Studio.App.Views.CustomSizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Saisie" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Taille personnalisée" Style="{StaticResource PageTitle}"
                   HorizontalAlignment="Center"/>

        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="32">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,0,0,24"
                           Text="Donnez la taille de la photo finie. Le logiciel cherchera le plus petit papier où la quantité demandée tient."/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBox x:Name="LargeurBox" Style="{StaticResource Saisie}"
                             AutomationProperties.Name="Largeur en centimètres"
                             TextChanged="OnTailleTapee"/>
                    <TextBlock Text="×" FontSize="34" Margin="16,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <TextBox x:Name="HauteurBox" Style="{StaticResource Saisie}"
                             AutomationProperties.Name="Hauteur en centimètres"
                             TextChanged="OnTailleTapee"/>
                    <TextBlock Text="cm" FontSize="26" Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>

                <!-- LE CONTOUR DE DÉCOUPE, décidé ICI.

                     Un format libre sort presque toujours en PLANCHE, plusieurs tirages sur
                     une même feuille : le trait est ce qui dit où couper. Il ne se cochait
                     qu'à l'écran d'édition, photo par photo, et c'est le geste qu'on oublie
                     — une planche sans trait se coupe alors à l'œil. Demandé le 18/08/2026.

                     Ce n'est qu'une VALEUR DE DÉPART : l'édition reste libre de l'ôter sur
                     telle ou telle photo. -->
                <CheckBox x:Name="ContourNoirCheck" Style="{StaticResource CaseCochable}"
                          HorizontalAlignment="Center" Margin="0,22,0,0" FontSize="18"
                          Foreground="{DynamicResource TextBrush}" VerticalContentAlignment="Center"
                          Content="Contours noirs à découper"
                          ToolTip="Trace un trait noir de 0,2 mm sur le bord de chaque photo, à suivre aux ciseaux. À décocher si vous coupez au massicot sur repères."
                          Click="OnContourNoirChange"/>

                <!-- OÙ POSER LE BLOC SUR LA FEUILLE : deux coupes ou quatre.

                     Le bloc est CENTRÉ par défaut, et l'a toujours été. Sur une planche
                     pleine ça ne se voit pas — les photos touchent déjà les bords — mais sur
                     une planche large, l'opérateur se retrouve à massicoter les quatre côtés
                     d'un seul tirage. « Des fois il imprime bien dans un coin, des fois il te
                     le met au milieu » : c'est le même calcul, une planche différente.

                     Calé au coin, il reste 2 mm de blanc de ce côté et non zéro : à fond
                     perdu la machine rogne près d'un millimètre et demi, et coller le bloc au
                     bord rognerait la PHOTO. C'est le défaut des 7 × 10 du 20/08/2026, qui
                     avait justement été réparé en centrant. Demandé le 21/08/2026. -->
                <CheckBox x:Name="CalerAuCoinCheck" Style="{StaticResource CaseCochable}"
                          HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="18"
                          Foreground="{DynamicResource TextBrush}" VerticalContentAlignment="Center"
                          Content="Caler les photos dans un coin"
                          ToolTip="Pousse les photos dans le coin de la feuille au lieu de les centrer : il n'y a plus que deux bords à couper au lieu de quatre. Laissez décoché pour des marges égales tout autour."
                          Click="OnCalerAuCoinChange"/>

                <!-- LE SENS DE LA PHOTO, en toutes lettres.

                     Il se décidait par le seul ORDRE des deux nombres, et rien ne le disait :
                     « 8 × 6,5 » donne des photos couchées, « 6,5 × 8 » des photos debout. Un
                     opérateur qui pense « du 8 sur 6,5 » sans y voir un sens obtient donc des
                     cadrages coupés en travers — arrivé à Créteil le 14/08/2026 sur la
                     commande 14-018, et il n'y avait rien à l'écran pour s'en apercevoir.

                     Ces deux boutons échangent simplement la largeur et la hauteur. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <TextBlock Text="Sens (facultatif) :" Style="{StaticResource Hint}" FontSize="18"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button x:Name="PortraitButton" Style="{StaticResource FlatButton}"
                            MinWidth="170" MinHeight="52" FontSize="18" Click="OnPortrait"
                            ToolTip="Range la hauteur en plus grand. Le sens de sortie suit de toute façon vos cadrages : ce bouton ne sert qu'à voir le rendement.">▯  Debout</Button>
                    <Button x:Name="PaysageButton" Style="{StaticResource FlatButton}"
                            MinWidth="170" MinHeight="52" FontSize="18" Margin="12,0,0,0"
                            Click="OnPaysage"
                            ToolTip="Range la largeur en plus grand. Le sens de sortie suit de toute façon vos cadrages : ce bouton ne sert qu'à voir le rendement.">▭  Couchée</Button>
                </StackPanel>

                <!-- Les tailles déjà demandées : au comptoir, c'est presque toujours la même. -->
                <ItemsControl x:Name="RecentesList" Margin="0,20,0,0" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource FlatButton}" Margin="4" MinWidth="120"
                                    Content="{Binding Libelle}" Tag="{Binding}"
                                    AutomationProperties.Name="{Binding Libelle}"
                                    Click="OnTailleRecente"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Ce que ça donnera, avant d'engager du papier : l'opérateur annonce son
                     prix ici, pas après avoir choisi les photos. -->
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="20"
                        Margin="0,28,0,0" MinWidth="560">
                    <StackPanel>
                        <TextBlock x:Name="VerdictText" FontSize="20" FontWeight="SemiBold"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <ItemsControl x:Name="ApercuList" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Left" Width="150" FontSize="16"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Text="{Binding Quantite}"/>
                                        <TextBlock FontSize="16" Foreground="{DynamicResource TextBrush}"
                                                   Text="{Binding Resultat}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button x:Name="ContinuerButton" Style="{StaticResource BigButton}" MinWidth="260"
                    Margin="0,0,12,0" IsEnabled="False"
                    AutomationProperties.Name="Choisir les photos" Click="OnContinuer">
                ➜  Choisir les photos
            </Button>
            <Button Style="{StaticResource FlatButton}" MinWidth="200" Margin="0,0,12,0"
                    AutomationProperties.Name="Précédent" Click="OnBack">← Précédent</Button>
            <Button Style="{StaticResource FlatButton}" MinWidth="200"
                    AutomationProperties.Name="Annuler" Click="OnCancel">Annuler</Button>
        </StackPanel>
    </Grid>
</UserControl>
