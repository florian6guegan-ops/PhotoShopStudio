<UserControl x:Class="Studio.App.Views.PrintFormatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sélectionnez un format" Style="{StaticResource PageTitle}"
                   HorizontalAlignment="Center"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="FormatsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Tuile de format : nom lisible de loin, prix et paliers dessous,
                             comme la grille de DiLand. -->
                        <Button Width="300" Height="190" Margin="8" Cursor="Hand"
                                Background="{StaticResource CardBrush}" BorderThickness="0"
                                AutomationProperties.Name="{Binding Nom}"
                                Click="OnFormatChoisi" Tag="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="fond" Background="{TemplateBinding Background}"
                                            CornerRadius="12" BorderBrush="{StaticResource AccentBrush}"
                                            BorderThickness="2">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="fond" Property="Background"
                                                    Value="{StaticResource PanelBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="fond" Property="Background"
                                                    Value="{StaticResource AccentDarkBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>

                            <StackPanel>
                                <TextBlock Text="{Binding Nom}" FontSize="34" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           HorizontalAlignment="Center"/>

                                <!-- La MACHINE en pastille, et non plus en petit texte gris
                                     au milieu des cotes. Le catalogue porte deux produits
                                     nommés « 10x15 » — l'un au minilab, l'autre à la DS620 —
                                     et leurs deux tuiles se suivent dans la grille : la
                                     commande 04-024 du 04/08/2026 est partie sur la mauvaise
                                     machine parce que rien ne les distinguait au premier
                                     coup d'œil. -->
                                <Border CornerRadius="8" Padding="10,3" Margin="0,4,0,6"
                                        HorizontalAlignment="Center"
                                        Background="{Binding DestinationBrush}">
                                    <TextBlock Text="{Binding Destination}" FontSize="14"
                                               FontWeight="SemiBold" Foreground="White"/>
                                </Border>

                                <TextBlock Text="{Binding Dimensions}" FontSize="14"
                                           Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding Tarif}" FontSize="15"
                                           Foreground="{StaticResource TitleBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="14,0"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Style="{StaticResource FlatButton}" MinWidth="200" Margin="0,0,12,0"
                    AutomationProperties.Name="Précédent" Click="OnBack">← Précédent</Button>
            <Button Style="{StaticResource FlatButton}" MinWidth="200"
                    AutomationProperties.Name="Annuler" Click="OnCancel">Annuler</Button>
        </StackPanel>
    </Grid>
</UserControl>
