<UserControl x:Class="Studio.App.Views.MachineBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#0C1116" BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"
            Padding="10,8">
        <Grid>
            <TextBlock x:Name="MessageText" FontSize="15" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" Margin="6,0"/>

            <ItemsControl x:Name="MachinesList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Tuile agrandie : c'est le seul endroit d'où l'on surveille les
                             machines sans quitter l'écran en cours, et elle se lit de
                             l'autre bout du comptoir. -->
                        <Border Background="{Binding Fond}" CornerRadius="10" Margin="5" Padding="16,12"
                                MinHeight="104">
                            <DockPanel>
                                <!-- lettre de la machine, comme le A / C de DiLand -->
                                <Border DockPanel.Dock="Left" Width="60" Height="60" CornerRadius="8"
                                        BorderBrush="#66FFFFFF" BorderThickness="2" Margin="0,0,14,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Lettre}" FontSize="32" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- jauges d'encre à droite -->
                                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Encres}"
                                              VerticalAlignment="Center" Margin="14,0,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="13" Height="54" Margin="3,0" CornerRadius="2"
                                                    Background="#33000000" VerticalAlignment="Center"
                                                    ToolTip="{Binding Info}">
                                                <Border VerticalAlignment="Bottom" CornerRadius="2"
                                                        Background="{Binding Couleur}" Height="{Binding Hauteur}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- bouton d'arrêt : n'apparaît que si CETTE machine travaille -->
                                <Button DockPanel.Dock="Right" Visibility="{Binding ArretVisible}"
                                        Tag="{Binding Lettre}" Click="OnCancelJob"
                                        Content="{Binding ArretTexte}"
                                        IsEnabled="{Binding ArretPossible}"
                                        Background="#CCB3261E" Foreground="White" BorderThickness="0"
                                        FontSize="14" FontWeight="SemiBold" Padding="14,8"
                                        Cursor="Hand" VerticalAlignment="Center" Margin="14,0,0,0"
                                        ToolTip="Arrêter cette commande ; ce qui est déjà parti au minilab lui sera rappelé">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="fond" Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="fond" Property="Background" Value="#E53935"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="fond" Property="Background" Value="#55000000"/>
                                                    <Setter Property="Foreground" Value="#BBFFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nom}" FontSize="16" FontWeight="Bold"
                                               Foreground="White" TextTrimming="CharacterEllipsis"/>

                                    <!-- L'ÉTAT en toutes lettres, sous le nom : la couleur seule
                                         ne suffit pas, et « en veille » ne se devine pas d'un
                                         fond bleu. -->
                                    <TextBlock Text="{Binding Etat}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Papier}" FontSize="14" Foreground="#DDFFFFFF"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Restant}" FontSize="14" Foreground="#DDFFFFFF"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Avancement de la commande qui sort SUR CETTE MACHINE -->
                                    <Grid Visibility="{Binding TravailVisible}" Margin="0,8,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="{Binding TravailTexte}" FontSize="13"
                                                   Foreground="White" TextTrimming="CharacterEllipsis"/>

                                        <ProgressBar Grid.Row="1" Height="10" Margin="0,4,0,0"
                                                     Minimum="0" Maximum="1"
                                                     Value="{Binding Fraction, Mode=OneWay}"
                                                     IsIndeterminate="{Binding Indetermine, Mode=OneWay}">
                                            <ProgressBar.Template>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Border Background="#44000000" CornerRadius="5"
                                                            ClipToBounds="True">
                                                        <Grid>
                                                            <!-- PART_Track et PART_Indicator sont
                                                                 imposés par ProgressBar : c'est lui
                                                                 qui calcule la largeur, on ne fait
                                                                 que la dessiner. -->
                                                            <Rectangle x:Name="PART_Track"/>
                                                            <Border x:Name="PART_Indicator"
                                                                    HorizontalAlignment="Left"
                                                                    Background="White" CornerRadius="5"/>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </ProgressBar.Template>
                                        </ProgressBar>
                                    </Grid>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
