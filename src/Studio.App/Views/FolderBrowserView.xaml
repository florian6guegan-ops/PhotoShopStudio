<UserControl x:Class="Studio.App.Views.FolderBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Comme FlatButton, mais le contenu prend toute la largeur : une ligne de liste
             se lit alignée à gauche. Le gabarit d'origine centre son contenu — c'est bon
             pour un bouton d'action, illisible pour une liste de dossiers. -->
        <Style x:Key="LigneListe" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="10" BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="Choisir le dossier des photos"/>

        <!-- Chemin cliquable : remonter de trois niveaux est le geste courant, et le
             bouton « dossier parent » ne le fait qu'un cran à la fois. -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="10"
                Padding="10,8" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <Button x:Name="ParentButton" DockPanel.Dock="Left" Style="{StaticResource FlatButton}"
                        MinWidth="0" MinHeight="46" Padding="16,0" FontSize="16" Margin="0,0,12,0"
                        ToolTip="Remonter d'un dossier" Click="OnParent">⬆  Dossier parent</Button>

                <!-- Le tri bascule entre les deux seuls ordres qui servent : le plus
                     récent — ce qu'on vient de recevoir, et donc ce qu'on cherche neuf
                     fois sur dix — et le nom, pour retrouver un dossier qu'on connaît. -->
                <Button x:Name="TriButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                        MinWidth="0" MinHeight="46" Padding="16,0" FontSize="16" Margin="12,0,0,0"
                        ToolTip="Changer l'ordre des dossiers" Click="OnTrier"
                        Content="↓  Plus récents"/>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="BreadcrumbList" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Padding="8,4" FontSize="17"
                                            Foreground="{StaticResource TextBrush}"
                                            Content="{Binding Name}" Tag="{Binding Path}"
                                            Click="OnBreadcrumb"/>
                                    <TextBlock Text="›" FontSize="17" VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Points de départ : disques, clés, CD, puis les dossiers usuels du poste -->
            <Border Grid.Column="0" Background="{StaticResource CardBrush}" CornerRadius="12"
                    Padding="10" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="RACCOURCIS" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}" Margin="6,4,0,10"/>
                        <ItemsControl x:Name="ShortcutsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LigneListe}" MinWidth="0" MinHeight="52"
                                            FontSize="16" Padding="12,0" Margin="0,0,0,8"
                                            Tag="{Binding Path}" Click="OnShortcut">
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Les sous-dossiers, avec ce qu'ils contiennent : c'est l'information qui
                 manquait pour choisir sans ouvrir au hasard. -->
            <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="FoldersScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FoldersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LigneListe}" MinWidth="0" MinHeight="86"
                                            FontSize="18" Padding="10" Margin="0,0,0,8"
                                            Tag="{Binding Path}" Click="OnEnterFolder">
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Left" Width="88" Height="66"
                                                    Background="{StaticResource PanelBrush}"
                                                    CornerRadius="6" Margin="0,0,14,0">
                                                <Grid>
                                                    <TextBlock Text="📁" FontSize="30"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding IconVisibility}"/>
                                                    <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="19"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CountLabel}" FontSize="15"
                                                           Margin="0,4,0,0"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Un dossier sans sous-dossier n'est PAS une erreur : on le dit, et
                         l'opérateur ouvre le dossier courant ou remonte. -->
                    <TextBlock x:Name="NoFoldersText" Grid.Row="0" Style="{StaticResource Hint}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" Margin="24" Visibility="Collapsed"
                               Text="Aucun sous-dossier ici."/>

                    <!-- Un dossier qui disparaît sans un mot inquiète : on dit combien
                         ont été écartés, faute de quoi que ce soit d'imprimable dedans. -->
                    <TextBlock x:Name="HiddenText" Grid.Row="1" FontSize="14"
                               Foreground="{StaticResource MutedBrush}" Margin="6,8,0,2"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource CardBrush}" CornerRadius="12"
                Padding="16" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SummaryText" Grid.Column="0" Style="{StaticResource Hint}"
                           FontSize="18" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="OpenDeepButton" Style="{StaticResource FlatButton}" MinWidth="0"
                            MinHeight="56" Padding="22,0" FontSize="17" Margin="0,0,14,0"
                            IsEnabled="False" Click="OnOpenDeep"
                            ToolTip="Prendre aussi les photos des sous-dossiers">
                        Avec les sous-dossiers
                    </Button>
                    <Button x:Name="OpenButton" Style="{StaticResource BigButton}" MinWidth="0"
                            Padding="26,12" FontSize="22" IsEnabled="False" Click="OnOpen">
                        Ouvrir ce dossier
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
