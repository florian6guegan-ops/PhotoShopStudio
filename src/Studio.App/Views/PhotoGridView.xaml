<UserControl x:Class="Studio.App.Views.PhotoGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Studio.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barre d'outils seule, sur UNE ligne : les opérateurs cherchent « tout » et
             « aucun » à cet endroit, comme chez DiLand.

             <b>Le titre a disparu, et c'est voulu.</b> « Sélectionnez les photos » en 40 px
             redisait ce que l'en-tête de la fenêtre affiche déjà juste au-dessus
             (« 10x15 — choisir les photos ») : soixante-dix pixels de hauteur pour une
             redite, pris sur la seule chose que cet écran doit montrer — les photos. -->
        <!-- Les boutons sont centrés sur l'ÉCRAN, pas sur le groupe « boutons + compteur ».
             Posé dans la même pile, le compteur poussait toute la barre vers la gauche, et
             elle paraissait de travers — d'autant plus que son texte change de longueur.
             La grille le pose donc par-dessus, aligné à droite : il ne déplace plus rien. -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="38" Padding="16,0"
                        FontSize="15" Margin="4,0" Click="OnSmaller"
                        ToolTip="Vignettes plus petites — plus de photos à l'écran">réduire</Button>
                <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="38" Padding="16,0"
                        FontSize="15" Margin="4,0" Click="OnBigger"
                        ToolTip="Vignettes plus grandes">agrandir</Button>
                <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="38" Padding="16,0"
                        FontSize="15" Margin="4,0" Click="OnSelectAll"
                        ToolTip="Tout choisir (Ctrl+A)">tout</Button>
                <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="38" Padding="16,0"
                        FontSize="15" Margin="4,0" Click="OnSelectNone"
                        ToolTip="Ne rien choisir">aucun</Button>
                <!-- Un MENU, et non plus une bascule aveugle entre deux ordres : le bouton
                     porte le classement en cours, et le menu montre les cinq habituels. -->
                <Button x:Name="SortButton" Style="{StaticResource FlatButton}" MinWidth="0"
                        MinHeight="38" Padding="16,0" FontSize="15" Margin="4,0" Click="OnSort"
                        ToolTip="Choisir le classement des photos : date, nom, poids du fichier."
                        Content="⇅  trier"/>
            </StackPanel>

            <TextBlock x:Name="CountText" Style="{StaticResource Hint}" FontSize="16"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
        </Grid>

        <Grid Grid.Row="1">
            <!-- La planche ne fabrique QUE les tuiles visibles (voir PlancheVirtualisee) :
                 un dossier peut en compter 1200, et le WrapPanel les construisait toutes.
                 Le défilement appartient donc au panneau, et le ScrollViewer descend dans
                 le gabarit de la liste — un ScrollViewer posé autour, comme avant, mesurerait
                 la planche entière et annulerait la virtualisation. -->
            <ItemsControl x:Name="PhotosGrid"
                          VirtualizingPanel.IsVirtualizing="True"
                          ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True" Focusable="False"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- « réduire » et « agrandir » agissent sur toute la planche d'un
                             coup : l'échelle est posée sur la liste par le code, et elle
                             descend jusqu'ici (propriété héritée). -->
                        <controls:PlancheVirtualisee/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Vignette de DiLand : la photo au centre sur un fond qui vire à
                             l'orange dès qu'elle est retenue, le nom en bas à gauche, la
                             définition et le rapport en haut à droite, et le compteur qui
                             n'apparaît que sur les photos de la commande. -->
                        <Border Width="210" Height="230"
                                Margin="3" Background="{Binding TileBrush}"
                                MouseLeftButtonUp="OnPhotoClicked" Tag="{Binding}">
                            <Grid>
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Top" Visibility="{Binding BadgeVisibility}">
                                    <Border Background="#CC000000" Padding="5,2">
                                        <TextBlock Text="{Binding SizeLabel}" FontSize="11" Foreground="White"/>
                                    </Border>
                                    <Border Background="#CC7E57C2" Padding="5,2">
                                        <TextBlock Text="{Binding RatioLabel}" FontSize="11" Foreground="White"/>
                                    </Border>
                                </StackPanel>

                                <!-- Le FORMAT du tirage, en haut à gauche. Depuis qu'une
                                     commande mélange les formats, c'est la seule chose qui
                                     distingue à l'œil une 10×15 d'une 15×20 dans la
                                     planche. Absent tant qu'aucun format n'est posé. -->
                                <Border Background="#CC00897B" Padding="6,2" CornerRadius="4"
                                        Margin="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Visibility="{Binding FormatVisibility}">
                                    <TextBlock Text="{Binding FormatLabel}" FontSize="12"
                                               FontWeight="Bold" Foreground="White"/>
                                </Border>

                                <Border Background="#CC000000" Padding="5,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="White"
                                               TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                </Border>

                                <!-- Compteur : − rouge, quantité, + vert, comme chez DiLand -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom" Visibility="{Binding CartVisibility}">
                                    <Button Width="34" Height="34" Padding="0" FontSize="20" FontWeight="Bold"
                                            Background="{DynamicResource DangerBrush}" Foreground="White"
                                            BorderThickness="0" Click="OnTileMinus" Tag="{Binding}">−</Button>
                                    <Border Background="#CC000000" MinWidth="30">
                                        <TextBlock Text="{Binding QuantityLabel}" FontSize="17" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Width="34" Height="34" Padding="0" FontSize="20" FontWeight="Bold"
                                            Background="{DynamicResource OkBrush}" Foreground="White"
                                            BorderThickness="0" Click="OnTilePlus" Tag="{Binding}">+</Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Dossier sans photos : on le DIT, et on propose d'en choisir un autre.
                 La planche restait vide et muette, l'opérateur devant le client. -->
            <StackPanel x:Name="EmptyPanel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🗀" FontSize="64" HorizontalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" FontSize="22"
                           Margin="0,16,0,0" MaxWidth="620" TextAlignment="Center"/>
                <Button Style="{StaticResource BigButton}" MinWidth="0" Padding="26,12"
                        FontSize="20" Margin="0,24,0,0" HorizontalAlignment="Center"
                        Click="OnChangeFolder">Choisir un autre dossier</Button>
            </StackPanel>

            <!-- Trop de photos pour une seule planche : on le dit au lieu de tomber. -->
            <Border x:Name="TruncatedBanner" Visibility="Collapsed"
                    Background="{DynamicResource TitleBrush}" CornerRadius="8" Padding="14,10"
                    VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0">
                <TextBlock x:Name="TruncatedText" Foreground="#12181E" FontSize="15"
                           FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="760"/>
            </Border>
        </Grid>

        <!-- Barre d'action.
             Grille et non DockPanel : dans un DockPanel le groupe de gauche se sert en
             premier, et « Imprimer » finissait hors écran sur une fenêtre étroite. C'est
             ce défaut qui empêchait de conclure une commande le 01/08/2026.

             <b>Tout y est plus compact qu'avant.</b> Ces réglages tenaient sur TROIS lignes
             de 52 px, et la barre entière mangeait trois cents pixels — plus que la planche
             elle-même, qui n'en gardait qu'une rangée et demie. Rien n'a été retiré : les
             hauteurs et les corps de texte ont été ramenés à ce qu'un écran de comptoir
             demande, et l'ensemble tient maintenant sur deux lignes. -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" CornerRadius="12"
                Padding="12,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="ProductLabelText" Text="Produit :" Style="{StaticResource Hint}"
                               FontSize="15" VerticalAlignment="Center" Margin="0,0,6,4"/>
                    <ComboBox x:Name="ProductCombo" MinWidth="230" FontSize="15" Padding="8,5"
                              DisplayMemberPath="Label" VerticalAlignment="Center" Margin="0,0,8,4"
                              SelectionChanged="OnDefaultProductChanged"/>
                    <!-- Changer la liste ne touche PLUS aux photos déjà cochées : une
                         commande de borne arrive avec un format par photo — 10x15 pour
                         celles-ci, 13x18 pour celles-là — et le seul fait de dérouler la
                         liste les ramenait toutes au même. Le report est donc un geste
                         explicite, et il se voit. -->
                    <Button x:Name="AppliquerProduitButton" Style="{StaticResource FlatButton}"
                            MinHeight="40" Padding="12,0" FontSize="14" Margin="0,0,16,4"
                            Click="OnAppliquerLeProduit" IsEnabled="False"
                            ToolTip="Donne ce format à toutes les photos cochées. Sans ce bouton, elles gardent le leur.">
                        Appliquer aux cochées
                    </Button>
                    <!-- Format personnalisé : la taille remplace le choix de produit, le
                         papier n'étant décidé qu'à la validation, d'après la quantité. -->
                    <TextBlock x:Name="TaillePersoText" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleBrush}" Visibility="Collapsed"
                               VerticalAlignment="Center" Margin="0,0,16,4"/>
                    <TextBlock Text="Quantité :" Style="{StaticResource Hint}"
                               FontSize="15" VerticalAlignment="Center" Margin="0,0,6,4"/>
                    <Button Style="{StaticResource FlatButton}" MinWidth="40" MinHeight="40" Padding="0"
                            FontSize="20" Click="OnQuantityMinus" Margin="0,0,0,4">−</Button>
                    <TextBlock x:Name="QuantityText" Text="1" Style="{StaticResource Valeur}"
                               FontSize="19" MinWidth="38" Margin="0,0,0,4"/>
                    <Button Style="{StaticResource FlatButton}" MinWidth="40" MinHeight="40" Padding="0"
                            FontSize="20" Click="OnQuantityPlus" Margin="0,0,16,4">+</Button>
                    <!-- SUR QUELLE MACHINE ça va sortir, en toutes lettres et en couleur.
                         Le catalogue porte deux produits nommés « 10x15 » — l'un au
                         minilab, l'autre à la DS620 — et rien ici ne disait lequel était
                         choisi : la commande 04-024 du 04/08/2026 est partie sur la
                         mauvaise machine, onze tirages, sans que personne ne puisse s'en
                         apercevoir avant le papier. -->
                    <Border x:Name="SortieBadge" CornerRadius="6" Padding="9,4" Margin="0,0,16,4"
                            VerticalAlignment="Center" Background="{DynamicResource AccentDarkBrush}">
                        <TextBlock x:Name="SortieText" FontSize="13" FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Border>

                    <!-- Le choix de machine ne vaut QUE pour le minilab : sur un produit
                         DNP, la liste ne commandait rien et laissait croire le contraire. -->
                    <TextBlock x:Name="MachineLabel" Text="Minilab :" Style="{StaticResource Hint}"
                               FontSize="15" VerticalAlignment="Center" Margin="0,0,6,4"/>
                    <ComboBox x:Name="MachineCombo" MinWidth="210" FontSize="14" Padding="8,5"
                              DisplayMemberPath="Label" VerticalAlignment="Center" Margin="0,0,0,4"
                              ToolTip="Machine du minilab et papier qui y est chargé. « Automatique » envoie sur celle dont le rouleau porte le format."
                              SelectionChanged="OnMachineChanged"/>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="IndexButton" Style="{StaticResource FlatButton}" MinHeight="44"
                            MinWidth="0" Padding="14,0" FontSize="15" Margin="0,0,8,0" IsEnabled="False"
                            ToolTip="Une planche avec les vignettes NUMÉROTÉES — de la sélection ou de tout le dossier, au choix. Le client coche, on tire ensuite."
                            Click="OnIndexSheet">Planche index</Button>
                    <Button x:Name="ModifyButton" Style="{StaticResource FlatButton}" MinHeight="44"
                            MinWidth="0" Padding="18,0" FontSize="15" Margin="0,0,8,0" IsEnabled="False"
                            ToolTip="Recadrer et corriger la sélection, sans la perdre de vue"
                            Click="OnModify">Modifier</Button>
                    <!-- Envoyer plutôt que tirer : le client repart avec un lien. Toujours
                         actif, parce qu'il sert aussi à envoyer le DOSSIER ENTIER, sans
                         qu'aucune photo ait à être cochée. -->
                    <Button x:Name="DropboxButton" Style="{StaticResource FlatButton}" MinHeight="44"
                            MinWidth="0" Padding="14,0" FontSize="15" Margin="0,0,8,0"
                            ToolTip="Envoyer les photos au client par Dropbox : la sélection ou le dossier entier, au choix. Il reçoit un lien de téléchargement, sans avoir de compte à créer."
                            Click="OnDropbox">☁  Envoyer au client</Button>
                    <!-- Le geste du comptoir : un client s'absente, un autre attend. La
                         commande part sur l'accueil, sous « En attente ». -->
                    <Button x:Name="AttenteButton" Style="{StaticResource FlatButton}" MinHeight="44"
                            MinWidth="0" Padding="14,0" FontSize="15" Margin="0,0,8,0"
                            ToolTip="Mettre cette commande de côté pour servir quelqu'un d'autre. Elle vous attend sur l'accueil et se rouvre telle que vous la laissez."
                            Click="OnMettreEnAttente">⏸  En attente</Button>
                    <!-- Prévenir le client SANS avoir à y penser plus tard : l'adresse se
                         prend maintenant, pendant qu'il est là, et le message part tout
                         seul quand la machine a fini de sortir la commande. -->
                    <Button x:Name="PrevenirButton" Style="{StaticResource FlatButton}" MinHeight="44"
                            MinWidth="0" Padding="14,0" FontSize="15" Margin="0,0,14,0"
                            ToolTip="Saisir l'adresse du client : dès que la commande sera sortie, un courriel lui dira qu'elle l'attend en magasin."
                            Click="OnPrevenirALaFin">🔔  Prévenir à la fin</Button>
                    <TextBlock x:Name="TotalText" Style="{StaticResource Valeur}" FontSize="20"
                               Margin="0,0,12,0"/>
                    <!-- « Imprimer » reste le plus gros bouton de l'écran — c'est le geste
                         qui engage du papier — mais 76 px de haut imposaient leur hauteur à
                         toute la barre. -->
                    <Button x:Name="PrintButton" Style="{StaticResource BigButton}"
                            MinHeight="52" MinWidth="170" FontSize="20" Padding="18,8"
                            Click="OnPrint" IsEnabled="False">
                        🖨  Imprimer
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
