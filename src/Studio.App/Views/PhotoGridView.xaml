<UserControl x:Class="Studio.App.Views.PhotoGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre centré et barre d'outils, comme l'écran « Sélectionnez les photos »
             de DiLand : les opérateurs cherchent « tout » et « aucun » à cet endroit. -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Sélectionnez les photos" FontSize="40"
                       Foreground="{StaticResource TitleBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="44" Padding="18,0"
                        FontSize="16" Margin="6,0" Click="OnSmaller"
                        ToolTip="Vignettes plus petites">réduire</Button>
                <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="44" Padding="18,0"
                        FontSize="16" Margin="6,0" Click="OnBigger"
                        ToolTip="Vignettes plus grandes">agrandir</Button>
                <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="44" Padding="18,0"
                        FontSize="16" Margin="6,0" Click="OnSelectAll"
                        ToolTip="Tout choisir (Ctrl+A)">tout</Button>
                <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="44" Padding="18,0"
                        FontSize="16" Margin="6,0" Click="OnSelectNone"
                        ToolTip="Ne rien choisir">aucun</Button>
                <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="44" Padding="18,0"
                        FontSize="16" Margin="6,0" Click="OnSort"
                        ToolTip="Trier par nom ou par date">trier</Button>
                <TextBlock x:Name="CountText" Style="{StaticResource Hint}" FontSize="17"
                           VerticalAlignment="Center" Margin="24,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PhotosGrid">
                <!-- « réduire » et « agrandir » agissent sur toute la planche d'un coup :
                     une mise à l'échelle vaut mieux que de recalculer chaque vignette. -->
                <ItemsControl.LayoutTransform>
                    <ScaleTransform x:Name="GridZoom" ScaleX="1" ScaleY="1"/>
                </ItemsControl.LayoutTransform>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Vignette de DiLand : la photo au centre sur un fond qui vire à
                             l'orange dès qu'elle est retenue, le nom en bas à gauche, la
                             définition et le rapport en haut à droite, et le compteur qui
                             n'apparaît que sur les photos de la commande. -->
                        <Border Width="210" Height="230"
                                Margin="3" Background="{Binding TileBrush}"
                                MouseLeftButtonUp="OnPhotoClicked" Tag="{Binding}">
                            <Grid>
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Top" Visibility="{Binding BadgeVisibility}">
                                    <Border Background="#CC000000" Padding="5,2">
                                        <TextBlock Text="{Binding SizeLabel}" FontSize="11" Foreground="White"/>
                                    </Border>
                                    <Border Background="#CC7E57C2" Padding="5,2">
                                        <TextBlock Text="{Binding RatioLabel}" FontSize="11" Foreground="White"/>
                                    </Border>
                                </StackPanel>

                                <Border Background="#CC000000" Padding="5,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="White"
                                               TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                </Border>

                                <!-- Compteur : − rouge, quantité, + vert, comme chez DiLand -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom" Visibility="{Binding CartVisibility}">
                                    <Button Width="34" Height="34" Padding="0" FontSize="20" FontWeight="Bold"
                                            Background="{StaticResource DangerBrush}" Foreground="White"
                                            BorderThickness="0" Click="OnTileMinus" Tag="{Binding}">−</Button>
                                    <Border Background="#CC000000" MinWidth="30">
                                        <TextBlock Text="{Binding QuantityLabel}" FontSize="17" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Width="34" Height="34" Padding="0" FontSize="20" FontWeight="Bold"
                                            Background="{StaticResource OkBrush}" Foreground="White"
                                            BorderThickness="0" Click="OnTilePlus" Tag="{Binding}">+</Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

            <!-- Dossier sans photos : on le DIT, et on propose d'en choisir un autre.
                 La planche restait vide et muette, l'opérateur devant le client. -->
            <StackPanel x:Name="EmptyPanel" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🗀" FontSize="64" HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" FontSize="22"
                           Margin="0,16,0,0" MaxWidth="620" TextAlignment="Center"/>
                <Button Style="{StaticResource BigButton}" MinWidth="0" Padding="26,12"
                        FontSize="20" Margin="0,24,0,0" HorizontalAlignment="Center"
                        Click="OnChangeFolder">Choisir un autre dossier</Button>
            </StackPanel>

            <!-- Trop de photos pour une seule planche : on le dit au lieu de tomber. -->
            <Border x:Name="TruncatedBanner" Visibility="Collapsed"
                    Background="{StaticResource TitleBrush}" CornerRadius="8" Padding="14,10"
                    VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0">
                <TextBlock x:Name="TruncatedText" Foreground="#12181E" FontSize="15"
                           FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="760"/>
            </Border>
        </Grid>

        <!-- Barre d'action.
             Grille et non DockPanel : dans un DockPanel le groupe de gauche se sert en
             premier, et « Imprimer » finissait hors écran sur une fenêtre étroite. C'est
             ce défaut qui empêchait de conclure une commande le 01/08/2026. -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="ProductLabelText" Text="Produit :" Style="{StaticResource Hint}"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <ComboBox x:Name="ProductCombo" MinWidth="280" FontSize="20" Padding="10,8"
                              DisplayMemberPath="Label" VerticalAlignment="Center" Margin="0,0,20,6"
                              SelectionChanged="OnDefaultProductChanged"/>
                    <!-- Format personnalisé : la taille remplace le choix de produit, le
                         papier n'étant décidé qu'à la validation, d'après la quantité. -->
                    <TextBlock x:Name="TaillePersoText" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}" Visibility="Collapsed"
                               VerticalAlignment="Center" Margin="0,0,20,6"/>
                    <TextBlock Text="Quantité :" Style="{StaticResource Hint}"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <Button Style="{StaticResource FlatButton}" MinWidth="52" MinHeight="52" Padding="0"
                            FontSize="24" Click="OnQuantityMinus" Margin="0,0,0,6">−</Button>
                    <TextBlock x:Name="QuantityText" Text="1" Style="{StaticResource Valeur}"
                               MinWidth="44" Margin="0,0,0,6"/>
                    <Button Style="{StaticResource FlatButton}" MinWidth="52" MinHeight="52" Padding="0"
                            FontSize="24" Click="OnQuantityPlus" Margin="0,0,20,6">+</Button>
                    <TextBlock Text="Minilab :" Style="{StaticResource Hint}"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <ComboBox x:Name="MachineCombo" MinWidth="260" FontSize="15" Padding="10,8"
                              DisplayMemberPath="Label" VerticalAlignment="Center" Margin="0,0,0,6"
                              ToolTip="Machine du minilab et papier qui y est chargé"
                              SelectionChanged="OnMachineChanged"/>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="IndexButton" Style="{StaticResource FlatButton}" MinHeight="56"
                            Padding="20,0" FontSize="18" Margin="0,0,12,0" IsEnabled="False"
                            ToolTip="Une planche avec les vignettes NUMÉROTÉES de la sélection, au format choisi — le client coche, on tire ensuite"
                            Click="OnIndexSheet">Planche index</Button>
                    <Button x:Name="ModifyButton" Style="{StaticResource FlatButton}" MinHeight="56"
                            Padding="26,0" FontSize="18" Margin="0,0,12,0" IsEnabled="False"
                            ToolTip="Recadrer et corriger la sélection, sans la perdre de vue"
                            Click="OnModify">Modifier</Button>
                    <!-- Le geste du comptoir : un client s'absente, un autre attend. La
                         commande part sur l'accueil, sous « En attente ». -->
                    <Button x:Name="AttenteButton" Style="{StaticResource FlatButton}" MinHeight="56"
                            Padding="20,0" FontSize="18" Margin="0,0,20,0"
                            ToolTip="Mettre cette commande de côté pour servir quelqu'un d'autre. Elle vous attend sur l'accueil et se rouvre telle que vous la laissez."
                            Click="OnMettreEnAttente">⏸  Mettre en attente</Button>
                    <TextBlock x:Name="TotalText" Style="{StaticResource Valeur}" Margin="0,0,16,0"/>
                    <Button x:Name="PrintButton" Style="{StaticResource BigButton}"
                            Click="OnPrint" IsEnabled="False">
                        🖨  Imprimer
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
