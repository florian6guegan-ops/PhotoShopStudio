<UserControl x:Class="Studio.App.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <!-- Le même onglet que « Commandes des bornes » : l'actif est plein, les autres
             restent sombres. Deux écrans qui listent des commandes doivent se feuilleter
             du même geste. -->
        <Style x:Key="Onglet" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="fond" Background="{StaticResource PanelBrush}"
                                CornerRadius="10,10,0,0" Padding="28,12" Margin="0,0,4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="fond" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="Commandes récentes"/>

        <!-- Tirages et planches d'identité ne se servent ni au même client, ni au même
             délai, ni avec la même machine. Mêlés dans une seule liste, on cherchait la
             planche à rattraper au milieu des paquets de 10×15. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,14">
            <RadioButton x:Name="OngletTout" Style="{StaticResource Onglet}" Content="Tout"
                         IsChecked="True" Checked="OnTabChanged"/>
            <RadioButton x:Name="OngletTirages" Style="{StaticResource Onglet}"
                         Checked="OnTabChanged"
                         ToolTip="Tous les tirages photo, quelle qu'en soit l'origine : minilab, DNP, agrandissements."/>
            <!-- Les tirages faits AU COMPTOIR et ceux qui viennent d'une borne ne se
                 traitent pas pareil : les premiers attendent un client devant soi, les
                 seconds attendent qu'on aille les chercher. Mêlés, on cherchait la
                 commande de borne à sortir au milieu des paquets du comptoir. -->
            <RadioButton x:Name="OngletTiragesOperateur" Style="{StaticResource Onglet}"
                         Checked="OnTabChanged"
                         ToolTip="Les tirages préparés au comptoir par l'opérateur."/>
            <RadioButton x:Name="OngletTiragesBorne" Style="{StaticResource Onglet}"
                         Checked="OnTabChanged"
                         ToolTip="Les tirages venus d'une borne : commandes du client, reprises ou non."/>
            <RadioButton x:Name="OngletIdentite" Style="{StaticResource Onglet}"
                         Checked="OnTabChanged"
                         ToolTip="Les planches de photos d'identité."/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}"
                           Text="Aucune commande ces derniers jours." Visibility="Collapsed"/>
                <ItemsControl x:Name="OrdersList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                    Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel>
                                        <!-- L'origine en pastille : c'est ce qu'on cherche
                                             des yeux dans la liste « Tout », et une
                                             couleur se repère plus vite qu'un mot au
                                             milieu d'une ligne. -->
                                        <Border DockPanel.Dock="Left" CornerRadius="8" Padding="12,4"
                                                Margin="0,0,12,0" VerticalAlignment="Center"
                                                Background="{Binding OrigineBrush}">
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White"
                                                       Text="{Binding OrigineTexte}"/>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Left" FontSize="24" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}" Text="{Binding Header}"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <!-- Les photos d'une commande restent dans son dossier :
                                                 on peut donc les ressortir et les retravailler, qu'il
                                                 s'agisse de tirages ou d'une planche d'identité. -->
                                            <Button Style="{StaticResource FlatButton}" MinHeight="44" MinWidth="150"
                                                    FontSize="17" Padding="12,4" Margin="0,0,10,0"
                                                    ToolTip="Recopie les photos de la commande dans les téléchargements, même si elles l'ont déjà été."
                                                    Click="OnDownload" Tag="{Binding}">⬇ Télécharger</Button>
                                            <Button Style="{StaticResource FlatButton}" MinHeight="44" MinWidth="130"
                                                    FontSize="17" Padding="12,4" Margin="0,0,10,0"
                                                    ToolTip="Rouvre les photos pour les recadrer et les corriger — dans l'écran d'identité s'il s'agit d'une planche, dans celui des tirages sinon. La commande d'origine n'est pas touchée : un nouveau tirage donnera une nouvelle commande."
                                                    Click="OnModify" Tag="{Binding}">✏ Modifier</Button>
                                            <!-- L'envoi par courriel, le MÊME module que
                                                 l'écran identité : le client rappelle le
                                                 lendemain pour demander ses fichiers, et
                                                 il fallait jusqu'ici refaire la planche
                                                 pour les lui envoyer. -->
                                            <Button Style="{StaticResource FlatButton}" MinHeight="44" MinWidth="150"
                                                    FontSize="17" Padding="12,4" Margin="0,0,10,0"
                                                    Visibility="{Binding MailVisibility}"
                                                    ToolTip="Envoyer les photos d'identité de cette commande par courriel, avec leur cadrage. Prestation facturée."
                                                    Click="OnSendByMail" Tag="{Binding}">✉ Envoyer</Button>
                                            <!-- Prévenir le client que sa commande l'attend.
                                                 Aucune pièce jointe : ce message annonce,
                                                 il ne livre pas — l'envoi des fichiers est
                                                 une prestation à part, facturée. -->
                                            <Button Style="{StaticResource FlatButton}" MinHeight="44" MinWidth="160"
                                                    FontSize="17" Padding="12,4" Margin="0,0,10,0"
                                                    ToolTip="Envoie au client un courriel lui disant que sa commande est prête à être retirée en magasin. Sans les photos."
                                                    Click="OnPrevenirClient" Tag="{Binding}">🔔 Prévenir</Button>
                                            <Button Style="{StaticResource FlatButton}" MinHeight="44" MinWidth="120"
                                                    FontSize="17" Padding="12,4" Margin="0,0,16,0"
                                                    ToolTip="Imprimer le ticket de caisse"
                                                    Click="OnPrintTicket" Tag="{Binding}">🧾 Ticket</Button>
                                            <TextBlock FontSize="22" VerticalAlignment="Center"
                                                       Foreground="{Binding StatusBrush}" FontWeight="SemiBold"
                                                       Text="{Binding StatusText}"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Les premières photos de la commande. Un numéro et
                                         une heure ne disent rien d'une planche d'identité :
                                         quand un client revient chercher la sienne, il
                                         fallait ouvrir les commandes une à une pour la
                                         retrouver. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <ItemsControl ItemsSource="{Binding Apercus}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="76" Height="76" Margin="0,0,6,0"
                                                            CornerRadius="6" ClipToBounds="True"
                                                            Background="{StaticResource PanelBrush}">
                                                        <Image Source="{Binding}" Stretch="UniformToFill"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- « +12 » : on ne montre que les premières, et
                                             l'opérateur doit savoir qu'il en manque. -->
                                        <Border CornerRadius="6" Padding="10,0" Height="76"
                                                Background="{StaticResource PanelBrush}"
                                                Visibility="{Binding ResteVisibility}">
                                            <TextBlock Text="{Binding ResteTexte}" FontSize="17"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding Envelopes}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                                                            MinHeight="48" MinWidth="180" FontSize="18" Padding="16,6"
                                                            Click="OnReprint" Tag="{Binding}"
                                                            Visibility="{Binding ReprintVisibility}">
                                                        🖨  Réimprimer
                                                    </Button>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                                                            MinHeight="48" MinWidth="220" FontSize="18" Padding="16,6"
                                                            Margin="0,0,10,0"
                                                            Click="OnPrintLargeFormat" Tag="{Binding}"
                                                            Visibility="{Binding LargeFormatVisibility}"
                                                            ToolTip="Ouvre la boîte d'impression grand format pour tirer sur l'Epson.">
                                                        🖼  Tirer sur l'Epson…
                                                    </Button>
                                                    <TextBlock FontSize="19" VerticalAlignment="Center"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
