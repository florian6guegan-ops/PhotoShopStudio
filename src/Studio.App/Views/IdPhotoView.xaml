<UserControl x:Class="Studio.App.Views.IdPhotoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <!-- ===== Les modules de la barre du bas =====

             Ils étaient posés à la file dans un WrapPanel : papier, finition, deux
             compteurs, trois boutons de redressement, deux cases, un bouton et une
             phrase — quinze contrôles alignés sans rien qui dise lequel va avec lequel.
             On cherchait « Photos » et « Planches », qui se ressemblent et ne veulent pas
             dire la même chose.

             Chacun devient un MODULE encadré et titré. Trois avantages, dans l'ordre :
             on lit le titre au lieu de deviner ; les réglages d'une même famille se
             touchent ; et un module se replie ENTIER quand la fenêtre rétrécit, là où le
             WrapPanel coupait un compteur en deux lignes. -->

        <Style x:Key="Module" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
        </Style>

        <Style x:Key="TitreModule" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="2,0,0,4"/>
        </Style>

        <!-- Les boutons ronds des compteurs et du redressement : une seule définition
             plutôt que la même paire de dimensions recopiée neuf fois.
             40 px et non 48 : sur cet écran, la hauteur de la barre est prise à la PHOTO,
             et c'est la photo qu'on est venu regarder. -->
        <Style x:Key="BoutonModule" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête compact : chaque pixel pris ici est un pixel de moins pour la photo, et
             c'est la photo qu'on regarde. Le titre perd sa marge basse de 18 px, l'aide
             passe en 15. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="TitleText" DockPanel.Dock="Left" Style="{StaticResource PageTitle}"
                       Margin="0" FontSize="26" Text="Photo d'identité"/>
            <Button x:Name="AgrandirButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                    MinWidth="150" MinHeight="40" FontSize="15" Padding="14,0" Margin="12,0,0,0"
                    Click="OnBasculerAgrandissement"
                    ToolTip="Cache la bande et les réglages pour ne garder que la photo. Échap ou un second appui pour revenir.">⛶  Agrandir</Button>
            <TextBlock x:Name="AideText" DockPanel.Dock="Right" Style="{StaticResource Hint}"
                       FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="520"
                       Text="Placez l'anneau jaune au sommet du crâne et le bleu sous le menton : le cadrage suit"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 160 et non 240 : la bande ne sert qu'à reconnaître la photo, et les
                     90 px repris vont à la scène de cadrage. -->
                <ColumnDefinition x:Name="BandeColonne" Width="160"/>
                <ColumnDefinition Width="*"/>
                <!-- Le panneau des corrections, replié. Il s'ouvre SUR PLACE : voir plus bas. -->
                <ColumnDefinition x:Name="CorrectionsColonne" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Bande de choix de la photo -->
            <Border x:Name="BandePhotos" Grid.Column="0" Background="{StaticResource CardBrush}"
                    CornerRadius="12" Padding="6" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PhotoStrip">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="3" CornerRadius="8" BorderThickness="3"
                                        BorderBrush="{Binding BorderBrush}" Background="#F0F2F4"
                                        MouseLeftButtonUp="OnStripPhotoClicked" Tag="{Binding}"
                                        Cursor="Hand">
                                    <Grid Height="120">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4"/>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="4,0,4,2"/>
                                        <!-- Le rang et le nombre de planches, sur la vignette :
                                             c'est ce que DiLand écrit sur les siennes, et sans
                                             quoi une quantité posée sur une photo ne se voit
                                             qu'en revenant dessus. -->
                                        <Border Background="{StaticResource AccentBrush}" CornerRadius="9"
                                                Padding="8,3" Margin="4"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Etiquette}" Foreground="White"
                                                       FontSize="13" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Scène de cadrage -->
            <Border Grid.Column="1" Background="#263238" CornerRadius="12" ClipToBounds="True">
                <Grid x:Name="Stage" Background="Transparent"
                      MouseLeftButtonDown="OnStageMouseDown" MouseLeftButtonUp="OnStageMouseUp"
                      MouseMove="OnStageMouseMove" MouseWheel="OnStageWheel"
                      IsManipulationEnabled="True"
                      ManipulationStarting="OnManipulationStarting"
                      ManipulationDelta="OnManipulationDelta"
                      SizeChanged="OnStageSizeChanged">
                    <Image x:Name="Photo" Stretch="Uniform"/>
                    <Canvas x:Name="Overlay" IsHitTestVisible="False">
                        <Path x:Name="Shade" Fill="#A6000000"/>
                        <Rectangle x:Name="CropBorder" StrokeThickness="4"/>
                        <Line x:Name="CrownLine" StrokeThickness="1.5" StrokeDashArray="4 3"/>
                        <Line x:Name="ChinMinLine" StrokeThickness="1.5" StrokeDashArray="4 3"/>
                        <Line x:Name="ChinMaxLine" StrokeThickness="1.5" StrokeDashArray="4 3"/>
                        <!-- Gabarit du visage : le tour de tête doit tomber entre les deux
                             ovales. C'est le repère de DiLand, que les opérateurs lisent
                             d'un coup d'œil sans rien mesurer. -->
                        <Ellipse x:Name="HeadMinOval" Stroke="#E9527A" StrokeThickness="2"/>
                        <Ellipse x:Name="HeadMaxOval" Stroke="#E9527A" StrokeThickness="2"/>
                        <Line x:Name="FaceAxis" Stroke="#E9527A" StrokeThickness="1.5" StrokeDashArray="5 4"/>
                    </Canvas>
                    <!-- Anneaux de placement : sommet du crâne et bas du menton.
                         Sans fond, seul le trait est cliquable, la photo reste visible dessous.
                         Curseur haut-bas : ils ne mesurent qu'une hauteur et restent sur
                         l'axe du visage (voir _axeVisage dans le code-behind). -->
                    <Canvas x:Name="Markers">
                        <Ellipse x:Name="CrownMarker" Width="52" Height="52" StrokeThickness="4"
                                 Stroke="#FFD24A" Fill="#22FFD24A" Cursor="SizeNS"
                                 Visibility="Collapsed"
                                 MouseLeftButtonDown="OnMarkerDown" Tag="Crown"/>
                        <TextBlock x:Name="CrownLabel" Text="crâne" FontSize="14" FontWeight="Bold"
                                   Foreground="#FFD24A" Visibility="Collapsed"/>
                        <Ellipse x:Name="ChinMarker" Width="52" Height="52" StrokeThickness="4"
                                 Stroke="#4ADEFF" Fill="#224ADEFF" Cursor="SizeNS"
                                 Visibility="Collapsed"
                                 MouseLeftButtonDown="OnMarkerDown" Tag="Chin"/>
                        <TextBlock x:Name="ChinLabel" Text="menton" FontSize="14" FontWeight="Bold"
                                   Foreground="#4ADEFF" Visibility="Collapsed"/>
                        <Line x:Name="MarkerAxis" StrokeThickness="2" StrokeDashArray="5 4"
                              Stroke="#88FFFFFF" Visibility="Collapsed"/>
                    </Canvas>

                    <TextBlock x:Name="EmptyText" Foreground="White" FontSize="24" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="Choisissez une photo à gauche"/>

                    <!-- Bandeau du mode redressement : un ÉTAT, pas un rappel. Tant qu'il
                         est là, la molette ne zoome plus — sans lui, l'opérateur croit
                         l'outil cassé. -->
                    <Border x:Name="BandeauRedressement" Visibility="Collapsed"
                            Background="#F0932B" CornerRadius="8" Padding="16,8"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="BandeauRedressementTexte" Foreground="#12181E"
                                   FontSize="17" FontWeight="SemiBold"
                                   Text="Redressement 0° — molette pour régler · T ou Échap pour sortir"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== Corrections, SUR PLACE =====

                 « Corriger » ouvrait un ÉCRAN : la photo disparaissait, un aperçu se
                 recalculait, on réglait à l'aveugle de ce qu'on venait de cadrer, puis on
                 revenait. Deux chargements pour bouger un curseur, et le cadrage — la seule
                 chose que cet écran sert à faire — hors de vue pendant tout ce temps.

                 Ici le panneau se déplie à droite et la photo reste où elle est, corrigée en
                 direct. C'est la barre d'outils de DiLand (recadrer · correction · yeux
                 rouges), qui ne quitte jamais l'image.

                 L'aperçu part de la vignette DÉJÀ EN MÉMOIRE : rien à charger, ni à
                 l'ouverture ni à la fermeture. -->
            <Border x:Name="CorrectionsPanel" Grid.Column="2" Visibility="Collapsed"
                    Background="{StaticResource CardBrush}" CornerRadius="12"
                    Padding="14" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Left" Text="Corriger" FontSize="18"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{StaticResource TitleBrush}"/>
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="32"
                                    Padding="12,0" FontSize="14" Click="OnFermerLesCorrections"
                                    ToolTip="Refermer le panneau (Échap)">✕</Button>
                        </DockPanel>

                        <TextBlock Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   Text="La photo se corrige sous vos yeux. Le tirage reprendra exactement ces réglages."/>

                        <ToggleButton x:Name="IdRedEyeToggle" Style="{StaticResource ToggleTile}"
                                      Margin="0,0,0,12" Click="OnIdCorrectionChanged"
                                      Content="Enlever les yeux rouges"
                                      ToolTip="Neutralise le rouge du flash au fond de l'œil. Ne touche qu'aux pupilles."/>

                        <TextBlock Text="Automatiques" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TitleBrush}" Margin="0,0,0,8"/>
                        <ToggleButton x:Name="IdAutoLevelsToggle" Style="{StaticResource ToggleTile}"
                                      Margin="0,0,0,5" Click="OnIdCorrectionChanged" Content="Niveaux"/>
                        <ToggleButton x:Name="IdAutoContrastToggle" Style="{StaticResource ToggleTile}"
                                      Margin="0,0,0,5" Click="OnIdCorrectionChanged" Content="Contraste"/>
                        <ToggleButton x:Name="IdAutoColorToggle" Style="{StaticResource ToggleTile}"
                                      Margin="0,0,0,12" Click="OnIdCorrectionChanged" Content="Couleur"/>

                        <TextBlock Text="Réglages" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TitleBrush}" Margin="0,0,0,8"/>

                        <TextBlock x:Name="IdExposureLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdExposureSlider" Minimum="-2" Maximum="2" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" Margin="0,0,0,8"
                                ValueChanged="OnIdCorrectionChanged"/>

                        <TextBlock x:Name="IdContrastLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdContrastSlider" Minimum="-100" Maximum="100" Margin="0,0,0,8"
                                ValueChanged="OnIdCorrectionChanged"/>

                        <TextBlock x:Name="IdHighlightsLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdHighlightsSlider" Minimum="-100" Maximum="100" Margin="0,0,0,8"
                                ValueChanged="OnIdCorrectionChanged"/>

                        <TextBlock x:Name="IdShadowsLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdShadowsSlider" Minimum="-100" Maximum="100" Margin="0,0,0,8"
                                ValueChanged="OnIdCorrectionChanged"/>

                        <TextBlock x:Name="IdTemperatureLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdTemperatureSlider" Minimum="-100" Maximum="100" Margin="0,0,0,8"
                                ValueChanged="OnIdCorrectionChanged"/>

                        <TextBlock x:Name="IdSaturationLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdSaturationSlider" Minimum="-100" Maximum="100" Margin="0,0,0,8"
                                ValueChanged="OnIdCorrectionChanged"/>

                        <TextBlock x:Name="IdSharpnessLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdSharpnessSlider" Minimum="0" Maximum="100" Margin="0,0,0,12"
                                ValueChanged="OnIdCorrectionChanged"/>

                        <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="40"
                                FontSize="14" Padding="12,0" Click="OnIdCorrectionsReset"
                                Content="Tout remettre à zéro"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Barre d'action.

             Grille et non DockPanel : un DockPanel donne à chaque enfant docké toute la
             largeur qu'il demande, sans jamais la lui reprendre. Les réglages de gauche
             sont nombreux (papier, finition, deux compteurs, noir et blanc) et passaient
             donc PAR-DESSUS le bouton Imprimer dès que la fenêtre rétrécissait. Ici les
             réglages occupent la place restante et se replient en plusieurs lignes ; les
             boutons d'action gardent la leur en toutes circonstances. -->
        <Border x:Name="BarreReglages" Grid.Row="2" Background="{StaticResource CardBrush}"
                CornerRadius="12" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Le verdict de conformité sur toute la largeur : c'est une phrase, pas
                     une étiquette, et la coincer entre deux blocs de boutons la tronquait. -->
                <TextBlock x:Name="ComplianceText" Grid.Row="0" Grid.ColumnSpan="2"
                           Style="{StaticResource Texte}" FontSize="17" FontWeight="SemiBold"
                           Margin="0,0,0,8" TextWrapping="Wrap"/>

                <WrapPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Sur quoi ça s'imprime -->
                    <Border Style="{StaticResource Module}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TitreModule}" Text="PAPIER"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="ProductCombo" MinWidth="300" FontSize="18"
                                          DisplayMemberPath="Label" VerticalAlignment="Center"
                                          SelectionChanged="OnProductChanged"/>
                                <TextBlock x:Name="FinishLabel" Text="Finition" Style="{StaticResource Hint}"
                                           FontSize="15" VerticalAlignment="Center" Margin="14,0,8,0"
                                           Visibility="Collapsed"/>
                                <ComboBox x:Name="FinishCombo" MinWidth="150" FontSize="18"
                                          VerticalAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Combien. Les deux compteurs ensemble et sous un même titre : ils
                         se ressemblent et ne disent pas la même chose, les séparer les
                         rendait indiscernables. -->
                    <Border Style="{StaticResource Module}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TitreModule}" Text="QUANTITÉ"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Photos" Style="{StaticResource Hint}" FontSize="15"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           ToolTip="Nombre de photos sur une planche"/>
                                <Button Style="{StaticResource BoutonModule}" Click="OnCopiesMinus">−</Button>
                                <TextBlock x:Name="CopiesText" Text="6" Style="{StaticResource Valeur}" MinWidth="44"/>
                                <Button Style="{StaticResource BoutonModule}" Click="OnCopiesPlus">+</Button>

                                <TextBlock Text="Planches" Style="{StaticResource Hint}" FontSize="15"
                                           VerticalAlignment="Center" Margin="20,0,8,0"
                                           ToolTip="Nombre de tirages identiques de CETTE photo"/>
                                <Button Style="{StaticResource BoutonModule}" Click="OnQuantityMinus">−</Button>
                                <TextBlock x:Name="QuantityText" Text="1" Style="{StaticResource Valeur}" MinWidth="44"/>
                                <Button Style="{StaticResource BoutonModule}" Click="OnQuantityPlus">+</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Redressement : une photo prise à main levée penche presque toujours,
                         et le guichet le voit. Même geste qu'ailleurs : T puis molette. -->
                    <Border Style="{StaticResource Module}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TitreModule}" Text="REDRESSER"/>
                            <StackPanel Orientation="Horizontal"
                                        ToolTip="Incline la photo pour rattraper un cadrage de travers. Raccourci : touche T, puis la molette. T ou Échap pour sortir.">
                                <Button Style="{StaticResource BoutonModule}" FontSize="20"
                                        Click="OnRedresserGauche"
                                        ToolTip="Pencher vers la gauche">↺</Button>
                                <TextBlock x:Name="RedressementText" Text="0°" Style="{StaticResource Valeur}" MinWidth="64"/>
                                <Button Style="{StaticResource BoutonModule}" FontSize="20"
                                        Click="OnRedresserDroite"
                                        ToolTip="Pencher vers la droite">↻</Button>
                                <Button Style="{StaticResource BoutonModule}" FontSize="16" Margin="6,0,0,0"
                                        Click="OnRedressementRemiseAZero"
                                        ToolTip="Remettre d'aplomb">0</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Ce qui touche aux PIXELS : les deux cases et les curseurs. Elles
                         étaient dispersées entre les compteurs et le bouton d'impression,
                         alors qu'elles font toutes la même chose — changer l'image. -->
                    <Border Style="{StaticResource Module}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TitreModule}" Text="IMAGE"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="GrayscaleCheck" VerticalAlignment="Center"
                                          Checked="OnGrayscaleChanged" Unchecked="OnGrayscaleChanged">
                                    <TextBlock Text="Noir et blanc" Style="{StaticResource Texte}" FontSize="17"/>
                                </CheckBox>
                                <CheckBox x:Name="WhiteBackgroundCheck" VerticalAlignment="Center" Margin="20,0,0,0"
                                          ToolTip="Remplace le fond de studio par du blanc franc. Le sujet n'est jamais entamé : seul est effacé ce qui ressemble au fond et touche le bord de la photo."
                                          Checked="OnWhiteBackgroundChanged" Unchecked="OnWhiteBackgroundChanged">
                                    <TextBlock Text="Fond blanc" Style="{StaticResource Texte}" FontSize="17"/>
                                </CheckBox>
                                <!-- Les mêmes corrections que sur les tirages : une photo
                                     d'identité prise au comptoir est sous-exposée ou tire
                                     au jaune comme une autre. -->
                                <Button x:Name="CorrectButton" Style="{StaticResource FlatButton}" MinWidth="140"
                                        MinHeight="48" Margin="20,0,0,0" FontSize="16" Click="OnCorrect"
                                        ToolTip="Exposition, contraste, température… les mêmes réglages que sur les tirages.">🎚  Corriger</Button>
                                <TextBlock x:Name="CorrectionsText" Style="{StaticResource Hint}" FontSize="14"
                                           VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="220"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                    <!-- Ce que le lot représente : muet sur une photo seule, où il ne
                         dirait que ce que les deux compteurs disent déjà. -->
                    <TextBlock x:Name="LotText" Style="{StaticResource Valeur}" FontSize="17"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Style="{StaticResource FlatButton}" MinWidth="130" Click="OnRedetect"
                            ToolTip="Refaire le cadrage automatique">↻ Auto</Button>
                    <!-- L'envoi est une prestation à part, facturée à la photo : il
                         n'imprime rien et l'impression ne l'envoie pas. -->
                    <Button x:Name="MailButton" Style="{StaticResource FlatButton}" MinWidth="180"
                            Margin="12,0,0,0" Click="OnSendByMail" IsEnabled="False"
                            ToolTip="Envoie au client la photo entière, le cadrage en version légère et le cadrage en pleine résolution. Prestation facturée.">✉  Envoyer</Button>
                    <!-- « Suivant » et non « Imprimer » : la planche se regarde AVANT le
                         papier. Refaire une planche identité coûte une feuille et un
                         client qui attend. -->
                    <Button x:Name="PrintButton" Style="{StaticResource BigButton}" Margin="12,0,0,0"
                            Click="OnPrint" IsEnabled="False"
                            ToolTip="Voir les planches telles qu'elles sortiront, puis imprimer">Suivant  →</Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
