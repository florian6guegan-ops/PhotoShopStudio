<UserControl x:Class="Studio.App.Views.IdPhotoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <!-- ===== Les modules de la barre du bas =====

             Ils étaient posés à la file dans un WrapPanel : papier, finition, deux
             compteurs, trois boutons de redressement, deux cases, un bouton et une
             phrase — quinze contrôles alignés sans rien qui dise lequel va avec lequel.
             On cherchait « Photos » et « Planches », qui se ressemblent et ne veulent pas
             dire la même chose.

             Chacun devient un MODULE encadré et titré. Trois avantages, dans l'ordre :
             on lit le titre au lieu de deviner ; les réglages d'une même famille se
             touchent ; et un module se replie ENTIER quand la fenêtre rétrécit, là où le
             WrapPanel coupait un compteur en deux lignes. -->

        <!-- Les cotes de ces trois styles ont été RESSERRÉES (06/08/2026) : la barre
             enflait sous les titres, les fonds et les marges de ses modules, et cette
             enflure était prise sur la seule chose que l'écran serve à faire — voir le
             visage assez grand pour placer les anneaux au millimètre. Rien n'a été retiré,
             tout a maigri : titres en 10, air de moitié, boutons à 34 px. La barre perd
             près d'un tiers de sa hauteur, qui revient à la photo. -->

        <Style x:Key="Module" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
        </Style>

        <Style x:Key="TitreModule" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="2,0,0,1"/>
        </Style>

        <!-- Les boutons ronds des compteurs et du redressement : une seule définition
             plutôt que la même paire de dimensions recopiée neuf fois.
             34 px et non 48 : sur cet écran, la hauteur de la barre est prise à la PHOTO,
             et c'est la photo qu'on est venu regarder. Un doigt en trouve encore le
             centre — c'est la cote des compteurs de la planche. -->
        <Style x:Key="BoutonModule" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="MinWidth" Value="36"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête compact : chaque pixel pris ici est un pixel de moins pour la photo, et
             c'est la photo qu'on regarde. Le titre perd sa marge basse de 18 px, l'aide
             passe en 15. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock x:Name="TitleText" DockPanel.Dock="Left" Style="{StaticResource PageTitle}"
                       Margin="0" FontSize="22" Text="Photo d'identité"/>
            <Button x:Name="AgrandirButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                    MinWidth="130" MinHeight="34" FontSize="14" Padding="12,0" Margin="10,0,0,0"
                    Click="OnBasculerAgrandissement"
                    ToolTip="Cache la bande et les réglages pour ne garder que la photo. Échap ou un second appui pour revenir.">⛶  Agrandir</Button>
            <TextBlock x:Name="AideText" DockPanel.Dock="Right" Style="{StaticResource Hint}"
                       FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="460"
                       Text="Placez l'anneau jaune au sommet du crâne et le bleu sous le menton : le cadrage suit"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 160 et non 240 : la bande ne sert qu'à reconnaître la photo, et les
                     90 px repris vont à la scène de cadrage. -->
                <ColumnDefinition x:Name="BandeColonne" Width="160"/>
                <ColumnDefinition Width="*"/>
                <!-- Le panneau des corrections, replié. Il s'ouvre SUR PLACE : voir plus bas. -->
                <ColumnDefinition x:Name="CorrectionsColonne" Width="0"/>
                <!-- LE PANNEAU PERMANENT, à droite. Les réglages vivaient dans une barre au
                     BAS de l'écran : sur une photo d'identité, l'œil fait donc l'aller-retour
                     entre le cadrage, en haut, et le papier ou le fond, en bas — cinquante
                     fois par jour. Ils sont ici à hauteur de la photo, tous visibles à la
                     fois, comme sur ID Maker. C'est la maquette validée le 14/08/2026. -->
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Bande de choix de la photo -->
            <Border x:Name="BandePhotos" Grid.Column="0" Background="{DynamicResource CardBrush}"
                    CornerRadius="12" Padding="6" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PhotoStrip">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="3" CornerRadius="8" BorderThickness="3"
                                        BorderBrush="{Binding BorderBrush}"
                                        Background="{DynamicResource PanelBrush}"
                                        MouseLeftButtonUp="OnStripPhotoClicked" Tag="{Binding}"
                                        Cursor="Hand">
                                    <Grid Height="120">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4"/>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                                   VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="4,0,4,2"/>
                                        <!-- Le rang et le nombre de planches, sur la vignette :
                                             c'est ce que DiLand écrit sur les siennes, et sans
                                             quoi une quantité posée sur une photo ne se voit
                                             qu'en revenant dessus. -->
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="9"
                                                Padding="8,3" Margin="4"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Etiquette}" Foreground="White"
                                                       FontSize="13" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Scène de cadrage.

                 DEUX RANGS, et c'est le point : la photo occupe le premier, la barre
                 d'orientation le second. Posée en 1.5.7 DANS la scène, elle flottait par
                 -dessus la photo et masquait le bas du cadrage — signalé depuis la boutique
                 le 14/08/2026. La maquette la met SOUS le cadre, pas sur l'image. -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SceneBrush}" CornerRadius="12" ClipToBounds="True">
                <Grid x:Name="Stage" Background="Transparent"
                      MouseLeftButtonDown="OnStageMouseDown" MouseLeftButtonUp="OnStageMouseUp"
                      MouseMove="OnStageMouseMove" MouseWheel="OnStageWheel"
                      IsManipulationEnabled="True"
                      ManipulationStarting="OnManipulationStarting"
                      ManipulationDelta="OnManipulationDelta"
                      SizeChanged="OnStageSizeChanged">
                    <Image x:Name="Photo" Stretch="Uniform"/>
                    <Canvas x:Name="Overlay" IsHitTestVisible="False">
                        <!-- Rien n'est assombri hors du cadrage : le voile cachait le
                             visage dès qu'il débordait de la case, alors que c'est lui
                             qu'on regarde pour juger du cadre. -->
                        <Rectangle x:Name="CropBorder" StrokeThickness="4"/>
                        <Line x:Name="CrownLine" StrokeThickness="1.5" StrokeDashArray="4 3"/>
                        <Line x:Name="ChinMinLine" StrokeThickness="1.5" StrokeDashArray="4 3"/>
                        <Line x:Name="ChinMaxLine" StrokeThickness="1.5" StrokeDashArray="4 3"/>
                        <!-- Gabarit du visage : le tour de tête doit tomber entre les deux
                             ovales. C'est le repère de DiLand, que les opérateurs lisent
                             d'un coup d'œil sans rien mesurer. -->
                        <Ellipse x:Name="HeadMinOval" Stroke="#E9527A" StrokeThickness="2"/>
                        <Ellipse x:Name="HeadMaxOval" Stroke="#E9527A" StrokeThickness="2"/>
                        <Line x:Name="FaceAxis" Stroke="#E9527A" StrokeThickness="1.5" StrokeDashArray="5 4"/>
                    </Canvas>

                    <!-- POIGNÉES DE CADRAGE, aux quatre coins du cadre.
                         Le cadrage ne se réglait qu'à la molette ; ces carrés le rendent
                         saisissable à la souris, comme sur le recadrage des tirages
                         ordinaires (voir CropSurface).

                         Quatre coins ET quatre encoches au milieu des côtés, comme sur
                         CropSurface. Avec une réserve propre à cet écran : les
                         proportions viennent du document visé et ne se négocient pas,
                         donc une encoche de côté ne DÉFORME pas — elle redimensionne le
                         cadre en laissant le côté opposé en place, l'autre dimension
                         suivant le format. C'est le seul geste que ce cadre autorise.

                         Ce canevas-ci reçoit la souris, contrairement à l'Overlay
                         au-dessus duquel il vit : c'est le seul de la scène à être
                         cliquable, et il ne l'est que sur les carrés eux-mêmes. -->
                    <Canvas x:Name="Poignees">
                        <Rectangle x:Name="Poignee0" Width="22" Height="22" Tag="0"
                                   Fill="#F0932B" Stroke="White" StrokeThickness="2" Opacity="0.85"
                                   Cursor="SizeNWSE" Visibility="Collapsed"
                                   MouseLeftButtonDown="OnPoigneeDown"/>
                        <Rectangle x:Name="Poignee1" Width="22" Height="22" Tag="1"
                                   Fill="#F0932B" Stroke="White" StrokeThickness="2" Opacity="0.85"
                                   Cursor="SizeNESW" Visibility="Collapsed"
                                   MouseLeftButtonDown="OnPoigneeDown"/>
                        <Rectangle x:Name="Poignee2" Width="22" Height="22" Tag="2"
                                   Fill="#F0932B" Stroke="White" StrokeThickness="2" Opacity="0.85"
                                   Cursor="SizeNESW" Visibility="Collapsed"
                                   MouseLeftButtonDown="OnPoigneeDown"/>
                        <Rectangle x:Name="Poignee3" Width="22" Height="22" Tag="3"
                                   Fill="#F0932B" Stroke="White" StrokeThickness="2" Opacity="0.85"
                                   Cursor="SizeNWSE" Visibility="Collapsed"
                                   MouseLeftButtonDown="OnPoigneeDown"/>

                        <!-- Couchées dans le sens du bord qu'elles commandent — barre
                             horizontale en haut et en bas, verticale à gauche et à
                             droite — pour que leur forme dise dans quel sens elles
                             tirent. -->
                        <Rectangle x:Name="PoigneeHaut" Width="34" Height="14" Tag="H"
                                   Fill="#F0932B" Stroke="White" StrokeThickness="2" Opacity="0.85"
                                   Cursor="SizeNS" Visibility="Collapsed"
                                   MouseLeftButtonDown="OnPoigneeDown"/>
                        <Rectangle x:Name="PoigneeBas" Width="34" Height="14" Tag="B"
                                   Fill="#F0932B" Stroke="White" StrokeThickness="2" Opacity="0.85"
                                   Cursor="SizeNS" Visibility="Collapsed"
                                   MouseLeftButtonDown="OnPoigneeDown"/>
                        <Rectangle x:Name="PoigneeGauche" Width="14" Height="34" Tag="G"
                                   Fill="#F0932B" Stroke="White" StrokeThickness="2" Opacity="0.85"
                                   Cursor="SizeWE" Visibility="Collapsed"
                                   MouseLeftButtonDown="OnPoigneeDown"/>
                        <Rectangle x:Name="PoigneeDroite" Width="14" Height="34" Tag="D"
                                   Fill="#F0932B" Stroke="White" StrokeThickness="2" Opacity="0.85"
                                   Cursor="SizeWE" Visibility="Collapsed"
                                   MouseLeftButtonDown="OnPoigneeDown"/>
                    </Canvas>
                    <!-- Les anneaux « crâne » et « menton » se posaient ICI, avec la ligne
                         pointillée qui les reliait. Retirés le 11/08/2026 : ils tombent en
                         plein sur le visage, c'est-à-dire exactement sur ce qu'on regarde
                         pour juger du cadrage, et la ligne blanche traînait sur l'image
                         pendant qu'on déplaçait le cadre.

                         Ce qu'ils réglaient n'est pas perdu : la hauteur de tête est posée
                         par la détection du visage (« Redétecter »), et le cadre se déplace
                         à la souris et se dimensionne à la molette. Les repères _crown et
                         _chin vivent toujours dans le code-behind — ils fixent le cadre et
                         la conformité, ils ne se montrent simplement plus. -->

                    <TextBlock x:Name="EmptyText" Foreground="White" FontSize="24" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="Choisissez une photo à gauche"/>

                    <!-- L'attente du DÉTOURAGE, la seule opération de cet écran qui se
                         compte en secondes. Elle sert aux deux qui la demandent — le fond
                         blanc et la correction du sujet — d'où sa place ici, sur la photo,
                         et non dans l'un des panneaux : l'attente est la même, qu'on ait
                         ce panneau-là ouvert ou l'autre.

                         Elle ne se montre que s'il y a vraiment à attendre : une découpe
                         déjà en mémoire rend l'aperçu en un dixième de seconde, et une
                         barre qui apparaîtrait là clignoterait à chaque curseur. -->
                    <Border x:Name="AttenteOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                            Background="#D9263238" CornerRadius="10" Padding="18,14"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                            MinWidth="320">
                        <StackPanel>
                            <TextBlock x:Name="AttenteTexte" Foreground="White" FontSize="15"
                                       Margin="0,0,0,10" TextWrapping="Wrap"
                                       HorizontalAlignment="Center"/>
                            <ProgressBar x:Name="AttenteBarre" Height="6" Minimum="0" Maximum="1"
                                         Background="#33FFFFFF" Foreground="#4ADEFF"
                                         BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <!-- Bandeau du mode redressement : un ÉTAT, pas un rappel. Tant qu'il
                         est là, la molette ne zoome plus — sans lui, l'opérateur croit
                         l'outil cassé. -->
                    <Border x:Name="BandeauRedressement" Visibility="Collapsed"
                            Background="#F0932B" CornerRadius="8" Padding="16,8"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="BandeauRedressementTexte" Foreground="#12181E"
                                   FontSize="17" FontWeight="SemiBold"
                                   Text="Redressement 0° — molette pour régler · T ou Échap pour sortir"/>
                    </Border>

                </Grid>
            </Border>

            <!-- ORIENTATION, SOUS le cadre et non dessus : à portée directe du recadrage,
                 plutôt que reléguée dans la barre du bas, mais sans rien masquer de la
                 photo. Réutilise les mêmes gestes (T + molette pour le réglage fin). -->
            <Border Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,0"
                    Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="8,6">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BoutonModule}" FontSize="17"
                            Click="OnRedresserGauche" ToolTip="Pencher vers la gauche">↺</Button>
                    <!-- Le texte suit la palette : il était en BLANC EN DUR, c'est-à-dire
                         blanc sur la carte blanche du mode clair — l'angle de redressement
                         était donc invisible sur toute la maquette d'Identité. -->
                    <TextBlock x:Name="RedressementText" Text="0°"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="18" FontWeight="SemiBold" MinWidth="52"
                               TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource BoutonModule}" FontSize="17"
                            Click="OnRedresserDroite" ToolTip="Pencher vers la droite">↻</Button>
                    <Button Style="{StaticResource BoutonModule}" FontSize="14" Margin="6,0,0,0"
                            Click="OnRedressementRemiseAZero" ToolTip="Remettre d'aplomb">0</Button>
                </StackPanel>
            </Border>
            </Grid>

            <!-- ===== Corrections, SUR PLACE =====

                 « Corriger » ouvrait un ÉCRAN : la photo disparaissait, un aperçu se
                 recalculait, on réglait à l'aveugle de ce qu'on venait de cadrer, puis on
                 revenait. Deux chargements pour bouger un curseur, et le cadrage — la seule
                 chose que cet écran sert à faire — hors de vue pendant tout ce temps.

                 Ici le panneau se déplie à droite et la photo reste où elle est, corrigée en
                 direct. C'est la barre d'outils de DiLand (recadrer · correction · yeux
                 rouges), qui ne quitte jamais l'image.

                 L'aperçu part de la vignette DÉJÀ EN MÉMOIRE : rien à charger, ni à
                 l'ouverture ni à la fermeture. -->
            <Border x:Name="CorrectionsPanel" Grid.Column="2" Visibility="Collapsed"
                    Background="{DynamicResource CardBrush}" CornerRadius="12"
                    Padding="14" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Left" Text="Corriger" FontSize="18"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TitleBrush}"/>
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="32"
                                    Padding="12,0" FontSize="14" Click="OnFermerLesCorrections"
                                    ToolTip="Refermer le panneau (Échap)">✕</Button>
                        </DockPanel>

                        <TextBlock Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   Text="La photo se corrige sous vos yeux. Le tirage reprendra exactement ces réglages."/>

                        <ToggleButton x:Name="IdRedEyeToggle" Style="{StaticResource ToggleTile}"
                                      Margin="0,0,0,12" Click="OnIdCorrectionChanged"
                                      Content="Enlever les yeux rouges"
                                      ToolTip="Neutralise le rouge du flash au fond de l'œil. Ne touche qu'aux pupilles."/>

                        <TextBlock Text="Automatiques" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,8"/>
                        <ToggleButton x:Name="IdAutoLevelsToggle" Style="{StaticResource ToggleTile}"
                                      Margin="0,0,0,5" Click="OnIdCorrectionChanged" Content="Niveaux"/>
                        <ToggleButton x:Name="IdAutoContrastToggle" Style="{StaticResource ToggleTile}"
                                      Margin="0,0,0,5" Click="OnIdCorrectionChanged" Content="Contraste"/>
                        <ToggleButton x:Name="IdAutoColorToggle" Style="{StaticResource ToggleTile}"
                                      Margin="0,0,0,12" Click="OnIdCorrectionChanged" Content="Couleur"/>

                        <TextBlock Text="Réglages" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,8"/>

                        <TextBlock x:Name="IdExposureLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdExposureSlider" Minimum="-2" Maximum="2" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" Margin="0,0,0,8"
                                ValueChanged="OnIdCorrectionChanged"/>

                        <TextBlock x:Name="IdContrastLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdContrastSlider" Minimum="-100" Maximum="100" Margin="0,0,0,8"
                                ValueChanged="OnIdCorrectionChanged"/>

                        <TextBlock x:Name="IdHighlightsLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdHighlightsSlider" Minimum="-100" Maximum="100" Margin="0,0,0,8"
                                ValueChanged="OnIdCorrectionChanged"/>

                        <TextBlock x:Name="IdShadowsLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdShadowsSlider" Minimum="-100" Maximum="100" Margin="0,0,0,8"
                                ValueChanged="OnIdCorrectionChanged"/>

                        <TextBlock x:Name="IdTemperatureLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdTemperatureSlider" Minimum="-100" Maximum="100" Margin="0,0,0,8"
                                ValueChanged="OnIdCorrectionChanged"/>

                        <TextBlock x:Name="IdSaturationLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdSaturationSlider" Minimum="-100" Maximum="100" Margin="0,0,0,8"
                                ValueChanged="OnIdCorrectionChanged"/>

                        <TextBlock x:Name="IdSharpnessLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdSharpnessSlider" Minimum="0" Maximum="100" Margin="0,0,0,12"
                                ValueChanged="OnIdCorrectionChanged"/>

                        <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="40"
                                FontSize="14" Padding="12,0" Click="OnIdCorrectionsReset"
                                Content="Tout remettre à zéro"/>

                        <Separator Margin="0,14,0,12" Background="{DynamicResource TitleBrush}"
                                   Opacity="0.25"/>

                        <!-- Le sujet seul. Un panneau À PART et non une section de plus :
                             ces réglages ont une portée différente de tous ceux du dessus,
                             et les mêler ferait chercher pourquoi une exposition agit
                             tantôt sur toute la photo, tantôt sur le seul visage. -->
                        <Button x:Name="IdSujetButton" Style="{StaticResource FlatButton}"
                                MinWidth="0" MinHeight="44" FontSize="14" Padding="12,0"
                                Click="OnOuvrirLaSelectionDuSujet"
                                ToolTip="Corriger le visage sans toucher au fond : exposition, contraste, éclat."
                                Content="👤  Sélection du sujet…"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== Le sujet seul, sans le fond =====

                 Sur une photo d'identité le fond est IMPOSÉ — uni, clair, souvent reposé
                 en blanc ou en gris par Studio lui-même. Tout ce qu'on fait pour rattraper
                 un visage sous-exposé l'abîme : l'exposition grise le blanc, le contraste
                 y révèle l'ombre du sujet, la saturation le teinte. Il fallait choisir
                 entre un visage juste et un fond conforme.

                 Le panneau occupe la MÊME colonne que « Corriger », qu'il remplace le temps
                 du réglage : la photo, elle, ne bouge pas — c'est elle qu'on regarde. -->
            <Border x:Name="SujetPanel" Grid.Column="2" Visibility="Collapsed"
                    Background="{DynamicResource CardBrush}" CornerRadius="12"
                    Padding="14" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Left" Text="Sélection du sujet" FontSize="18"
                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TitleBrush}"/>
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="32"
                                    Padding="12,0" FontSize="14" Click="OnFermerLaSelectionDuSujet"
                                    ToolTip="Revenir aux corrections (Échap)">✕</Button>
                        </DockPanel>

                        <TextBlock x:Name="IdSujetEtat" Style="{StaticResource Hint}" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Ces réglages ne touchent que la personne. Le fond reste tel quel."/>

                        <ToggleButton x:Name="IdSujetToggle" Style="{StaticResource ToggleTile}"
                                      Margin="0,0,0,12" Click="OnIdSujetChanged"
                                      Content="Corriger le sujet seul"
                                      ToolTip="Détoure la personne et n'applique les réglages ci-dessous qu'à elle."/>

                        <TextBlock Text="Contour" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,8"/>

                        <TextBlock x:Name="IdSujetContourLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdSujetContourSlider" Minimum="-10" Maximum="10"
                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,8"
                                ValueChanged="OnIdSujetChanged"
                                ToolTip="Élargit ou resserre la découpe. Élargir d'un ou deux pixels évite le liseré autour des cheveux."/>

                        <TextBlock x:Name="IdSujetAdoucirLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdSujetAdoucirSlider" Minimum="0" Maximum="20"
                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,12"
                                ValueChanged="OnIdSujetChanged"
                                ToolTip="Adoucit la transition. C'est la bordure qui trahit une retouche, pas la correction."/>

                        <TextBlock Text="Corrections du sujet" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,8"/>

                        <TextBlock x:Name="IdSujetExpoLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdSujetExpoSlider" Minimum="-2" Maximum="2" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" Margin="0,0,0,8"
                                ValueChanged="OnIdSujetChanged"/>

                        <TextBlock x:Name="IdSujetContrasteLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdSujetContrasteSlider" Minimum="-100" Maximum="100" Margin="0,0,0,8"
                                ValueChanged="OnIdSujetChanged"/>

                        <TextBlock x:Name="IdSujetOmbresLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdSujetOmbresSlider" Minimum="-100" Maximum="100" Margin="0,0,0,8"
                                ValueChanged="OnIdSujetChanged"/>

                        <TextBlock x:Name="IdSujetHautesLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdSujetHautesSlider" Minimum="-100" Maximum="100" Margin="0,0,0,8"
                                ValueChanged="OnIdSujetChanged"/>

                        <TextBlock x:Name="IdSujetSaturationLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdSujetSaturationSlider" Minimum="-100" Maximum="100" Margin="0,0,0,8"
                                ValueChanged="OnIdSujetChanged"/>

                        <TextBlock x:Name="IdSujetVibranceLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdSujetVibranceSlider" Minimum="-100" Maximum="100" Margin="0,0,0,8"
                                ValueChanged="OnIdSujetChanged"
                                ToolTip="N'intensifie que les couleurs ternes, et épargne les teints de peau."/>

                        <TextBlock x:Name="IdSujetClarteLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdSujetClarteSlider" Minimum="-100" Maximum="100" Margin="0,0,0,8"
                                ValueChanged="OnIdSujetChanged"
                                ToolTip="Contraste local : donne du relief sans toucher aux couleurs."/>

                        <TextBlock x:Name="IdSujetNettateLabel" Style="{StaticResource Hint}" FontSize="13"/>
                        <Slider x:Name="IdSujetNettateSlider" Minimum="0" Maximum="100" Margin="0,0,0,12"
                                ValueChanged="OnIdSujetChanged"/>

                        <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="40"
                                FontSize="14" Padding="12,0" Click="OnIdSujetReset"
                                Content="Remettre le sujet à zéro"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== LE PANNEAU PERMANENT (maquette ID Maker) =====

                 Tout ce qui décide de la planche, à hauteur de la photo et visible d'un
                 seul coup d'œil : le papier, ce qu'on tire, le fond, l'affichage, les
                 corrections, puis les actions. Ces contrôles vivaient dans une barre au bas
                 de l'écran — mêmes noms, mêmes gestionnaires, seulement déplacés.

                 L'ordre suit la maquette et le geste du comptoir : on choisit le document
                 et le papier, on regarde la planche, on traite le fond, puis on imprime. -->
            <Border Grid.Column="3" Background="{DynamicResource CardBrush}" CornerRadius="12"
                    Padding="12" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- LE DOCUMENT, en tête du panneau : c'est la première décision du
                             comptoir, et elle était prise sur un ÉCRAN SÉPARÉ avant d'arriver
                             ici. On ne change plus de page pour passer d'un passeport français
                             à un visa américain — la carte s'ouvre, on choisit, on revient. -->
                        <TextBlock Style="{StaticResource TitreModule}" Text="DOCUMENT"/>
                        <Button x:Name="DocumentButton" Style="{StaticResource FlatButton}"
                                MinWidth="0" MinHeight="54" Padding="12,6" HorizontalContentAlignment="Left"
                                Click="OnChangerDeDocument"
                                ToolTip="Changer de pays ou de format — les 274 normes officielles">
                            <StackPanel>
                                <TextBlock x:Name="DocumentText" FontSize="16" FontWeight="SemiBold"
                                           Text="France · 35 × 45 mm"/>
                                <TextBlock Text="Toucher pour changer de pays ou de format"
                                           FontSize="11" Opacity="0.75"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Style="{StaticResource TitreModule}" Text="PAPIER" Margin="0,16,0,0"/>
                        <ComboBox x:Name="ProductCombo" FontSize="15" Padding="8,6"
                                  DisplayMemberPath="Label" Margin="0,0,0,8"
                                  SelectionChanged="OnProductChanged"/>
                        <TextBlock x:Name="FinishLabel" Text="Finition" Style="{StaticResource Hint}"
                                   FontSize="13" Visibility="Collapsed"/>
                        <ComboBox x:Name="FinishCombo" FontSize="15" Padding="8,6"
                                  Margin="0,4,0,0" Visibility="Collapsed"/>

                        <!-- Ce que le lot représente : muet sur une photo seule, où il ne
                             dirait que ce que les deux compteurs disent déjà. -->
                        <TextBlock x:Name="LotText" Style="{StaticResource Valeur}" FontSize="16"
                                   HorizontalAlignment="Left" TextAlignment="Left" Margin="0,10,0,0"/>

                        <TextBlock Style="{StaticResource TitreModule}" Text="LA PLANCHE" Margin="0,16,0,0"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Photos" Style="{StaticResource Hint}"
                                       FontSize="14" VerticalAlignment="Center"
                                       ToolTip="Nombre de photos sur une planche"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource BoutonModule}" Click="OnCopiesMinus">−</Button>
                                <TextBlock x:Name="CopiesText" Text="6" Style="{StaticResource Valeur}"
                                           FontSize="19" MinWidth="42"/>
                                <Button Style="{StaticResource BoutonModule}" Click="OnCopiesPlus">+</Button>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Planches" Style="{StaticResource Hint}"
                                       FontSize="14" VerticalAlignment="Center"
                                       ToolTip="Nombre de tirages identiques de CETTE photo"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource BoutonModule}" Click="OnQuantityMinus">−</Button>
                                <TextBlock x:Name="QuantityText" Text="1" Style="{StaticResource Valeur}"
                                           FontSize="19" MinWidth="42"/>
                                <Button Style="{StaticResource BoutonModule}" Click="OnQuantityPlus">+</Button>
                            </StackPanel>
                        </Grid>

                        <!-- LE PORTRAIT des deux formats de la rentrée.
                             Il est proposé, jamais exigé : le cadre large est posé tout seul
                             autour du visage (CadrageElargi), et l'opérateur ne touche à ce
                             bouton que s'il veut le reprendre. Un jour de rentrée, un geste
                             de plus par enfant se paie en file d'attente. -->
                        <StackPanel x:Name="PortraitCard" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource TitreModule}" Text="LA GRANDE PHOTO"
                                       Margin="0,16,0,0"/>
                            <TextBlock x:Name="PortraitText" Style="{StaticResource Hint}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Cadre large posé automatiquement autour du visage."/>
                            <Button x:Name="PortraitButton" Style="{StaticResource FlatButton}"
                                    MinWidth="0" MinHeight="42" Padding="12,0" FontSize="15"
                                    Click="OnCadrerLaGrande"
                                    ToolTip="Reprendre le cadrage de la grande photo : épaules, décentrage, zoom.">🖼  Cadrer la grande photo</Button>
                        </StackPanel>

                        <TextBlock Style="{StaticResource TitreModule}" Text="FOND &amp; SUJET" Margin="0,16,0,0"/>
                        <CheckBox x:Name="WhiteBackgroundCheck" Style="{StaticResource CaseCochable}"
                                  Margin="0,0,0,6"
                                  ToolTip="Remplace le fond de studio par du blanc franc. Le sujet n'est jamais entamé : seul est effacé ce qui ressemble au fond et touche le bord de la photo."
                                  Checked="OnWhiteBackgroundChanged" Unchecked="OnWhiteBackgroundChanged">
                            <TextBlock Text="Fond blanc" Style="{StaticResource Texte}" FontSize="14"/>
                        </CheckBox>
                        <!-- Le gris est le fond que les textes attendent : sur du blanc
                             franc, une chemise blanche ou des cheveux blancs se fondent et
                             la silhouette ne se détache plus. Les deux cases sont exclusives. -->
                        <CheckBox x:Name="GrayBackgroundCheck" Style="{StaticResource CaseCochable}"
                                  ToolTip="Même détourage, posé sur un gris clair conforme aux normes. À préférer au blanc quand le sujet porte du clair ou a les cheveux blancs : la silhouette se détache."
                                  Checked="OnGrayBackgroundChanged" Unchecked="OnGrayBackgroundChanged">
                            <TextBlock Text="Fond gris" Style="{StaticResource Texte}" FontSize="14"/>
                        </CheckBox>

                        <TextBlock Style="{StaticResource TitreModule}" Text="AFFICHAGE" Margin="0,16,0,0"/>
                        <CheckBox x:Name="GrayscaleCheck" Style="{StaticResource CaseCochable}"
                                  Checked="OnGrayscaleChanged" Unchecked="OnGrayscaleChanged">
                            <TextBlock Text="Noir et blanc" Style="{StaticResource Texte}" FontSize="14"/>
                        </CheckBox>

                        <!-- CE QUE LA BANDE AFFIRME.

                             La case vit AUSSI ici, et pas seulement au récapitulatif, parce
                             que STUDIO PHOTO IDENTITÉ NE PASSE JAMAIS PAR LE RÉCAPITULATIF :
                             sur un poste identité verrouillé, « Imprimer » sort la planche
                             sans écran intermédiaire — c'est délibéré, un écran de plus par
                             client se paie en file d'attente. La case posée là-bas n'était
                             donc atteignable que depuis le Studio complet, et le poste qui
                             tire le plus de planches d'école était le seul à ne pas l'avoir.
                             Signalé le 22/08/2026.

                             Elle porte sur la photo affichée, comme les cases au-dessus.
                             Cocher quand la bande en contient d'autres propose de les
                             marquer toutes : une série d'école l'est en entier, et cocher
                             trente fois est le geste qu'on oublie sur la trentième. -->
                        <TextBlock Style="{StaticResource TitreModule}" Text="CONFORMITÉ" Margin="0,16,0,0"/>
                        <CheckBox x:Name="NonConformeCheck" Style="{StaticResource CaseCochable}"
                                  ToolTip="Pour une photo d'école, un souvenir, ou un client qui tient à sa pose : la planche sort avec « PHOTOS NON CONFORMES » au lieu de la mention de conformité. Le nom du magasin reste écrit."
                                  Checked="OnNonConformeChanged" Unchecked="OnNonConformeChanged">
                            <TextBlock Text="Photos non conformes" Style="{StaticResource Texte}" FontSize="14"/>
                        </CheckBox>

                        <TextBlock Style="{StaticResource TitreModule}" Text="CORRECTIONS" Margin="0,16,0,0"/>

                        <!-- LES DEUX FAÇONS DE REPRENDRE UNE PHOTO, SUR UNE SEULE LIGNE.

                             Elles répondent à la même question du comptoir — « on peut
                             arranger ça ? » — et se partagent donc un rang. À gauche ce que
                             Studio sait faire seul : exposition, contraste, température, les
                             mêmes réglages que sur les tirages, une photo d'identité prise au
                             comptoir étant sous-exposée comme une autre. À droite ce
                             qu'aucun curseur ne fera — un bouton sur le front, une mèche à
                             rattraper, une marque à effacer —, et qui sort donc dans
                             Photoshop pour revenir à l'enregistrement.

                             ⚠ <b>Côte à côte et non empilés, parce que ce panneau tient en
                             UNE PAGE.</b> C'est la maquette validée le 14/08/2026 : tous les
                             réglages visibles à la fois, à hauteur de la photo, sans
                             ascenseur. Un second bouton pleine largeur ajoutait 50 px et
                             poussait « Imprimer la planche » sous le bord de l'écran — le
                             geste le plus fréquent de la journée devenait le seul à demander
                             un défilement. La largeur ne manque pas, elle : 336 px utiles
                             pour deux libellés courts. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CorrectButton" Grid.Column="0"
                                    Style="{StaticResource FlatButton}" MinWidth="0"
                                    MinHeight="42" Padding="6,0" FontSize="15" Click="OnCorrect"
                                    ToolTip="Exposition, contraste, température… les mêmes réglages que sur les tirages.">🎚  Corriger</Button>
                            <!-- Le cadrage du visage est CONSERVÉ au retour — sauf si la
                                 retouche a changé la taille de l'image. Voir OnRetoucher. -->
                            <Button x:Name="RetoucheButton" Grid.Column="1"
                                    Style="{StaticResource FlatButton}" MinWidth="0"
                                    MinHeight="42" Padding="6,0" FontSize="15" Margin="8,0,0,0"
                                    Click="OnRetoucher" IsEnabled="False"
                                    ToolTip="Ouvrir la photo affichée dans Photoshop. Enregistrez là-bas (Ctrl+S) et elle revient ici retouchée, sans toucher au fichier du client. Les autres photos de la bande ne bougent pas.">✎  Retoucher</Button>
                        </Grid>
                        <TextBlock x:Name="CorrectionsText" Style="{StaticResource Hint}" FontSize="12"
                                   Margin="0,6,0,0"/>
                        <TextBlock x:Name="RetoucheEtatText" Style="{StaticResource Hint}" FontSize="12"
                                   Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                        <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="42"
                                Padding="12,0" FontSize="15" Margin="0,8,0,0" Click="OnRedetect"
                                ToolTip="Refaire le cadrage automatique">↻  Cadrage automatique</Button>

                        <!-- LES ACTIONS, en bas et dans l'ordre où elles se décident.
                             L'envoi est une prestation à part, facturée à la photo : il
                             n'imprime rien, et l'impression ne l'envoie pas. -->
                        <Button x:Name="PrintButton" Style="{StaticResource BigButton}"
                                MinHeight="58" MinWidth="0" FontSize="19" Padding="12,8"
                                Margin="0,20,0,0" Click="OnPrint" IsEnabled="False"
                                ToolTip="Imprimer la planche">🖨  Imprimer la planche</Button>
                        <Button x:Name="MailButton" Style="{StaticResource FlatButton}" MinWidth="0"
                                MinHeight="46" Padding="12,0" FontSize="15" Margin="0,8,0,0"
                                Click="OnSendByMail" IsEnabled="False"
                                ToolTip="Envoie au client la photo entière, le cadrage en version légère et le cadrage en pleine résolution. Prestation facturée.">✉  Envoyer par e-mail</Button>

                        <!-- LE SEUL DÉTOUR QUI RESTE, et il est justifié : choisir des
                             photos, c'est parcourir une carte mémoire ou un téléphone, et
                             cela ne tient pas dans un panneau. Tout le reste se fait ici. -->
                        <Button x:Name="OuvrirButton" Style="{StaticResource FlatButton}" MinWidth="0"
                                MinHeight="46" Padding="12,0" FontSize="15" Margin="0,8,0,0"
                                Click="OnOuvrirDesPhotos"
                                ToolTip="Carte mémoire, téléphone, dossier…">📂  Ouvrir des photos</Button>

                        <!-- L'AUTRE FAÇON D'OUVRIR UNE PHOTO : celles qu'on a déjà faites.
                             Même détour que le précédent, et pour la même raison — une
                             planche de vignettes ne tient pas dans un panneau de 360 px.
                             Masqué hors de Studio Photo Identité (voir le code-behind). -->
                        <Button x:Name="HistoriqueButton" Style="{StaticResource FlatButton}" MinWidth="0"
                                MinHeight="46" Padding="12,0" FontSize="15" Margin="0,8,0,0"
                                Click="OnOuvrirLHistorique" Visibility="Collapsed"
                                ToolTip="Les photos imprimées ou envoyées ces trente derniers jours, à rouvrir telles qu'elles étaient — fond, cadrage et corrections compris.">🕘  Photos récentes · 30 j</Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Barre d'action.

             Grille et non DockPanel : un DockPanel donne à chaque enfant docké toute la
             largeur qu'il demande, sans jamais la lui reprendre. Les réglages de gauche
             sont nombreux (papier, finition, deux compteurs, noir et blanc) et passaient
             donc PAR-DESSUS le bouton Imprimer dès que la fenêtre rétrécissait. Ici les
             réglages occupent la place restante et se replient en plusieurs lignes ; les
             boutons d'action gardent la leur en toutes circonstances. -->
        <!-- LA BARRE DU BAS, réduite à ce qui la justifie : le verdict de conformité.

             Elle portait le papier, les compteurs, le fond, les corrections et les trois
             boutons d'action. Tout cela est remonté dans le panneau de droite, à hauteur de
             la photo — voir la maquette. Ce qui reste est une PHRASE, sur toute la largeur :
             la coincer entre deux blocs de boutons la tronquait. -->
        <Border x:Name="BarreReglages" Grid.Row="2" Background="{DynamicResource CardBrush}"
                CornerRadius="12" Padding="12,8" Margin="0,8,0,0">
            <TextBlock x:Name="ComplianceText" Style="{StaticResource Texte}"
                       FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
