<UserControl x:Class="Studio.App.Views.ReglagesCouleurDnpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}"
                   Text="Profil couleur de la DNP"/>

        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="Le profil décide de la couleur qui sort de la DS620 : chair plus ou moins chaude, contraste, saturation. Il s'applique à TOUT ce qui sort de cette machine — planches d'identité, E-Photo, 10×15 —, parce que la couleur dépend de la machine et de son papier, pas du produit."/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- LE CHOIX. Un seul profil pour la machine : voir ProfilCouleurDnp. -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Texte}" FontSize="19" FontWeight="SemiBold"
                                   Text="Le profil appliqué"/>

                        <ComboBox x:Name="ProfilCombo" Margin="0,14,0,0" MinHeight="46" FontSize="17"
                                  SelectionChanged="OnProfilChange"/>

                        <TextBlock x:Name="EtatText" Style="{StaticResource Texte}" FontSize="16"
                                   Margin="0,12,0,0" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource FlatButton}" MinWidth="260" MinHeight="46"
                                    FontSize="16" Click="OnImporter">Ajouter un profil du poste…</Button>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Text="Les profils du pilote DNP et ceux livrés par DiLand se nomment DS620…icc ou DS620…icm. « Vivid » sature davantage ; le profil au nom simple est le rendu neutre du fabricant. Changer de profil ne demande pas de redémarrer : le tirage suivant en tient compte."/>
                    </StackPanel>
                </Border>

                <!-- CE QUE ÇA TOUCHE. L'opérateur doit voir la liste AVANT d'enregistrer :
                     c'est ainsi qu'on a découvert que l'E-Photo n'avait aucun profil alors
                     qu'elle sort de la même machine que la planche d'identité. -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Texte}" FontSize="19" FontWeight="SemiBold"
                                   Text="Ce que ce réglage touche"/>
                        <TextBlock x:Name="ProduitsText" Style="{StaticResource Texte}" FontSize="15"
                                   Margin="0,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource FlatButton}" MinWidth="180" MinHeight="52" FontSize="19"
                    Click="OnRetour">Retour</Button>
            <Button x:Name="EnregistrerButton" Style="{StaticResource BigButton}" MinWidth="240"
                    MinHeight="52" FontSize="19" Margin="12,0,0,0" Click="OnEnregistrer">Enregistrer</Button>
        </StackPanel>
    </Grid>
</UserControl>
