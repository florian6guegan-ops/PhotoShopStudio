<UserControl x:Class="Studio.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Tuile facon DiLand : grande cible tactile, titre lisible de loin,
             sous-titre qui dit ce que le bouton fait vraiment. -->
        <Style x:Key="Tuile" TargetType="Button">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fond" Background="{TemplateBinding Background}" CornerRadius="12"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fond" Property="Background" Value="{StaticResource PanelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="fond" Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TuileTitre" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TuileSousTitre" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="16,6,16,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Que voulez-vous faire ?" Style="{StaticResource PageTitle}"
                   HorizontalAlignment="Center"/>

        <UniformGrid Grid.Row="1" Columns="3" Rows="3">
            <Button Style="{StaticResource Tuile}" Click="OnNewOrder"
                    AutomationProperties.Name="Nouvelle commande"
                    Background="{StaticResource AccentBrush}">
                <StackPanel>
                    <TextBlock Text="Nouvelle commande" Style="{StaticResource TuileTitre}"
                               Foreground="White"/>
                    <TextBlock Text="Tirages à partir d'une carte, d'une clé ou d'un CD"
                               Style="{StaticResource TuileSousTitre}" Foreground="#DDFFFFFF"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource Tuile}" Click="OnPhoneUpload"
                    AutomationProperties.Name="Photos d'un téléphone">
                <StackPanel>
                    <TextBlock Text="Photos d'un téléphone" Style="{StaticResource TuileTitre}"/>
                    <TextBlock Text="Le client envoie ses photos depuis son mobile"
                               Style="{StaticResource TuileSousTitre}"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource Tuile}" Click="OnIdPhoto"
                    AutomationProperties.Name="Photos d'identité">
                <StackPanel>
                    <TextBlock Text="Photos d'identité" Style="{StaticResource TuileTitre}"/>
                    <TextBlock Text="Planche aux normes, 274 documents connus"
                               Style="{StaticResource TuileSousTitre}"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource Tuile}" Click="OnOrders"
                    AutomationProperties.Name="Commandes du jour">
                <StackPanel>
                    <TextBlock Text="Commandes du jour" Style="{StaticResource TuileTitre}"/>
                    <TextBlock Text="Suivre, réimprimer, imprimer un ticket"
                               Style="{StaticResource TuileSousTitre}"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource Tuile}" Click="OnMachineStatus"
                    AutomationProperties.Name="État des machines">
                <StackPanel>
                    <TextBlock Text="État des machines" Style="{StaticResource TuileTitre}"/>
                    <TextBlock Text="Papier, encres, tirages restants par format"
                               Style="{StaticResource TuileSousTitre}"/>
                </StackPanel>
            </Button>

            <Button x:Name="LargeFormatButton" Style="{StaticResource Tuile}" Click="OnLargeFormatQueue"
                    AutomationProperties.Name="Agrandissements à tirer">
                <StackPanel>
                    <TextBlock x:Name="LargeFormatTitle" Text="Agrandissements à tirer"
                               Style="{StaticResource TuileTitre}"/>
                    <TextBlock Text="Grands formats à sortir sur l'Epson"
                               Style="{StaticResource TuileSousTitre}"/>
                </StackPanel>
            </Button>

            <Button x:Name="KioskOrdersButton" Style="{StaticResource Tuile}" Click="OnKioskOrders"
                    AutomationProperties.Name="Commandes des bornes">
                <StackPanel>
                    <TextBlock x:Name="KioskOrdersTitle" Text="Commandes des bornes"
                               Style="{StaticResource TuileTitre}"/>
                    <TextBlock Text="Reprendre les commandes reçues par DiLand"
                               Style="{StaticResource TuileSousTitre}"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource Tuile}" Click="OnCatalog"
                    AutomationProperties.Name="Catalogue et imprimantes">
                <StackPanel>
                    <TextBlock Text="Catalogue et imprimantes" Style="{StaticResource TuileTitre}"/>
                    <TextBlock Text="Formats, prix, finitions" Style="{StaticResource TuileSousTitre}"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource Tuile}" Click="OnStats"
                    AutomationProperties.Name="Statistiques">
                <StackPanel>
                    <TextBlock Text="Statistiques" Style="{StaticResource TuileTitre}"/>
                    <TextBlock Text="Ventes et volumes" Style="{StaticResource TuileSousTitre}"/>
                </StackPanel>
            </Button>
        </UniformGrid>
    </Grid>
</UserControl>
