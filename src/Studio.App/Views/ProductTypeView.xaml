<UserControl x:Class="Studio.App.Views.ProductTypeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Grande tuile de choix, comme l'écran « Sélectionnez un produit » de DiLand -->
        <Style x:Key="GrandeTuile" TargetType="Button">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fond" Background="{TemplateBinding Background}" CornerRadius="14"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fond" Property="Background" Value="{DynamicResource PanelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="fond" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fond" Property="Background" Value="#161C22"/>
                                <Setter TargetName="fond" Property="BorderBrush" Value="#2E3A46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitreTuile" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SousTitreTuile" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="30,10,30,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sélectionnez un produit" Style="{StaticResource PageTitle}"
                   HorizontalAlignment="Center"/>

        <UniformGrid Grid.Row="1" Columns="2" Rows="2">
            <Button Style="{StaticResource GrandeTuile}" Click="OnTirages"
                    AutomationProperties.Name="Tirages">
                <StackPanel>
                    <TextBlock Text="Tirages" Style="{StaticResource TitreTuile}"/>
                    <TextBlock Text="Photos sur papier, du 10×15 au grand format"
                               Style="{StaticResource SousTitreTuile}"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource GrandeTuile}" Click="OnIdPhoto"
                    AutomationProperties.Name="Photo d'identité">
                <StackPanel>
                    <TextBlock Text="Photo d'identité" Style="{StaticResource TitreTuile}"/>
                    <TextBlock Text="Planche aux normes officielles, 274 documents connus"
                               Style="{StaticResource SousTitreTuile}"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource GrandeTuile}" IsEnabled="False">
                <StackPanel>
                    <TextBlock Text="Produits personnalisés" Style="{StaticResource TitreTuile}"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="Mug, tee-shirt, coussin, puzzle — à venir"
                               Style="{StaticResource SousTitreTuile}"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource GrandeTuile}" IsEnabled="False">
                <StackPanel>
                    <TextBlock Text="Pêle-mêle" Style="{StaticResource TitreTuile}"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="Plusieurs photos sur un seul tirage — à venir"
                               Style="{StaticResource SousTitreTuile}"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <Button Grid.Row="2" Style="{StaticResource FlatButton}" HorizontalAlignment="Center"
                MinWidth="220" Margin="0,16,0,0" Click="OnCancel">Annuler</Button>
    </Grid>
</UserControl>
