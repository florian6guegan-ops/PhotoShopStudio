<UserControl x:Class="Studio.App.Views.PrintFamilyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Famille" TargetType="Button">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fond" Background="{TemplateBinding Background}" CornerRadius="14"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fond" Property="Background" Value="{DynamicResource PanelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="fond" Property="Background" Value="{DynamicResource AccentDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fond" Property="Background" Value="#161C22"/>
                                <Setter TargetName="fond" Property="BorderBrush" Value="#2E3A46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sélectionnez un produit" Style="{StaticResource PageTitle}"
                   HorizontalAlignment="Center"/>

        <UniformGrid Grid.Row="1" Columns="3" Rows="1">
            <Button Style="{StaticResource Famille}" Click="OnRapide"
                    AutomationProperties.Name="Impression rapide">
                <StackPanel>
                    <TextBlock Text="Impression rapide" FontSize="32" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="RapideDetail" FontSize="17" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="30,12,30,0"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource Famille}" Click="OnAgrandissements"
                    AutomationProperties.Name="Agrandissements">
                <StackPanel>
                    <TextBlock Text="Agrandissements" FontSize="32" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="AgrandissementDetail" FontSize="17" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="30,12,30,0"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource Famille}" Click="OnCadreBlanc"
                    AutomationProperties.Name="Avec cadre blanc">
                <StackPanel>
                    <TextBlock Text="Avec cadre blanc" FontSize="32" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CadreBlancDetail" FontSize="17" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="30,12,30,0"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Style="{StaticResource FlatButton}" MinWidth="200" Margin="0,0,12,0"
                    AutomationProperties.Name="Précédent" Click="OnBack">← Précédent</Button>
            <Button Style="{StaticResource FlatButton}" MinWidth="200"
                    AutomationProperties.Name="Annuler" Click="OnCancel">Annuler</Button>
        </StackPanel>
    </Grid>
</UserControl>
