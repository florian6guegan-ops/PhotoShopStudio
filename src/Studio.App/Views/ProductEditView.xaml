<UserControl x:Class="Studio.App.Views.ProductEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,14"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Style="{StaticResource PageTitle}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="24" MaxWidth="860"
                    HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Nom affiché"/>
                    <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldBox}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Code (unique)"/>
                    <TextBox x:Name="CodeBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldBox}" MaxWidth="260" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Prix (€)"/>
                    <TextBox x:Name="PriceBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldBox}" MaxWidth="160" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Largeur × hauteur (mm)"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="WidthBox" Style="{StaticResource FieldBox}" Width="120"
                                 TextChanged="OnCotesChanged"/>
                        <TextBlock Text="×" Style="{StaticResource Texte}" FontSize="22"
                                   VerticalAlignment="Center" Margin="10,0,10,14"/>
                        <TextBox x:Name="HeightBox" Style="{StaticResource FieldBox}" Width="120"
                                 TextChanged="OnCotesChanged"/>
                        <!-- L'équivalent en CENTIMÈTRES, sous les yeux pendant la frappe.
                             Les noms du métier sont en cm et les cotes en mm : c'est ce
                             qui a fait sortir un « 40×50 » en 4 × 5 cm le 08/08/2026. -->
                        <TextBlock x:Name="CotesEnCmText" Style="{StaticResource Texte}"
                                   FontSize="17" VerticalAlignment="Center" Margin="16,0,0,14"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>

                    <!-- La SORTIE manquait à cette fiche : faute de pouvoir la saisir, elle
                         retombait sur « file Windows » à chaque enregistrement, et un tirage
                         du minilab s'en trouvait converti en tirage imprimante. -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Sortie et imprimante"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                        <ComboBox x:Name="OutputCombo" MinWidth="300" FontSize="20" Padding="10,8"
                                  Margin="0,0,12,14" VerticalAlignment="Center"
                                  SelectionChanged="OnOutputChanged"/>
                        <ComboBox x:Name="PrinterCombo" MinWidth="280" FontSize="20" Padding="10,8"
                                  Margin="0,0,0,14" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Cadrage par défaut"/>
                    <ComboBox x:Name="FitCombo" Grid.Row="5" Grid.Column="1" FontSize="20" Padding="10,8" Margin="0,0,0,14"
                              MaxWidth="380" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Marge blanche (mm)"/>
                    <TextBox x:Name="BorderBox" Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldBox}" MaxWidth="160" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Résolution (dpi)"/>
                    <TextBox x:Name="DpiBox" Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldBox}" MaxWidth="160" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Planche (identité)"/>
                    <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                        <CheckBox x:Name="SheetCheck" VerticalAlignment="Center" Margin="0,0,16,14"
                                  Checked="OnSheetToggled" Unchecked="OnSheetToggled">
                            <TextBlock Text="planche de copies" Style="{StaticResource Texte}" FontSize="18"/>
                        </CheckBox>
                        <TextBox x:Name="SheetCopiesBox" Style="{StaticResource FieldBox}" Width="80" IsEnabled="False"/>
                        <TextBlock Text="copies de" Style="{StaticResource Texte}" FontSize="18"
                                   VerticalAlignment="Center" Margin="10,0,10,14"/>
                        <TextBox x:Name="SheetWBox" Style="{StaticResource FieldBox}" Width="80" IsEnabled="False"/>
                        <TextBlock Text="×" Style="{StaticResource Texte}" FontSize="20"
                                   VerticalAlignment="Center" Margin="8,0,8,14"/>
                        <TextBox x:Name="SheetHBox" Style="{StaticResource FieldBox}" Width="80" IsEnabled="False"/>
                        <TextBlock Text="mm" Style="{StaticResource Texte}" FontSize="18"
                                   VerticalAlignment="Center" Margin="8,0,0,14"/>
                    </StackPanel>

                    <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Profil couleur (ICC)"/>
                    <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,14">
                        <ComboBox x:Name="IccCombo" MinWidth="320" FontSize="18" Padding="10,8" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource FlatButton}" Margin="12,0,0,0" MinHeight="44" MinWidth="150"
                                FontSize="17" Padding="12,6" Click="OnImportIcc"
                                ToolTip="Importer un profil fourni par le pilote (dossier couleur de Windows)">📥 Importer…</Button>
                    </StackPanel>

                    <!-- La machine ne rend pas ce que l'écran montre, et l'écart est le
                         sien : la DS620 sort plus sombre que le minilab. Le réglage se
                         mesure sur un tirage réel, d'où sa place ici et non dans le code. -->
                    <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource FieldLabel}"
                               Text="Exposition à l'impression"/>
                    <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="PrintExposureBox" Style="{StaticResource FieldBox}" Width="120"/>
                        <TextBlock Style="{StaticResource Hint}" FontSize="15" MaxWidth="480"
                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,14"
                                   Text="En diaphragmes, 0 = aucune correction. Positif éclaircit. Corrige l'écart propre à la machine, sans toucher à l'aperçu à l'écran : +0,25 environ pour la DS620, qui sort plus sombre que le minilab."/>
                    </StackPanel>

                    <!-- Le nom que le MINILAB attend pour ce format. Studio en fabrique un
                         d'après le rouleau (« 152x102 »), ce qui marche pour tout ce que la
                         boutique tire ; le champ existe pour les cas où la configuration de
                         la machine en attend un autre — c'est le seul paramètre du tirage
                         qui dépende d'elle, et donc le seul suspect quand elle refuse sans
                         rien dire. -->
                    <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource FieldLabel}"
                               Text="Nom du format au minilab"/>
                    <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="MinilabSizeNameBox" Style="{StaticResource FieldBox}" Width="180"/>
                        <TextBlock Style="{StaticResource Hint}" FontSize="15" MaxWidth="460"
                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,14"
                                   Text="Vide = Studio le déduit du rouleau chargé, ce qui convient presque toujours. À remplir seulement si le minilab refuse ce format sans donner de motif : essayez alors le nom de sa propre configuration (« A4 », « 21xL »…)."/>
                    </StackPanel>

                    <TextBlock Grid.Row="12" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Visible à la vente"/>
                    <CheckBox x:Name="EnabledCheck" Grid.Row="12" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="produit proposé dans les listes" Style="{StaticResource Texte}" FontSize="18"/>
                    </CheckBox>
                </Grid>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16" Margin="0,16,0,0">
            <DockPanel>
                <TextBlock x:Name="ErrorText" DockPanel.Dock="Left" FontSize="18"
                           Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource FlatButton}" MinWidth="150" Click="OnCancel">Annuler</Button>
                    <Button Style="{StaticResource BigButton}" Margin="12,0,0,0" Click="OnSave">✓ Enregistrer</Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
