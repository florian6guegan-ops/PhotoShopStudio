<UserControl x:Class="Studio.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="Paramètres"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel MaxWidth="880" HorizontalAlignment="Left">

                <TextBlock Text="Envoi des photos par courriel" Style="{StaticResource Texte}"
                           FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,14"
                           Text="Ces réglages sont propres à CE poste : ils vivent dans ses données, jamais dans le logiciel. Un nouveau poste opérateur se configure ici, sans rien recompiler."/>

                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20">
                    <StackPanel>

                        <CheckBox x:Name="ActifCheck" Margin="0,0,0,18"
                                  Checked="OnActifChanged" Unchecked="OnActifChanged">
                            <TextBlock Text="Activer l'envoi par courriel" Style="{StaticResource Texte}"
                                       FontSize="19"/>
                        </CheckBox>

                        <TextBlock Text="Adresse d'expédition" Style="{StaticResource Hint}"/>
                        <TextBox x:Name="ExpediteurBox" FontSize="20" Padding="12,10" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                                   Text="C'est aussi l'identifiant de connexion au serveur."/>

                        <TextBlock Text="Nom affiché chez le client" Style="{StaticResource Hint}"
                                   Margin="0,18,0,0"/>
                        <TextBox x:Name="NomBox" FontSize="20" Padding="12,10" Margin="0,6,0,0"/>

                        <TextBlock Text="Mot de passe d'application" Style="{StaticResource Hint}"
                                   Margin="0,18,0,0"/>
                        <PasswordBox x:Name="MotDePasseBox" FontSize="20" Padding="12,10" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                                   TextWrapping="Wrap"
                                   Text="Gmail refuse le mot de passe du compte depuis 2022. Il faut un mot de passe D'APPLICATION, créé sur le compte Google, validation en deux étapes activée."/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Serveur" Style="{StaticResource Hint}"/>
                                <TextBox x:Name="ServeurBox" FontSize="20" Padding="12,10" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Port" Style="{StaticResource Hint}"/>
                                <TextBox x:Name="PortBox" FontSize="20" Padding="12,10" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                                   Text="Gmail : smtp.gmail.com, port 587."/>

                        <TextBlock x:Name="EtatText" Style="{StaticResource Texte}" FontSize="17"
                                   Margin="0,18,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,14,0,0"
                           Text="Le tarif de l'envoi se règle au Catalogue, sur le produit « Envoi des photos par courriel »."/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource FlatButton}" MinWidth="140" Click="OnRetour">Retour</Button>
            <!-- L'essai AVANT l'enregistrement : une configuration fausse doit se découvrir
                 ici, et non devant un client. -->
            <Button x:Name="EssaiButton" Style="{StaticResource FlatButton}" MinWidth="280"
                    Margin="12,0,0,0" Click="OnEssai">✉  Envoyer un message d'essai</Button>
            <Button Style="{StaticResource BigButton}" Margin="12,0,0,0"
                    Click="OnEnregistrer">Enregistrer</Button>
        </StackPanel>
    </Grid>
</UserControl>
