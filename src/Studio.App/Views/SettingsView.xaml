<UserControl x:Class="Studio.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="Paramètres"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel MaxWidth="880" HorizontalAlignment="Left">

                <TextBlock Text="Envoi des photos par courriel" Style="{StaticResource Texte}"
                           FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,14"
                           Text="Ces réglages sont propres à CE poste : ils vivent dans ses données, jamais dans le logiciel. Un nouveau poste opérateur se configure ici, sans rien recompiler."/>

                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20">
                    <StackPanel>

                        <CheckBox x:Name="ActifCheck" Margin="0,0,0,18"
                                  Checked="OnActifChanged" Unchecked="OnActifChanged">
                            <TextBlock Text="Activer l'envoi par courriel" Style="{StaticResource Texte}"
                                       FontSize="19"/>
                        </CheckBox>

                        <TextBlock Text="Adresse d'expédition" Style="{StaticResource Hint}"/>
                        <TextBox x:Name="ExpediteurBox" FontSize="20" Padding="12,10" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                                   Text="C'est aussi l'identifiant de connexion au serveur."/>

                        <TextBlock Text="Nom affiché chez le client" Style="{StaticResource Hint}"
                                   Margin="0,18,0,0"/>
                        <TextBox x:Name="NomBox" FontSize="20" Padding="12,10" Margin="0,6,0,0"/>

                        <TextBlock Text="Mot de passe d'application" Style="{StaticResource Hint}"
                                   Margin="0,18,0,0"/>
                        <PasswordBox x:Name="MotDePasseBox" FontSize="20" Padding="12,10" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                                   TextWrapping="Wrap"
                                   Text="Gmail refuse le mot de passe du compte depuis 2022. Il faut un mot de passe D'APPLICATION, créé sur le compte Google, validation en deux étapes activée."/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Serveur" Style="{StaticResource Hint}"/>
                                <TextBox x:Name="ServeurBox" FontSize="20" Padding="12,10" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Port" Style="{StaticResource Hint}"/>
                                <TextBox x:Name="PortBox" FontSize="20" Padding="12,10" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                                   Text="Gmail : smtp.gmail.com, port 587."/>

                        <TextBlock x:Name="EtatText" Style="{StaticResource Texte}" FontSize="17"
                                   Margin="0,18,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <Button Style="{StaticResource FlatButton}" MinHeight="56" MinWidth="320"
                                FontSize="20" HorizontalAlignment="Left"
                                ToolTip="Les mots proposés dans une liste au moment d'envoyer les photos"
                                Click="OnMessagesPredefinis">✉  Messages prédéfinis…</Button>
                        <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Text="Cet écran enregistre à part : enregistrez d'abord les réglages ci-dessus si vous venez d'y toucher."/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,14,0,0"
                           Text="Le tarif de l'envoi se règle au Catalogue, sur le produit « Envoi des photos par courriel »."/>

                <!-- ===== Envoi par Dropbox ===== -->

                <TextBlock Text="Envoi des photos au client par Dropbox" Style="{StaticResource Texte}"
                           FontSize="24" FontWeight="SemiBold" Margin="0,28,0,10"/>

                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,14"
                           Text="Dropbox Transfer n'a pas d'API : rien ne permet d'en créer un depuis un programme. On passe donc par l'API Dropbox — gratuite, elle aussi — qui téléverse les photos dans un dossier daté et en crée un lien de partage. Le client reçoit un lien, sans avoir de compte à créer."/>

                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20">
                    <StackPanel>

                        <CheckBox x:Name="DropboxActifCheck" Margin="0,0,0,18"
                                  Checked="OnDropboxActifChanged" Unchecked="OnDropboxActifChanged">
                            <TextBlock Text="Activer l'envoi par Dropbox" Style="{StaticResource Texte}"
                                       FontSize="19"/>
                        </CheckBox>

                        <TextBlock Text="Clé de l'application (App key)" Style="{StaticResource Hint}"/>
                        <TextBox x:Name="DropboxAppKeyBox" FontSize="20" Padding="12,10" Margin="0,6,0,0"
                                 TextChanged="OnDropboxAppKeyChanged"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                                   TextWrapping="Wrap"
                                   Text="Elle se crée une seule fois sur dropbox.com/developers/apps : « Create app », accès « Scoped access », puis « App folder » (l'app n'aura accès qu'à son propre dossier). Dans l'onglet Permissions, cochez account_info.read, files.metadata.read, files.content.write, sharing.read et sharing.write, puis Submit AVANT de connecter le compte — une permission ajoutée après coup oblige à se reconnecter. Ce n'est pas un secret : il n'y a pas d'« app secret » à saisir ici."/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="DropboxConsoleButton" Style="{StaticResource FlatButton}"
                                    MinHeight="48" MinWidth="240" Click="OnDropboxConsole">🌐  Console Dropbox</Button>
                            <Button x:Name="DropboxConnecterButton" Style="{StaticResource FlatButton}"
                                    MinHeight="48" MinWidth="240" Margin="12,0,0,0"
                                    Click="OnDropboxConnecter">🔗  Connecter le compte</Button>
                        </StackPanel>

                        <!-- La recopie du code n'apparaît QU'APRÈS l'ouverture du navigateur :
                             une case à coller visible d'emblée ferait chercher un code que
                             personne n'a encore demandé. -->
                        <StackPanel x:Name="DropboxCodePanel" Visibility="Collapsed" Margin="0,16,0,0">
                            <TextBlock Text="Code d'autorisation donné par Dropbox"
                                       Style="{StaticResource Hint}"/>
                            <TextBox x:Name="DropboxCodeBox" FontSize="20" Padding="12,10" Margin="0,6,0,0"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                                       TextWrapping="Wrap"
                                       Text="Autorisez dans le navigateur, puis recopiez ici le code affiché. Il ne sert qu'une fois et n'est bon que quelques minutes."/>
                            <Button x:Name="DropboxValiderButton" Style="{StaticResource FlatButton}"
                                    MinHeight="48" MinWidth="240" HorizontalAlignment="Left"
                                    Margin="0,12,0,0" Click="OnDropboxValiderLeCode">Valider le code</Button>
                        </StackPanel>

                        <TextBlock Text="Dossier de dépôt dans le Dropbox du studio"
                                   Style="{StaticResource Hint}" Margin="0,18,0,0"/>
                        <TextBox x:Name="DropboxDossierBox" FontSize="20" Padding="12,10" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                                   Text="Chaque envoi y crée un sous-dossier daté."/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Expiration (jours)" Style="{StaticResource Hint}"/>
                                <TextBox x:Name="DropboxExpirationBox" FontSize="20" Padding="12,10"
                                         Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Mot de passe du lien (facultatif)"
                                           Style="{StaticResource Hint}"/>
                                <TextBox x:Name="DropboxMotDePasseBox" FontSize="20" Padding="12,10"
                                         Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                                   TextWrapping="Wrap"
                                   Text="0 jour = lien permanent. Attention : Dropbox réserve l'expiration ET le mot de passe aux comptes payants. Sur un compte gratuit il les refuse — l'envoi marche quand même, mais le lien sort permanent et ouvert."/>

                        <TextBlock Text="Supprimer les envois au bout de (jours)"
                                   Style="{StaticResource Hint}" Margin="0,18,0,0"/>
                        <TextBox x:Name="DropboxRetentionBox" FontSize="20" Padding="12,10"
                                 Margin="0,6,0,0" MaxWidth="180" HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                                   TextWrapping="Wrap"
                                   Text="Là, c'est une vraie suppression des fichiers, et elle marche sur un compte gratuit — c'est elle qui empêche le Dropbox de se remplir. Le ménage passe au démarrage de l'application et après chaque envoi ; il ne touche QUE les dossiers datés créés par Studio Photo, jamais ce que vous avez rangé à la main. Ce qui est supprimé reste 30 jours dans la corbeille Dropbox. 0 = ne jamais supprimer."/>

                        <TextBlock x:Name="DropboxEtatText" Style="{StaticResource Texte}" FontSize="17"
                                   Margin="0,18,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ===== Marque sur les planches identité ===== -->

                <TextBlock Text="Marque sur les planches d'identité" Style="{StaticResource Texte}"
                           FontSize="24" FontWeight="SemiBold" Margin="0,28,0,10"/>

                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,14"
                           Text="Ce que porte la bande, en bas de la planche : la date du tirage à gauche, la mention au centre, le code QR et le logo à droite."/>

                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20">
                    <StackPanel>

                        <CheckBox x:Name="MarqueActiveCheck" Margin="0,0,0,18"
                                  Checked="OnMarqueChanged" Unchecked="OnMarqueChanged">
                            <TextBlock Text="Imprimer la bande sur les planches"
                                       Style="{StaticResource Texte}" FontSize="19"/>
                        </CheckBox>

                        <TextBlock Text="Mention (deux lignes au plus)" Style="{StaticResource Hint}"/>
                        <TextBox x:Name="MarqueMentionBox" FontSize="18" Padding="12,10" Margin="0,6,0,0"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                                   TextWrapping="Wrap"
                                   Text="La première ligne est mise en avant, la seconde la précise. N'y mettez pas la Marianne ni le nom d'un prestataire agréé : le premier est l'emblème de l'État, le second appartient à qui l'a déposé."/>

                        <TextBlock Text="Logo (PNG à fond transparent)" Style="{StaticResource Hint}"
                                   Margin="0,18,0,0"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MarqueLogoBox" Grid.Column="0" FontSize="18" Padding="12,10"/>
                            <Button Grid.Column="1" Style="{StaticResource FlatButton}" MinHeight="48"
                                    MinWidth="140" Margin="12,0,0,0"
                                    Click="OnChoisirLeLogo">Parcourir…</Button>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                                   TextWrapping="Wrap"
                                   Text="Laissez vide pour ne rien poser. Un fond blanc se verrait sur le papier : préférez un PNG transparent."/>

                        <TextBlock Text="Code QR — ce qu'il encode" Style="{StaticResource Hint}"
                                   Margin="0,18,0,0"/>
                        <TextBox x:Name="MarqueQrBox" FontSize="18" Padding="12,10" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                                   TextWrapping="Wrap"
                                   Text="L'adresse du site de la boutique, une page d'avis, un contact. Laissez vide pour ne pas imprimer de code QR."/>

                        <TextBlock x:Name="MarqueEtatText" Style="{StaticResource Texte}" FontSize="17"
                                   Margin="0,18,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ===== Détourage du fond blanc ===== -->
                <!-- ===== Détourage du fond blanc =====
                     Le panneau vivait ICI, et nulle part ailleurs. Or les postes qui en ont
                     le plus besoin sont ceux qui ne font QUE de l'identité : ils tournent
                     sous Studio Photo Identité, qui n'a pas de Paramètres. Il est donc sorti
                     en écran à part (ReglagesDetourageView), que les deux logiciels ouvrent.
                     Voir Arcueil, 17/08/2026. -->

                <TextBlock Text="Détourage du fond blanc (photos d'identité)"
                           Style="{StaticResource Texte}"
                           FontSize="24" FontWeight="SemiBold" Margin="0,34,0,10"/>

                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="DetourageResumeText" Style="{StaticResource Hint}"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button Content="Détourage du fond blanc…" Click="OnOuvrirLeDetourage"
                                HorizontalAlignment="Left" Padding="18,10" FontSize="16"/>
                    </StackPanel>
                </Border>

                <!-- ===== WiFi du magasin =====
                     Le code QR de connexion s'affiche sur l'écran « téléphone », juste
                     avant celui qui sert à envoyer les photos : le second ne mène nulle
                     part tant que le client est sur son réseau mobile. Le réseau se
                     saisissait jusqu'ici dans config\wifi.json, à la main, fichier qu'il
                     fallait connaître — donc rien ne s'affichait sur les autres postes. -->

                <TextBlock Text="WiFi du magasin (code QR de connexion)" Style="{StaticResource Texte}"
                           FontSize="24" FontWeight="SemiBold" Margin="0,34,0,10"/>

                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,14"
                           Text="Le client scanne ce code pour rejoindre le réseau, puis le second code pour envoyer ses photos. Ce poste est branché en Ethernet : il n'a aucun profil WiFi à lire, le réseau doit donc être saisi ici. Laissé vide, Studio tentera de lire le profil de Windows — ce qui ne vaut que pour un portable."/>

                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Nom du réseau (SSID)" Style="{StaticResource Hint}"/>
                            <TextBox x:Name="WifiSsidBox" FontSize="20" Padding="12,10" Margin="0,6,0,0"
                                     TextChanged="OnWifiChanged"/>

                            <TextBlock Text="Clé du réseau" Style="{StaticResource Hint}" Margin="0,18,0,0"/>
                            <!-- En clair, et c'est voulu : c'est une clé qu'on donne aux
                                 clients, affichée au mur dans la plupart des boutiques.
                                 La masquer obligerait à la ressaisir en aveugle pour
                                 corriger une faute de frappe. -->
                            <TextBox x:Name="WifiCleBox" FontSize="20" Padding="12,10" Margin="0,6,0,0"
                                     TextChanged="OnWifiChanged"/>

                            <TextBlock Text="Sécurité" Style="{StaticResource Hint}" Margin="0,18,0,0"/>
                            <ComboBox x:Name="WifiSecuriteCombo" FontSize="18" Margin="0,6,0,0"
                                      HorizontalAlignment="Left" MinWidth="320"
                                      SelectionChanged="OnWifiChanged">
                                <ComboBoxItem Content="WPA / WPA2 / WPA3 (le cas courant)" IsSelected="True"/>
                                <ComboBoxItem Content="WEP (ancien)"/>
                                <ComboBoxItem Content="Réseau ouvert, sans clé"/>
                            </ComboBox>

                            <CheckBox x:Name="WifiMasqueCheck" Margin="0,18,0,0"
                                      Checked="OnWifiChanged" Unchecked="OnWifiChanged">
                                <TextBlock Text="Réseau à nom masqué" Style="{StaticResource Texte}"
                                           FontSize="18"/>
                            </CheckBox>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                                       TextWrapping="Wrap"
                                       Text="À cocher seulement si le réseau ne diffuse pas son nom : le téléphone doit le savoir pour s'y joindre."/>

                            <TextBlock x:Name="WifiEtatText" Style="{StaticResource Texte}" FontSize="17"
                                       Margin="0,18,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- L'aperçu vaut mieux qu'un message « enregistré » : on scanne
                             avec son propre téléphone, et on sait avant le premier client
                             si le code marche. -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <Border Background="White" CornerRadius="10" Padding="10">
                                <Image x:Name="WifiQrImage" Width="220" Height="220"/>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="240"
                                       Text="Scannez-le pour vérifier avant d'enregistrer."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Raccourcis photo d'identité =====
                     Ils étaient au Catalogue, avec les prix et les imprimantes. Mais ce
                     n'est pas un produit qu'on règle ici : c'est ce que l'écran identité
                     met en avant. L'opérateur les cherchait dans Paramètres. -->

                <TextBlock Text="Photos d'identité" Style="{StaticResource Texte}"
                           FontSize="24" FontWeight="SemiBold" Margin="0,34,0,10"/>

                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,14"
                           Text="Le référentiel compte 274 documents ; la boutique en tire deux toute la journée. Les raccourcis sont les tuiles mises devant, avant le reste du référentiel."/>

                <!-- LE CADRAGE AUTOMATIQUE. La case paraît DEUX FOIS — ici et dans les
                     réglages de Studio Photo Identité — mais elle écrit le MÊME réglage
                     (ReglagesIdentite.CadrageAutomatique), et la règle, elle, ne vit qu'à un
                     endroit. Les boutons se doublent, ce qu'ils font, non. -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <!-- ⚠ PAS le même réglage que « Poser le cadre sur le visage » plus
                             bas, sous « Cadrage des photos » : celui-là vaut pour les
                             TIRAGES et ne fait que déplacer le cadre. Celui-ci décide si
                             une PLANCHE D'IDENTITÉ s'ouvre déjà cadrée à la norme. -->
                        <CheckBox x:Name="CadrageIdentiteAutoCheck" Style="{StaticResource CaseCochable}"
                                  Content="Cadrer automatiquement d'après le visage"
                                  Click="OnCadrageIdentiteAutoChange"/>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Décoché, la photo s'ouvre sur un cadre centré, à placer à la main. La hauteur de tête reste mesurée et affichée, et le bouton « Cadrage automatique » de l'écran reste disponible quand on le veut."/>
                    </StackPanel>
                </Border>

                <!-- ===== Tarif des photos d'identité =====
                     Le prix d'une planche dépend du DOCUMENT et non du papier : c'est le
                     même produit du catalogue dans les deux cas. Voir TarifsIdentite. -->

                <TextBlock Text="Photos d'identité — tarif" Style="{StaticResource Texte}"
                           FontSize="24" FontWeight="SemiBold" Margin="0,34,0,10"/>

                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,14"
                           Text="Prix d'une planche, quel que soit le papier. Une norme étrangère demande de retrouver le gabarit du pays et de vérifier une hauteur de visage qu'on ne connaît pas par cœur : la boutique la facture plus cher."/>

                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,32,0">
                            <TextBlock Text="Document français" Style="{StaticResource Hint}"/>
                            <TextBox x:Name="TarifIdFranceBox" FontSize="20" Padding="12,10"
                                     Margin="0,6,0,0" MinWidth="140"
                                     TextChanged="OnTarifIdentiteChange"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Document étranger" Style="{StaticResource Hint}"/>
                            <TextBox x:Name="TarifIdEtrangerBox" FontSize="20" Padding="12,10"
                                     Margin="0,6,0,0" MinWidth="140"
                                     TextChanged="OnTarifIdentiteChange"/>
                        </StackPanel>
                        <TextBlock x:Name="TarifIdEtatText" Style="{StaticResource Hint}" FontSize="15"
                                   VerticalAlignment="Bottom" Margin="24,0,0,14" TextWrapping="Wrap"
                                   MaxWidth="420"/>
                    </StackPanel>
                </Border>

                <!-- ===== Dossiers favoris =====
                     Les photos d'un client arrivent par des chemins qui ne changent jamais :
                     le Bureau, les Téléchargements du navigateur, le dossier où l'on range
                     les envois WeTransfer. Les boîtes de Windows s'ouvraient sur « Ce PC »,
                     et il fallait redescendre l'arborescence à chaque fois devant le client. -->

                <TextBlock Text="Dossiers favoris" Style="{StaticResource Texte}"
                           FontSize="24" FontWeight="SemiBold" Margin="0,34,0,10"/>

                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,14"
                           Text="Ces dossiers sont épinglés dans TOUTES les boîtes « ouvrir un fichier » de Windows, et proposés en tuile sur l'écran « d'où viennent les photos ? ». Le Bureau et Téléchargements se trouvent tout seuls, où que Windows les range. Un dossier introuvable n'est simplement pas proposé."/>

                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <ItemsControl x:Name="FavorisList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding Actif}"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Click="OnFavoriChange"
                                                  ToolTip="Décochez pour le garder dans la liste sans le proposer."/>

                                        <TextBox Grid.Column="1" Text="{Binding Libelle, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="17" Padding="10,7" Margin="0,0,12,0"
                                                 VerticalAlignment="Center" TextChanged="OnFavoriChange"/>

                                        <!-- Où il mène VRAIMENT : un favori dont le chemin
                                             se devine (Bureau, Téléchargements) n'a rien à
                                             saisir, mais l'opérateur doit voir sur quoi il
                                             tombe — et lire « introuvable » plutôt que de le
                                             découvrir en cliquant. -->
                                        <TextBlock Grid.Column="2" Text="{Binding Etat}"
                                                   Foreground="{Binding EtatCouleur}" FontSize="15"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <Button Grid.Column="3" Style="{StaticResource FlatButton}"
                                                MinWidth="0" MinHeight="38" Padding="14,0" FontSize="14"
                                                Margin="0,0,8,0" Tag="{Binding}" Click="OnFavoriParcourir"
                                                ToolTip="Désigner le dossier à la main.">Parcourir…</Button>

                                        <Button Grid.Column="4" Style="{StaticResource FlatButton}"
                                                MinWidth="0" MinHeight="38" Padding="14,0" FontSize="14"
                                                Tag="{Binding}" Click="OnFavoriRetirer"
                                                ToolTip="Retirer ce favori de la liste.">Retirer</Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="40"
                                    Padding="16,0" FontSize="15" Margin="0,0,10,0"
                                    Click="OnFavoriAjouter">+  Ajouter un dossier</Button>
                            <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="40"
                                    Padding="16,0" FontSize="15" Click="OnFavorisParDefaut"
                                    ToolTip="Revenir à Bureau, Téléchargements et WeTransfer.">Remettre les trois par défaut</Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Ce qui dépend du POSTE et non de la boutique. Tout se détecte seul ;
                     ces réglages ne servent qu'à rattraper une installation que la
                     détection ne sait pas lire. C'est ce qui permet de donner
                     l'application à un collègue sans rien recompiler. -->
                <TextBlock Text="Matériel de ce poste" Style="{StaticResource Texte}"
                           FontSize="26" FontWeight="Bold" Margin="0,28,0,4"/>
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Studio trouve seul les bornes et les imprimantes. Ne remplissez ces cases que si ce qu'il a trouvé est faux : ce que vous mettez ici l'emporte."/>

                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Bornes (dossier de DiLand)" Style="{StaticResource Hint}"/>
                        <TextBlock x:Name="DiLandTrouveText" Style="{StaticResource Hint}"
                                   FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DiLandBox" Grid.Column="0" FontSize="18" Padding="12,10"/>
                            <Button Grid.Column="1" Style="{StaticResource FlatButton}" MinHeight="48"
                                    MinWidth="120" Margin="10,0,0,0" Click="OnParcourirDiLand"
                                    ToolTip="Choisir le dossier où DiLand est installé.">Parcourir…</Button>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Text="Le dossier d'installation de DiLand suffit — inutile de descendre jusqu'à « Data\AllUsersData\Repositories\Default »."/>

                        <TextBlock Text="Imprimantes reconnues" Style="{StaticResource Hint}"
                                   Margin="0,20,0,0"/>
                        <ItemsControl x:Name="ImprimantesList" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Border DockPanel.Dock="Left" CornerRadius="6" Padding="10,3"
                                                Margin="0,0,10,0" MinWidth="120"
                                                Background="{Binding RoleBrush}">
                                            <TextBlock Text="{Binding RoleTexte}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="White"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Detail}" FontSize="15"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Imprimante des agrandissements" Style="{StaticResource Hint}"
                                   Margin="0,20,0,0"/>
                        <ComboBox x:Name="GrandFormatCombo" FontSize="17" Margin="0,6,0,0"/>

                        <TextBlock Text="Imprimante à sublimation" Style="{StaticResource Hint}"
                                   Margin="0,16,0,0"/>
                        <ComboBox x:Name="SublimationCombo" FontSize="17" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Les supports proposés comme source de photos. La clef de DiLand est
                     branchée en permanence sur le poste de la boutique : elle porte sa
                     licence, jamais de photos, et elle s'affichait pourtant au milieu des
                     cartes clients. C'est un réglage de POSTE — chez un collègue ce sera un
                     autre volume, ou aucun. -->
                <TextBlock Text="Supports de photos" Style="{StaticResource Texte}"
                           FontSize="26" FontWeight="Bold" Margin="0,28,0,4"/>

                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="Cochez les supports à NE PAS proposer quand on choisit des photos. Un support coché reste accessible par « Parcourir » : il disparaît seulement des tuiles."/>

                        <ItemsControl x:Name="SupportsList" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Masque, Mode=TwoWay}"
                                              Checked="OnSupportChange" Unchecked="OnSupportChange"
                                              FontSize="17" Margin="0,4"
                                              Foreground="{DynamicResource TextBrush}"
                                              VerticalContentAlignment="Center"
                                              Content="{Binding Libelle}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="AucunSupportText" Style="{StaticResource Hint}"
                                   Margin="0,10,0,0" Visibility="Collapsed"
                                   Text="Aucun support branché pour le moment. Branchez la clef à masquer et revenez sur cet écran."/>
                    </StackPanel>
                </Border>

                <!-- Le cadrage. Un seul réglage pour l'instant, mais il change ce que
                     l'opérateur voit à l'ouverture de CHAQUE photo : il mérite son titre
                     plutôt que d'être glissé au milieu des imprimantes. -->
                <TextBlock Text="Cadrage des photos" Style="{StaticResource Texte}"
                           FontSize="26" FontWeight="Bold" Margin="0,28,0,4"/>

                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <CheckBox x:Name="CadrageAutoCheck" FontSize="18"
                                  Foreground="{DynamicResource TextBrush}"
                                  VerticalContentAlignment="Center"
                                  Content="Poser le cadre sur le visage"/>
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Text="À l'ouverture de « Modifier », le cadre se pose sur le visage trouvé au lieu du centre de la photo, le regard aux deux cinquièmes de la hauteur. Il ne fait que DÉPLACER le cadre : le format et le zoom ne changent pas, et un cadrage déjà choisi — celui d'une borne, ou celui que vous venez de régler — n'est jamais touché. Sans visage trouvé, la photo reste centrée comme avant."/>
                    </StackPanel>
                </Border>

                <!-- La mise à jour. On vérifie et on annonce ; on n'installe JAMAIS sans
                     que l'opérateur l'ait demandé — l'installation ferme l'application,
                     peut-être au milieu d'une commande. -->
                <TextBlock Text="Version et mises à jour" Style="{StaticResource Texte}"
                           FontSize="26" FontWeight="Bold" Margin="0,28,0,4"/>

                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                        Margin="0,8,0,20">
                    <StackPanel>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Texte}" FontSize="18"/>
                        <TextBlock x:Name="MajEtatText" Style="{StaticResource Hint}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="MajChercherButton" Style="{StaticResource FlatButton}"
                                    MinHeight="52" MinWidth="240" FontSize="17"
                                    Click="OnChercherUneMaj"
                                    ToolTip="Demande au dépôt s'il existe une version plus récente. Rien n'est installé.">
                                🔄  Chercher une mise à jour
                            </Button>
                            <Button x:Name="MajInstallerButton" Style="{StaticResource BigButton}"
                                    MinHeight="52" MinWidth="260" Margin="12,0,0,0"
                                    Click="OnInstallerLaMaj" Visibility="Collapsed"
                                    ToolTip="Télécharge et installe. L'application se ferme et se rouvre toute seule.">
                                ⬇  Installer et redémarrer
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Quand ça ne va pas. Rien ne part tout seul : c'est un geste, et le
                     rapport dit ce qu'il contient avant de partir. -->
                <TextBlock Text="Signaler un problème" Style="{StaticResource Texte}"
                           FontSize="26" FontWeight="Bold" Margin="0,28,0,4"/>
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Envoie les journaux de ce poste, ses réglages et son catalogue de produits à celui qui suit le logiciel, pour qu'il puisse comprendre la panne. Aucune photo de client n'est jointe, et les mots de passe ne le sont jamais."/>

                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Adresse où envoyer le rapport" Style="{StaticResource Hint}"/>
                        <TextBox x:Name="RapportAdresseBox" FontSize="18" Padding="12,10"
                                 Margin="0,6,0,0"/>

                        <TextBlock Text="Que s'est-il passé ?" Style="{StaticResource Hint}"
                                   Margin="0,16,0,0"/>
                        <TextBox x:Name="RapportNoteBox" FontSize="17" Padding="12,10"
                                 Margin="0,6,0,0" MinHeight="90"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Text="En une phrase : ce que vous faisiez, et ce qui s'est passé. C'est ce qui se lit en premier."/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="RapportEnvoyerButton" Style="{StaticResource FlatButton}"
                                    MinHeight="52" MinWidth="240" FontSize="17"
                                    Click="OnEnvoyerLeRapport"
                                    ToolTip="Fabrique le rapport et l'envoie par courriel.">
                                📤  Envoyer le rapport
                            </Button>
                            <Button x:Name="RapportEnregistrerButton" Style="{StaticResource FlatButton}"
                                    MinHeight="52" MinWidth="240" FontSize="17" Margin="12,0,0,0"
                                    Click="OnEnregistrerLeRapport"
                                    ToolTip="Écrit le rapport dans un fichier, à transmettre comme vous voulez. Utile quand le courriel ne marche pas.">
                                💾  Enregistrer le fichier…
                            </Button>
                        </StackPanel>

                        <TextBlock x:Name="RapportEtatText" Style="{StaticResource Hint}"
                                   TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <Button Style="{StaticResource FlatButton}" MinHeight="56" MinWidth="300"
                                FontSize="20" HorizontalAlignment="Left"
                                ToolTip="Choisir les formats mis en avant dans le module photo d'identité"
                                Click="OnIdShortcuts">🪪  Raccourcis identité…</Button>
                        <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Text="Cet écran enregistre à part : enregistrez d'abord les réglages ci-dessus si vous venez d'y toucher."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource FlatButton}" MinWidth="140" Click="OnRetour">Retour</Button>
            <!-- L'essai AVANT l'enregistrement : une configuration fausse doit se découvrir
                 ici, et non devant un client. -->
            <Button x:Name="EssaiButton" Style="{StaticResource FlatButton}" MinWidth="280"
                    Margin="12,0,0,0" Click="OnEssai">✉  Envoyer un message d'essai</Button>
            <Button Style="{StaticResource BigButton}" Margin="12,0,0,0"
                    Click="OnEnregistrer">Enregistrer</Button>
        </StackPanel>
    </Grid>
</UserControl>
