<UserControl x:Class="Studio.App.Views.IdDocumentPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sélectionnez un document" Style="{StaticResource PageTitle}"
                   HorizontalAlignment="Center"/>

        <!-- 274 documents : on tape deux lettres plutôt que de faire défiler -->
        <DockPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Left" Text="Rechercher :" Style="{StaticResource Hint}"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource Hint}"
                       VerticalAlignment="Center" Margin="16,0,0,0"/>
            <TextBox x:Name="SearchBox" FontSize="20" Padding="10,8" MaxWidth="520"
                     HorizontalAlignment="Left" MinWidth="360"
                     AutomationProperties.Name="Rechercher un document"
                     TextChanged="OnSearchChanged"/>
        </DockPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="DocumentsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="290" Height="150" Margin="8" Cursor="Hand"
                                Background="{StaticResource CardBrush}" BorderThickness="0"
                                AutomationProperties.Name="{Binding Titre}"
                                Click="OnDocumentChoisi" Tag="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="fond" Background="{TemplateBinding Background}"
                                            CornerRadius="12" BorderBrush="{StaticResource AccentBrush}"
                                            BorderThickness="2">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="fond" Property="Background"
                                                    Value="{StaticResource PanelBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="fond" Property="Background"
                                                    Value="{StaticResource AccentDarkBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>

                            <StackPanel Margin="12,0">
                                <TextBlock Text="{Binding Pays}" FontSize="21" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Document}" FontSize="15"
                                           Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,8"/>
                                <TextBlock Text="{Binding Cotes}" FontSize="17"
                                           Foreground="{StaticResource TitleBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Visage}" FontSize="13"
                                           Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Style="{StaticResource FlatButton}" MinWidth="200" Margin="0,0,12,0"
                    AutomationProperties.Name="Précédent" Click="OnBack">← Précédent</Button>
            <Button Style="{StaticResource FlatButton}" MinWidth="200"
                    AutomationProperties.Name="Annuler" Click="OnCancel">Annuler</Button>
        </StackPanel>
    </Grid>
</UserControl>
