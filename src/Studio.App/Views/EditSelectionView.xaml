<UserControl x:Class="Studio.App.Views.EditSelectionView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Studio.App.Controls"
             Focusable="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Left" Text="Modifier la sélection"
                       FontSize="34" Foreground="{DynamicResource TitleBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="HintText" DockPanel.Dock="Right" Style="{StaticResource Hint}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Ctrl+clic sur une vignette : la viser pour les réglages · C maintenue : recadrer à la souris sur la vignette · clic droit : pivoter le cadre · T puis molette : redresser"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Menu déroulant de la sélection : il ne quitte JAMAIS l'écran, quel que
                 soit l'outil en cours. C'est la demande de fond — voir la planche entière
                 pendant qu'on travaille, au lieu de défiler photo par photo. -->
            <Border Grid.Column="0" Width="560" Background="{DynamicResource CardBrush}" CornerRadius="12">
                <ScrollViewer x:Name="StripScroll" VerticalScrollBarVisibility="Auto" Padding="6">
                    <ItemsControl x:Name="Strip">
                        <!-- Deux colonnes : on voit deux fois plus de photos sans quitter
                             l'écran, ce qui est tout l'objet de cette bande. -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- De l'air TOUT AUTOUR, et pas seulement en dessous : les
                                     deux colonnes se touchaient, et le fond coloré d'une
                                     photo visée débordait sur sa voisine — on ne savait plus
                                     laquelle des deux était prise. -->
                                <Border Margin="5,5,5,9" CornerRadius="8" Padding="4"
                                        Background="{Binding CibleBrush}"
                                        PreviewMouseLeftButtonDown="OnStripDown"
                                        MouseLeftButtonUp="OnStripUp"
                                        MouseMove="OnStripMove"
                                        PreviewMouseWheel="OnStripWheel"
                                        PreviewMouseRightButtonUp="OnStripRightClick"
                                        Tag="{Binding}">
                                    <Grid Height="200">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                        <!-- Case à cocher VISIBLE : le Ctrl+clic faisait la
                                             même chose, mais rien ne l'annonçait et personne
                                             ne l'a trouvé. C'est par elle qu'on désigne les
                                             photos dont on va changer le format. -->
                                        <CheckBox HorizontalAlignment="Left" VerticalAlignment="Top"
                                                  Margin="6" IsChecked="{Binding Ciblee, Mode=TwoWay}"
                                                  Background="White" Focusable="False"
                                                  ToolTip="Cocher pour changer le format de cette photo"/>
                                        <Border Background="#CC000000" Padding="5,2"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="White"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                        </Border>
                                        <!-- Le format de CETTE photo, et le rapport de ses
                                             côtés. Sans eux, rien ne distingue à l'œil une
                                             10×15 d'une 15×20 dans la bande, et l'on ne voit
                                             pas non plus ce que le format va rogner. -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Top" Margin="0,2,2,0">
                                            <Border Background="#CC7E57C2" Padding="5,2" CornerRadius="4"
                                                    Margin="0,0,3,0" Visibility="{Binding BadgeVisibility}">
                                                <TextBlock Text="{Binding RatioLabel}" FontSize="11"
                                                           Foreground="White"/>
                                            </Border>
                                            <Border Background="#CC00897B" Padding="6,2" CornerRadius="4"
                                                    Visibility="{Binding FormatVisibility}">
                                                <TextBlock Text="{Binding FormatLabel}" FontSize="12"
                                                           FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                        <Border Background="#CC000000" Padding="6,2"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding QuantityLabel}" FontSize="15"
                                                       FontWeight="Bold" Foreground="{DynamicResource TitleBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- La surface de recadrage : le cadre y est FIXE, au format du tirage, et
                 c'est la photo qui coulisse derrière. On y voit donc aussi bien ce que le
                 tirage gardera que ce qu'il coupera. L'aperçu montrait auparavant une
                 image déjà composée : on déplaçait un cadrage qu'on ne voyait pas. -->
            <Border Grid.Column="1" Margin="12,0" Background="#263238" CornerRadius="12"
                    ClipToBounds="True">
                <Grid x:Name="Stage" Background="Transparent">
                    <controls:CropSurface x:Name="Surface"/>
                    <TextBlock x:Name="PreviewCaption" Foreground="White" FontSize="15"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18"
                               Background="#B3000000" Padding="10,5"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Panneau de l'outil : recadrage ou corrections. Il occupe la droite, la
                 sélection reste à gauche — les deux à l'écran, toujours. -->
            <Border Grid.Column="2" Width="330" Background="{DynamicResource CardBrush}"
                    CornerRadius="12" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Boutons sans le style FlatButton : sa largeur minimale de
                             220 px en imposait 440 à un panneau qui n'en fait que 330,
                             d'où les libellés rognés et le chevauchement. -->
                        <UniformGrid Columns="2" Margin="0,0,0,14" Height="48">
                            <Button x:Name="CropTab" FontSize="16" Margin="0,0,4,0"
                                    Click="OnShowCrop" Content="Recadrer"/>
                            <Button x:Name="CorrectTab" FontSize="16" Margin="4,0,0,0"
                                    Click="OnShowCorrect" Content="Corriger"/>
                        </UniformGrid>

                        <!-- Recadrage -->
                        <StackPanel x:Name="CropPanel">
                            <TextBlock Text="Recadrage" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Faites glisser dans l'aperçu pour déplacer le cadre, molette pour zoomer. Sur une vignette, maintenez C et faites de même."/>
                            <Button Style="{StaticResource FlatButton}" MinHeight="44" FontSize="15"
                                    Margin="0,0,0,8" Click="OnRotateFrame"
                                    Content="Pivoter le cadre   (clic droit)"/>
                            <!-- Ce bouton fait un QUART DE TOUR ; il annonçait « T + molette »,
                                 qui est le redressement fin — deux gestes différents sous
                                 un seul libellé. -->
                            <Button Style="{StaticResource FlatButton}" MinHeight="44" FontSize="15"
                                    Margin="0,0,0,8" Click="OnRotatePhoto"
                                    Content="Pivoter la photo   (quart de tour)"
                                    ToolTip="Pour redresser de quelques degrés : touche T, puis la molette."/>
                            <!-- Le libellé est posé par Refresh() : une liaison sur une
                                 propriété sans notification ne se relisait qu'au
                                 chargement, et le bouton mentait dès le premier clic. -->
                            <Button x:Name="FitButton" Style="{StaticResource FlatButton}"
                                    MinHeight="44" FontSize="15" Margin="0,0,0,8" Click="OnToggleFit"/>
                            <!-- Juste sous le bouton de mode : c'est là qu'on décide des marges
                                 blanches, donc là qu'on décide du repère de coupe. La case est
                                 grisée en « remplir le format », où il n'y a rien à recouper. -->
                            <CheckBox x:Name="CutBorderCheck" Style="{StaticResource CaseCochable}" FontSize="15" Margin="2,0,0,10"
                                      Foreground="{DynamicResource TextBrush}" VerticalContentAlignment="Center"
                                      Content="Contour de découpe"
                                      ToolTip="Trace un trait noir de 0,2 mm sur le bord de la photo, à suivre aux ciseaux quand le tirage sort avec des marges blanches."
                                      Click="OnCutBorderChanged"/>
                            <Button Style="{StaticResource FlatButton}" MinHeight="44" FontSize="15"
                                    Margin="0,0,0,8" Click="OnResetCrop" Content="Réinitialiser"/>
                            <Button Style="{StaticResource FlatButton}" MinHeight="44" FontSize="15"
                                    Click="OnCropToAll" Content="Appliquer à toute la sélection"/>
                        </StackPanel>

                        <!-- Corrections -->
                        <StackPanel x:Name="CorrectPanel" Visibility="Collapsed">
                            <!-- Sur quoi les corrections portent : sans cette ligne, on ne
                                 peut pas savoir si un bouton touche une photo ou trente. -->
                            <TextBlock x:Name="CorrectScopeText" Style="{StaticResource Hint}"
                                       TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <TextBlock Text="Noir et blanc" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,10"/>
                            <ToggleButton x:Name="GrayscaleToggle" Style="{StaticResource ToggleTile}"
                                          Margin="0,0,0,14" Click="OnGrayscaleChanged"
                                          Content="Noir et blanc"
                                          ToolTip="Convertit la photo en noir et blanc (Ctrl+W)"/>

                            <!-- Les yeux rouges sont à part, et pas au milieu des curseurs :
                                 aucun réglage ne les rattrape — c'est la rétine renvoyée par
                                 le flash — et la correction ne touche QUE les pupilles,
                                 trouvées par le détecteur de visages. -->
                            <TextBlock Text="Yeux rouges" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,10"/>
                            <ToggleButton x:Name="RedEyeToggle" Style="{StaticResource ToggleTile}"
                                          Margin="0,0,0,14" Click="OnRedEyeChanged"
                                          Content="Enlever les yeux rouges"
                                          ToolTip="Neutralise le rouge du flash au fond de l'œil. Ne touche qu'aux pupilles : une écharpe rouge ou une joue rosée ne risquent rien."/>

                            <TextBlock Text="Corrections automatiques" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,10"/>
                            <ToggleButton x:Name="AutoLevelsToggle" Style="{StaticResource ToggleTile}"
                                          Margin="0,0,0,6" Click="OnAutoChanged" Content="Niveaux"/>
                            <ToggleButton x:Name="AutoContrastToggle" Style="{StaticResource ToggleTile}"
                                          Margin="0,0,0,6" Click="OnAutoChanged" Content="Contraste automatique"/>
                            <ToggleButton x:Name="AutoColorToggle" Style="{StaticResource ToggleTile}"
                                          Margin="0,0,0,14" Click="OnAutoChanged" Content="Couleur automatique"/>

                            <TextBlock Text="Réglages" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="Sliders">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Nom}"
                                                           FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Affichage}"
                                                           FontSize="14" HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                            </DockPanel>
                                            <Slider Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                    Value="{Binding Valeur, Mode=TwoWay}"
                                                    IsMoveToPointEnabled="True"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- « Appliquer à toute la sélection » a disparu : tout le
                                 panneau porte désormais sur les photos cochées, ce bouton
                                 n'aurait plus rien fait de plus. -->
                            <Button Style="{StaticResource FlatButton}" MinHeight="44" FontSize="15"
                                    Margin="0,10,0,0" Click="OnResetAdjustments"
                                    Content="Annuler les corrections"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" CornerRadius="12"
                Padding="16" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SummaryText" Grid.Column="0" Style="{StaticResource Hint}"
                           FontSize="17" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Le format se choisit ici, à côté du retour et de l'impression :
                         il commande le tirage, pas le seul recadrage. -->
                    <Button x:Name="FormatButton" Style="{StaticResource FlatButton}"
                            MinHeight="56" Padding="22,0" FontSize="17" Margin="0,0,12,0"
                            Click="OnPickFormat"
                            ToolTip="Change le format du tirage pour les photos cochées"/>
                    <!-- Tirer la même photo dans DEUX formats : on la reproduit, et le
                         doublon reste coché pour qu'on lui donne son format aussitôt. -->
                    <Button x:Name="DupliquerButton" Style="{StaticResource FlatButton}"
                            MinHeight="56" Padding="22,0" FontSize="17" Margin="0,0,12,0"
                            Click="OnDupliquer"
                            ToolTip="Reproduit les photos cochées dans la commande, pour les tirer aussi dans un autre format.">
                        ⧉  Dupliquer
                    </Button>
                    <Button Style="{StaticResource FlatButton}" MinHeight="56" Padding="22,0"
                            FontSize="17" Margin="0,0,12,0" Click="OnBack">Retour à la sélection</Button>
                    <!-- On s'interrompt le plus souvent ICI : c'est l'écran où l'on passe
                         le plus de temps sur une commande. La commande part sur l'accueil,
                         sous « En attente », et se rouvre telle qu'on la laisse. -->
                    <Button x:Name="AttenteButton" Style="{StaticResource FlatButton}" MinHeight="56"
                            Padding="22,0" FontSize="17" Margin="0,0,12,0" Click="OnMettreEnAttente"
                            ToolTip="Mettre cette commande de côté pour servir quelqu'un d'autre. Vous la retrouverez sur l'accueil.">
                        ⏸  Mettre en attente
                    </Button>
                    <Button x:Name="PrintButton" Style="{StaticResource BigButton}" Click="OnPrint">
                        🖨  Imprimer
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
