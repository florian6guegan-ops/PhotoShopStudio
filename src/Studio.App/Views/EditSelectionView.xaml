<UserControl x:Class="Studio.App.Views.EditSelectionView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Left" Text="Modifier la sélection"
                       FontSize="34" Foreground="{StaticResource TitleBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="HintText" DockPanel.Dock="Right" Style="{StaticResource Hint}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="C maintenue : recadrer à la souris sur la vignette · clic droit : pivoter le cadre · T maintenue + molette : pivoter la photo"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Menu déroulant de la sélection : il ne quitte JAMAIS l'écran, quel que
                 soit l'outil en cours. C'est la demande de fond — voir la planche entière
                 pendant qu'on travaille, au lieu de défiler photo par photo. -->
            <Border Grid.Column="0" Width="560" Background="{StaticResource CardBrush}" CornerRadius="12">
                <ScrollViewer x:Name="StripScroll" VerticalScrollBarVisibility="Auto" Padding="8">
                    <ItemsControl x:Name="Strip">
                        <!-- Deux colonnes : on voit deux fois plus de photos sans quitter
                             l'écran, ce qui est tout l'objet de cette bande. -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" CornerRadius="8" Padding="4"
                                        Background="{Binding TileBrush}"
                                        PreviewMouseLeftButtonDown="OnStripDown"
                                        MouseLeftButtonUp="OnStripUp"
                                        MouseMove="OnStripMove"
                                        PreviewMouseWheel="OnStripWheel"
                                        PreviewMouseRightButtonUp="OnStripRightClick"
                                        Tag="{Binding}">
                                    <Grid Height="200">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                        <Border Background="#CC000000" Padding="5,2"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="White"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                        </Border>
                                        <Border Background="#CC000000" Padding="6,2"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding QuantityLabel}" FontSize="15"
                                                       FontWeight="Bold" Foreground="{StaticResource TitleBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Grand aperçu de la photo courante : recadrage et corrections s'y voient
                 en direct, et se répercutent dans le menu déroulant. -->
            <Border Grid.Column="1" Margin="12,0" Background="#263238" CornerRadius="12"
                    ClipToBounds="True"
                    MouseLeftButtonDown="OnPreviewDown" MouseLeftButtonUp="OnPreviewUp"
                    MouseMove="OnPreviewMove" MouseWheel="OnPreviewWheel"
                    MouseRightButtonUp="OnPreviewRightClick">
                <Grid x:Name="Stage" Background="Transparent">
                    <Image x:Name="Preview" Stretch="Uniform" Margin="10"/>
                    <TextBlock x:Name="PreviewCaption" Foreground="White" FontSize="15"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18"
                               Background="#B3000000" Padding="10,5"/>
                </Grid>
            </Border>

            <!-- Panneau de l'outil : recadrage ou corrections. Il occupe la droite, la
                 sélection reste à gauche — les deux à l'écran, toujours. -->
            <Border Grid.Column="2" Width="330" Background="{StaticResource CardBrush}"
                    CornerRadius="12" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Boutons sans le style FlatButton : sa largeur minimale de
                             220 px en imposait 440 à un panneau qui n'en fait que 330,
                             d'où les libellés rognés et le chevauchement. -->
                        <UniformGrid Columns="2" Margin="0,0,0,14" Height="48">
                            <Button x:Name="CropTab" FontSize="16" Margin="0,0,4,0"
                                    Click="OnShowCrop" Content="Recadrer"/>
                            <Button x:Name="CorrectTab" FontSize="16" Margin="4,0,0,0"
                                    Click="OnShowCorrect" Content="Corriger"/>
                        </UniformGrid>

                        <!-- Recadrage -->
                        <StackPanel x:Name="CropPanel">
                            <TextBlock Text="Recadrage" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource TitleBrush}" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Faites glisser dans l'aperçu pour déplacer le cadre, molette pour zoomer. Sur une vignette, maintenez C et faites de même."/>
                            <Button Style="{StaticResource FlatButton}" MinHeight="44" FontSize="15"
                                    Margin="0,0,0,8" Click="OnRotateFrame"
                                    Content="Pivoter le cadre   (clic droit)"/>
                            <Button Style="{StaticResource FlatButton}" MinHeight="44" FontSize="15"
                                    Margin="0,0,0,8" Click="OnRotatePhoto"
                                    Content="Pivoter la photo   (T + molette)"/>
                            <Button Style="{StaticResource FlatButton}" MinHeight="44" FontSize="15"
                                    Margin="0,0,0,8" Click="OnToggleFit"
                                    Content="{Binding FitLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Button Style="{StaticResource FlatButton}" MinHeight="44" FontSize="15"
                                    Margin="0,0,0,8" Click="OnResetCrop" Content="Réinitialiser"/>
                            <Button Style="{StaticResource FlatButton}" MinHeight="44" FontSize="15"
                                    Click="OnCropToAll" Content="Appliquer à toute la sélection"/>
                        </StackPanel>

                        <!-- Corrections -->
                        <StackPanel x:Name="CorrectPanel" Visibility="Collapsed">
                            <TextBlock Text="Corrections automatiques" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource TitleBrush}" Margin="0,0,0,10"/>
                            <ToggleButton x:Name="AutoLevelsToggle" MinHeight="44" FontSize="15"
                                          Margin="0,0,0,6" Click="OnAutoChanged" Content="Niveaux"/>
                            <ToggleButton x:Name="AutoContrastToggle" MinHeight="44" FontSize="15"
                                          Margin="0,0,0,6" Click="OnAutoChanged" Content="Contraste automatique"/>
                            <ToggleButton x:Name="AutoColorToggle" MinHeight="44" FontSize="15"
                                          Margin="0,0,0,14" Click="OnAutoChanged" Content="Couleur automatique"/>

                            <TextBlock Text="Réglages" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource TitleBrush}" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="Sliders">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Nom}"
                                                           FontSize="14" Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Affichage}"
                                                           FontSize="14" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource MutedBrush}"/>
                                            </DockPanel>
                                            <Slider Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                    Value="{Binding Valeur, Mode=TwoWay}"
                                                    IsMoveToPointEnabled="True"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Style="{StaticResource FlatButton}" MinHeight="44" FontSize="15"
                                    Margin="0,10,0,0" Click="OnResetAdjustments"
                                    Content="Annuler les corrections"/>
                            <Button Style="{StaticResource FlatButton}" MinHeight="44" FontSize="15"
                                    Margin="0,8,0,0" Click="OnCorrectToAll"
                                    Content="Appliquer à toute la sélection"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="12"
                Padding="16" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SummaryText" Grid.Column="0" Style="{StaticResource Hint}"
                           FontSize="17" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FlatButton}" MinHeight="56" Padding="22,0"
                            FontSize="17" Margin="0,0,12,0" Click="OnBack">Retour à la sélection</Button>
                    <Button x:Name="PrintButton" Style="{StaticResource BigButton}" Click="OnPrint">
                        🖨  Imprimer
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
