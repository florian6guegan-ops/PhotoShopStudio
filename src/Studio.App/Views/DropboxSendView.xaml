<UserControl x:Class="Studio.App.Views.DropboxSendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="Envoyer les photos au client"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel MaxWidth="880" HorizontalAlignment="Left">

                <!-- L'avertissement de configuration : visible seulement si l'envoi n'est
                     pas utilisable, et il dit alors quoi faire. -->
                <Border x:Name="AvertissementConfig" Visibility="Collapsed"
                        Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="AvertissementText" Style="{StaticResource Texte}"
                                   FontSize="18" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}"/>
                        <Button Style="{StaticResource FlatButton}" MinHeight="48" MinWidth="260"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                Click="OnOuvrirParametres">⚙  Ouvrir les Paramètres</Button>
                    </StackPanel>
                </Border>

                <!-- L'AVANCEMENT EN TÊTE, et non à sa place chronologique en bas de la page.
                     Placé après les réglages, il tombait sous la ligne de flottaison : sur
                     un écran de comptoir, l'opérateur cliquait « Envoyer » et ne voyait
                     plus rien bouger. La seule chose qui compte pendant trois minutes
                     d'attente doit être la première chose visible. -->
                <Border x:Name="AvancementCarte" Visibility="Collapsed"
                        Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="24"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- LE COMPTEUR ET LE POURCENTAGE EN GROS, sur une seule ligne :
                             ce sont les deux seuls chiffres qu'on lit pendant l'attente, et
                             on les lit de loin — debout derrière le comptoir, ou par-dessus
                             l'épaule du client. Le nom du fichier, lui, ne sert qu'à
                             constater que ça bouge encore : il passe en dessous, en petit. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="AvancementText" Grid.Column="0"
                                       Style="{StaticResource Texte}"
                                       FontSize="34" FontWeight="Bold" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="AvancementPourcent" Grid.Column="1"
                                       Style="{StaticResource Texte}"
                                       FontSize="34" FontWeight="Bold" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="16,0,0,0" Text="0 %"/>
                        </Grid>

                        <TextBlock x:Name="AvancementFichierText" Style="{StaticResource Hint}"
                                   FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"/>

                        <ProgressBar x:Name="AvancementBarre" Height="26" Margin="0,14,0,0"
                                     Minimum="0" Maximum="1"/>

                        <TextBlock x:Name="AvancementDetailText" Style="{StaticResource Hint}"
                                   FontSize="16" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- LE COURRIEL EST PARTI : en tête, en gros, et avec l'adresse écrite en
                     toutes lettres. C'est la dernière question du comptoir — « il l'a
                     reçu ? » — et la réponse tenait jusqu'ici dans une ligne de texte en
                     bas de page, sous le pli, que personne ne lisait. L'adresse est
                     RÉPÉTÉE parce que c'est le moment où l'on repère une faute de frappe,
                     pendant que le client est encore là. -->
                <Border x:Name="CourrielCarte" Visibility="Collapsed"
                        Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="24"
                        BorderThickness="2" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="CourrielTitreText" Style="{StaticResource Texte}"
                                   FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CourrielDetailText" Style="{StaticResource Hint}"
                                   FontSize="16" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Ce qui part : le choix se fait ICI et non à l'écran précédent, pour que
                     l'opérateur voie les deux comptes côte à côte avant de trancher. -->
                <Border x:Name="ChoixCarte" Background="{DynamicResource CardBrush}" CornerRadius="12"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Ce qui part" Style="{StaticResource Hint}"/>

                        <RadioButton x:Name="SelectionRadio" GroupName="Lot" FontSize="20"
                                     Margin="0,12,0,0" IsChecked="True" Checked="OnLotChange"/>
                        <RadioButton x:Name="DossierRadio" GroupName="Lot" FontSize="20"
                                     Margin="0,10,0,0" Checked="OnLotChange"/>

                        <TextBlock x:Name="VolumeText" Style="{StaticResource Hint}" FontSize="15"
                                   Margin="0,14,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ReglagesCarte" Background="{DynamicResource CardBrush}" CornerRadius="12"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Nom du dossier envoyé" Style="{StaticResource Hint}"/>
                        <TextBox x:Name="NomBox" FontSize="20" Padding="12,10" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                                   TextWrapping="Wrap"
                                   Text="La date est ajoutée devant. C'est ce nom que le client verra en tête de son téléchargement."/>

                        <!-- LE NOM DU CLIENT.
                             Le courriel disait « Bonjour, » tout court : le champ n'existait
                             pas et l'écran passait null. Or PhotoMailer sait écrire
                             « Bonjour Marie, » depuis toujours — il n'attendait qu'un nom.
                             C'est aussi lui qui remplace {nom} dans le mot prédéfini. -->
                        <TextBlock Text="Nom du client (facultatif)" Style="{StaticResource Hint}"
                                   Margin="0,20,0,0"/>
                        <TextBox x:Name="NomClientBox" FontSize="20" Padding="12,10" Margin="0,6,0,0"
                                 TextChanged="OnNomClientChanged"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                                   TextWrapping="Wrap"
                                   Text="Le courriel commencera par « Bonjour Marie, » au lieu de « Bonjour, ». Laissez vide pour la formule neutre."/>

                        <!-- L'adresse se prend MAINTENANT, pendant que le client est là :
                             c'est le même geste que « Prévenir à la fin » sur les tirages.
                             Le courriel part tout seul dès que le lien existe. -->
                        <TextBlock Text="Courriel du client (facultatif)" Style="{StaticResource Hint}"
                                   Margin="0,20,0,0"/>
                        <TextBox x:Name="AdresseBox" FontSize="20" Padding="12,10" Margin="0,6,0,0"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="OnAdresseChanged"
                                 LostFocus="OnAdressePerdLeFocus"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                                   TextWrapping="Wrap"
                                   Text="Le lien lui sera envoyé automatiquement dès qu'il sera prêt — y compris si vous saisissez l'adresse pendant que les photos montent. Plusieurs adresses : séparez-les par un point-virgule, une virgule ou un retour à la ligne — personne ne voit celle des autres. Laissez vide pour simplement copier le lien."/>
                        <TextBlock x:Name="AdressesText" Style="{StaticResource Texte}" FontSize="15"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="Mot pour le client (facultatif)" Style="{StaticResource Hint}"
                                   Margin="0,20,0,0"/>
                        <!-- Les mêmes mots prédéfinis que l'envoi par courriel, et le même
                             fichier : une boutique n'écrit pas différemment selon le tuyau
                             par lequel les photos partent. Ils REMPLISSENT la case, ils ne
                             la remplacent pas — le mot reste retouchable à la main. -->
                        <ComboBox x:Name="MessagesCombo" FontSize="17" Padding="10,8" Margin="0,6,0,0"
                                  DisplayMemberPath="Libelle"
                                  AutomationProperties.Name="Message prédéfini"
                                  SelectionChanged="OnMessagePredefini"/>
                        <TextBox x:Name="MotBox" FontSize="18" Padding="12,10" Margin="0,8,0,0"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="OnMotChanged"/>
                        <TextBlock x:Name="EtiquettesText" Style="{StaticResource Hint}" FontSize="13"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <!-- L'APERÇU, et non un texte d'explication.
                             Le mot n'est qu'un morceau : le courriel porte aussi la formule
                             d'appel, le compte de photos, le lien et la date limite. Décrire
                             tout ça en prose demanderait à l'opérateur de l'imaginer, alors
                             que le montrer ne coûte rien — c'est déjà ce que fait l'écran
                             d'envoi par courriel. -->
                        <!-- ⚠ Un bouton plat, et surtout PAS un Expander : il n'y en a nulle
                             part ailleurs dans l'application, donc aucun style ne le
                             couvrirait et son en-tête sortirait aux couleurs de Windows —
                             noir sur fond sombre. -->
                        <Button x:Name="ApercuButton" Style="{StaticResource FlatButton}"
                                MinWidth="0" MinHeight="44" Padding="14,0" FontSize="15"
                                HorizontalAlignment="Left" Margin="0,16,0,0"
                                Click="OnBasculerLApercu">✉  Voir le courriel du client</Button>

                        <Border x:Name="ApercuCarte" Visibility="Collapsed"
                                Background="{DynamicResource PanelBrush}" CornerRadius="8"
                                Padding="14" Margin="0,8,0,0">
                            <TextBlock x:Name="ApercuText" Style="{StaticResource Texte}"
                                       FontSize="15" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock x:Name="LienReglageText" Style="{StaticResource Hint}" FontSize="14"
                                   Margin="0,16,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Le résultat : le lien est SÉLECTIONNABLE, parce qu'un lien qu'on ne peut
                     pas copier ne sert à rien si le presse-papier a échoué. -->
                <Border x:Name="ResultatCarte" Visibility="Collapsed"
                        Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Lien à donner au client" Style="{StaticResource Hint}"/>
                        <TextBox x:Name="LienBox" FontSize="18" Padding="12,10" Margin="0,6,0,0"
                                 IsReadOnly="True" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ResultatDetailText" Style="{StaticResource Hint}" FontSize="14"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource FlatButton}" MinHeight="48" MinWidth="200"
                                    Click="OnCopierLeLien">📋  Copier le lien</Button>
                            <Button Style="{StaticResource FlatButton}" MinHeight="48" MinWidth="200"
                                    Margin="12,0,0,0" Click="OnOuvrirLeLien">🌐  Ouvrir</Button>
                            <!-- Rattrapage : le client donne son adresse APRÈS coup, ou le
                                 premier envoi a échoué. Le lien est déjà là, on ne
                                 retéléverse rien. -->
                            <Button x:Name="RenvoyerButton" Style="{StaticResource FlatButton}"
                                    MinHeight="48" MinWidth="240" Margin="12,0,0,0"
                                    Click="OnEnvoyerLeLien">✉  Envoyer par courriel</Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="EtatText" Style="{StaticResource Texte}" FontSize="18"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="RetourButton" Style="{StaticResource FlatButton}" MinWidth="140"
                    Click="OnRetour">Retour</Button>
            <Button x:Name="ArreterButton" Style="{StaticResource FlatButton}" MinWidth="160"
                    Margin="12,0,0,0" Visibility="Collapsed" Click="OnArreter">Arrêter</Button>
            <Button x:Name="EnvoyerButton" Style="{StaticResource BigButton}" Margin="12,0,0,0"
                    Click="OnEnvoyer">☁  Envoyer</Button>
        </StackPanel>
    </Grid>
</UserControl>
