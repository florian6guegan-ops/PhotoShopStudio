<UserControl x:Class="Studio.App.Views.DropboxSendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="Envoyer les photos au client"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel MaxWidth="880" HorizontalAlignment="Left">

                <!-- L'avertissement de configuration : visible seulement si l'envoi n'est
                     pas utilisable, et il dit alors quoi faire. -->
                <Border x:Name="AvertissementConfig" Visibility="Collapsed"
                        Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="AvertissementText" Style="{StaticResource Texte}"
                                   FontSize="18" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}"/>
                        <Button Style="{StaticResource FlatButton}" MinHeight="48" MinWidth="260"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                Click="OnOuvrirParametres">⚙  Ouvrir les Paramètres</Button>
                    </StackPanel>
                </Border>

                <!-- Ce qui part : le choix se fait ICI et non à l'écran précédent, pour que
                     l'opérateur voie les deux comptes côte à côte avant de trancher. -->
                <Border x:Name="ChoixCarte" Background="{DynamicResource CardBrush}" CornerRadius="12"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Ce qui part" Style="{StaticResource Hint}"/>

                        <RadioButton x:Name="SelectionRadio" GroupName="Lot" FontSize="20"
                                     Margin="0,12,0,0" IsChecked="True" Checked="OnLotChange"/>
                        <RadioButton x:Name="DossierRadio" GroupName="Lot" FontSize="20"
                                     Margin="0,10,0,0" Checked="OnLotChange"/>

                        <TextBlock x:Name="VolumeText" Style="{StaticResource Hint}" FontSize="15"
                                   Margin="0,14,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ReglagesCarte" Background="{DynamicResource CardBrush}" CornerRadius="12"
                        Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Nom du dossier envoyé" Style="{StaticResource Hint}"/>
                        <TextBox x:Name="NomBox" FontSize="20" Padding="12,10" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                                   TextWrapping="Wrap"
                                   Text="La date est ajoutée devant. C'est ce nom que le client verra en tête de son téléchargement."/>

                        <!-- L'adresse se prend MAINTENANT, pendant que le client est là :
                             c'est le même geste que « Prévenir à la fin » sur les tirages.
                             Le courriel part tout seul dès que le lien existe. -->
                        <TextBlock Text="Courriel du client (facultatif)" Style="{StaticResource Hint}"
                                   Margin="0,20,0,0"/>
                        <TextBox x:Name="AdresseBox" FontSize="20" Padding="12,10" Margin="0,6,0,0"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="OnAdresseChanged"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" FontSize="13"
                                   TextWrapping="Wrap"
                                   Text="Le lien lui sera envoyé automatiquement dès qu'il sera prêt. Plusieurs adresses : séparez-les par un point-virgule, une virgule ou un retour à la ligne — personne ne voit celle des autres. Laissez vide pour simplement copier le lien."/>
                        <TextBlock x:Name="AdressesText" Style="{StaticResource Texte}" FontSize="15"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="Mot pour le client (facultatif)" Style="{StaticResource Hint}"
                                   Margin="0,20,0,0"/>
                        <TextBox x:Name="MotBox" FontSize="18" Padding="12,10" Margin="0,6,0,0"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                 VerticalScrollBarVisibility="Auto"/>

                        <TextBlock x:Name="LienReglageText" Style="{StaticResource Hint}" FontSize="14"
                                   Margin="0,16,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- L'avancement remplace le choix pendant l'envoi : rien ne doit laisser
                     croire qu'on peut encore changer d'avis une fois les octets partis. -->
                <Border x:Name="AvancementCarte" Visibility="Collapsed"
                        Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock x:Name="AvancementText" Style="{StaticResource Texte}" FontSize="18"
                                   TextWrapping="Wrap"/>
                        <ProgressBar x:Name="AvancementBarre" Height="14" Margin="0,12,0,0"
                                     Minimum="0" Maximum="1"/>
                    </StackPanel>
                </Border>

                <!-- Le résultat : le lien est SÉLECTIONNABLE, parce qu'un lien qu'on ne peut
                     pas copier ne sert à rien si le presse-papier a échoué. -->
                <Border x:Name="ResultatCarte" Visibility="Collapsed"
                        Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Lien à donner au client" Style="{StaticResource Hint}"/>
                        <TextBox x:Name="LienBox" FontSize="18" Padding="12,10" Margin="0,6,0,0"
                                 IsReadOnly="True" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ResultatDetailText" Style="{StaticResource Hint}" FontSize="14"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource FlatButton}" MinHeight="48" MinWidth="200"
                                    Click="OnCopierLeLien">📋  Copier le lien</Button>
                            <Button Style="{StaticResource FlatButton}" MinHeight="48" MinWidth="200"
                                    Margin="12,0,0,0" Click="OnOuvrirLeLien">🌐  Ouvrir</Button>
                            <!-- Rattrapage : le client donne son adresse APRÈS coup, ou le
                                 premier envoi a échoué. Le lien est déjà là, on ne
                                 retéléverse rien. -->
                            <Button x:Name="RenvoyerButton" Style="{StaticResource FlatButton}"
                                    MinHeight="48" MinWidth="240" Margin="12,0,0,0"
                                    Click="OnEnvoyerLeLien">✉  Envoyer par courriel</Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="EtatText" Style="{StaticResource Texte}" FontSize="18"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="RetourButton" Style="{StaticResource FlatButton}" MinWidth="140"
                    Click="OnRetour">Retour</Button>
            <Button x:Name="ArreterButton" Style="{StaticResource FlatButton}" MinWidth="160"
                    Margin="12,0,0,0" Visibility="Collapsed" Click="OnArreter">Arrêter</Button>
            <Button x:Name="EnvoyerButton" Style="{StaticResource BigButton}" Margin="12,0,0,0"
                    Click="OnEnvoyer">☁  Envoyer</Button>
        </StackPanel>
    </Grid>
</UserControl>
