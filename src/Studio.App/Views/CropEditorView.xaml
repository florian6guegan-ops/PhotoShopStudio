<UserControl x:Class="Studio.App.Views.CropEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" DockPanel.Dock="Left" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="HintText" DockPanel.Dock="Right" Style="{StaticResource Hint}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Text="Faites glisser le cadre, zoomez à la molette ou au pincement"/>
        </DockPanel>

        <!-- Scène : la photo ENTIÈRE, à sa vraie clarté, et le cadre par-dessus. Ce qui
             tombe hors du cadrage n'est plus assombri : le voile empêchait de juger ce
             qu'on s'apprêtait à couper (demandé le 06/08/2026). -->
        <Border Grid.Row="1" Background="#263238" CornerRadius="12" ClipToBounds="True">
            <Grid x:Name="Stage" Background="Transparent"
                  MouseLeftButtonDown="OnStageMouseDown" MouseLeftButtonUp="OnStageMouseUp"
                  MouseMove="OnStageMouseMove" MouseWheel="OnStageWheel"
                  IsManipulationEnabled="True"
                  ManipulationStarting="OnManipulationStarting"
                  ManipulationDelta="OnManipulationDelta"
                  SizeChanged="OnStageSizeChanged">
                <!-- Le PAPIER, en mode « entier » : le rectangle blanc au format du
                     tirage, derrière la photo. C'est lui qui montre les marges — sans
                     lui, le mode annonçait des bords blancs par une phrase et affichait
                     la photo bord à bord, donc exactement ce qu'il ne ferait pas
                     (signalé le 01/08/2026). -->
                <Canvas x:Name="FondPapier" IsHitTestVisible="False">
                    <Rectangle x:Name="Papier" Fill="White" Visibility="Collapsed"/>
                </Canvas>

                <Image x:Name="Photo" Stretch="Uniform" Margin="0"/>
                <Canvas x:Name="Overlay" IsHitTestVisible="False">
                    <Rectangle x:Name="CropBorder" Stroke="White" StrokeThickness="3"/>
                </Canvas>
                <TextBlock x:Name="FitMessage" Visibility="Collapsed"
                           Foreground="White" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                           Text="Photo entière : le blanc autour, c'est la marge du papier."/>
            </Grid>
        </Border>

        <!-- Barre d'action.
             Grille et non DockPanel : dans un DockPanel, le groupe de gauche se sert en
             premier et peut ne rien laisser à « Valider », qui disparaît alors de
             l'écran — l'opérateur ne peut plus finir sa commande (constaté le
             01/08/2026). Ici la colonne « Auto » de droite est servie d'abord, donc
             Valider est toujours visible, et les outils de gauche passent à la ligne
             quand la fenêtre est trop étroite. -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FlatButton}" MinWidth="150" Margin="0,0,12,8" Click="OnRotate"
                            ToolTip="Fait pivoter la PHOTO d'un quart de tour (Ctrl+←, Ctrl+→)">⟳ Pivoter la photo</Button>
                    <Button x:Name="FrameToggle" Style="{StaticResource FlatButton}" MinWidth="200"
                            Margin="0,0,12,8" Click="OnToggleFrame"
                            ToolTip="Bascule le CADRE entre portrait et paysage, sans toucher à la photo"/>
                    <Button x:Name="FitToggle" Style="{StaticResource FlatButton}" MinWidth="180"
                            Margin="0,0,12,8" Click="OnToggleFit"/>
                    <Button Style="{StaticResource FlatButton}" MinWidth="90" Margin="12,0,12,8"
                            FontSize="30" Click="OnZoomOut" ToolTip="Dézoomer">−</Button>
                    <Button Style="{StaticResource FlatButton}" MinWidth="90" Margin="0,0,12,8"
                            FontSize="30" Click="OnZoomIn" ToolTip="Zoomer (Z)">+</Button>
                    <Button Style="{StaticResource FlatButton}" MinWidth="170" Margin="12,0,0,8"
                            Click="OnReset" ToolTip="Annule le recadrage (R)">Réinitialiser</Button>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Style="{StaticResource FlatButton}" MinWidth="150" Click="OnCancel">Annuler</Button>
                    <Button Style="{StaticResource BigButton}" Margin="12,0,0,0" Click="OnApply"
                            ToolTip="Valide le recadrage (Ctrl+I)">✓ Valider</Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
