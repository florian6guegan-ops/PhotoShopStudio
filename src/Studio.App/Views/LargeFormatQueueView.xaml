<UserControl x:Class="Studio.App.Views.LargeFormatQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Style="{StaticResource PageTitle}"
                   Text="Agrandissements à tirer"/>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Style="{StaticResource Hint}"
                   VerticalAlignment="Top" Margin="0,20,0,0"
                   Text="Aucun agrandissement en attente. Les tirages au-delà du 21×29,7 apparaissent ici une fois la commande préparée."
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GroupsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Header}" FontSize="19" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SubHeader}" FontSize="14"
                                                   Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Marquer comme tirée" Padding="14,8"
                                            FontSize="14" VerticalAlignment="Top"
                                            Click="OnConfirmPrinted" Tag="{Binding}"
                                            ToolTip="À faire une fois les tirages sortis de l'Epson."/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Files}" Margin="0,14,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0" Source="{Binding Thumbnail}"
                                                           Width="72" Height="72" Stretch="Uniform"
                                                           Margin="0,0,16,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ProductLabel}" FontSize="16"
                                                                   Foreground="{StaticResource TextBrush}"/>
                                                        <TextBlock Text="{Binding FileLabel}" FontSize="13"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="Tirer sur l'Epson…"
                                                            Padding="18,10" FontSize="15" VerticalAlignment="Center"
                                                            Click="OnPrintFile" Tag="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
