<UserControl x:Class="Studio.App.Views.IdSheetRecapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" DockPanel.Dock="Left" Style="{StaticResource PageTitle}"
                       FontSize="26" Margin="0,0,0,8" Text="Récapitulatif des planches"/>
            <TextBlock x:Name="TotalText" DockPanel.Dock="Right" Style="{StaticResource Valeur}"
                       FontSize="19" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- La planche telle qu'elle sortira, fond blanc compris : c'est le dernier
             regard avant le papier, et la feuille doit se voir comme une feuille. -->
        <Border Grid.Row="1" Background="{DynamicResource SceneBrush}" CornerRadius="12" Margin="0,8,0,0"
                ClipToBounds="True">
            <Grid>
                <!-- L'image REMPLIT la place disponible (Stretch="Uniform" dans une grille,
                     sans alignement central) : posée à sa taille naturelle, une planche
                     rendue à 150 ppp s'affichait deux fois trop petite pour qu'on y juge
                     quoi que ce soit — c'est pourtant le seul but de cet écran. -->
                <Image x:Name="Feuille" Stretch="Uniform" Margin="16"/>
                <TextBlock x:Name="EtatText" Foreground="White" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="Préparation des planches…"/>
            </Grid>
        </Border>

        <!-- ===== UNE seule barre, et non plus deux =====

             Pagination, quantité et actions occupaient DEUX cartes empilées, quatre rangées
             de boutons de 52 à 76 px : près de trois cents pixels de commandes sous une
             planche qu'on est venu REGARDER, et qu'il fallait juger sur le tiers d'écran
             qui restait. Rien n'a été retiré ; tout tient sur une ligne qui se replie, et
             la feuille récupère la place (06/08/2026).

             Grille et non DockPanel : la colonne de droite est servie d'abord, donc
             « Imprimer » reste visible quelle que soit la largeur de la fenêtre. -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" CornerRadius="12"
                Padding="12,10" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- Chevrons plutôt que les symboles de magnétophone : « ⏮ » et « ⏭ »
                         n'existent pas dans toutes les polices et sortaient en carrés. -->
                    <Button x:Name="PremiereButton" Style="{StaticResource FlatButton}" MinWidth="44"
                            MinHeight="42" FontSize="19" Padding="0" Margin="0,0,0,4"
                            Click="OnPremiere" ToolTip="Première planche">«</Button>
                    <Button x:Name="PrecedenteButton" Style="{StaticResource FlatButton}" MinWidth="44"
                            MinHeight="42" FontSize="19" Padding="0" Margin="6,0,0,4"
                            Click="OnPrecedente" ToolTip="Planche précédente">‹</Button>
                    <TextBlock x:Name="PageText" Style="{StaticResource Valeur}" FontSize="17"
                               MinWidth="180" TextAlignment="Center"
                               VerticalAlignment="Center" Margin="8,0,8,4"/>
                    <Button x:Name="SuivanteButton" Style="{StaticResource FlatButton}" MinWidth="44"
                            MinHeight="42" FontSize="19" Padding="0" Margin="0,0,6,4"
                            Click="OnSuivante" ToolTip="Planche suivante">›</Button>
                    <Button x:Name="DerniereButton" Style="{StaticResource FlatButton}" MinWidth="44"
                            MinHeight="42" FontSize="19" Padding="0" Margin="0,0,18,4"
                            Click="OnDerniere" ToolTip="Dernière planche">»</Button>

                    <TextBlock Text="quantité" Style="{StaticResource Hint}" FontSize="15"
                               VerticalAlignment="Center" Margin="0,0,8,4"
                               ToolTip="Nombre de planches identiques pour CETTE photo"/>
                    <Button Style="{StaticResource FlatButton}" MinWidth="42" MinHeight="42" Padding="0"
                            FontSize="19" Margin="0,0,0,4" Click="OnQuantiteMoins">−</Button>
                    <TextBlock x:Name="QuantiteText" Style="{StaticResource Valeur}" FontSize="19"
                               MinWidth="42" TextAlignment="Center" Margin="0,0,0,4"/>
                    <Button Style="{StaticResource FlatButton}" MinWidth="42" MinHeight="42" Padding="0"
                            FontSize="19" Margin="0,0,18,4" Click="OnQuantitePlus">+</Button>

                    <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="42"
                            Padding="14,0" FontSize="15" Margin="0,0,8,4" Click="OnModifierLaPhoto"
                            ToolTip="Revenir au cadrage de cette photo">Modifier la photo</Button>
                    <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="42"
                            Padding="14,0" FontSize="15" Margin="0,0,14,4" Click="OnRemplacerLaPhoto"
                            ToolTip="Revenir au choix des photos">Remplacer la photo</Button>

                    <TextBlock x:Name="DetailText" Style="{StaticResource Hint}" FontSize="14"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                               Margin="0,0,0,4"/>

                    <!-- Le détourage a changé de méthode en cours de route. Ce n'est pas une
                         erreur — la planche est bonne — mais son fond est moins fin que celui
                         vu au cadrage, et l'opérateur doit l'apprendre ICI plutôt que devant
                         le client. Masqué tant qu'il n'y a rien à dire. -->
                    <TextBlock x:Name="RepliDetourageText" Style="{StaticResource Hint}" FontSize="14"
                               Foreground="{DynamicResource TitleBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                               Margin="12,0,0,4" Visibility="Collapsed"/>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="46"
                            Padding="16,0" FontSize="15" Click="OnRetour">← Précédent</Button>
                    <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="46"
                            Padding="16,0" FontSize="15" Margin="8,0,0,0"
                            Click="OnAnnuler">✕ Annuler</Button>
                    <Button x:Name="ImprimerButton" Style="{StaticResource BigButton}" MinWidth="180"
                            MinHeight="52" FontSize="20" Padding="18,8" Margin="10,0,0,0"
                            Click="OnImprimer">🖨  Imprimer</Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
