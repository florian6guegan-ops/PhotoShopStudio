<UserControl x:Class="Studio.App.Views.MailMessagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}"
                   Text="Messages prédéfinis (envoi par courriel)"/>

        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Margin="0,0,0,16" TextWrapping="Wrap"
                   Text="Ces mots se choisissent dans une liste au moment de l'envoi, et remplissent la case « Mot pour le client ». Ils restent retouchables à ce moment-là : le nom du client s'y ajoute en deux mots."/>

        <!-- Saisie : un intitulé court, qu'on lit dans la liste déroulante, et le mot lui-même -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="12"
                Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource Hint}"
                           Text="Intitulé — ce qu'on lit dans la liste au moment d'envoyer"/>
                <TextBox x:Name="LibelleBox" Grid.Row="1" FontSize="19" Padding="12,10" Margin="0,6,0,12"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource Hint}" Text="Le message"/>
                        <TextBox x:Name="TexteBox" FontSize="17" Padding="12,10" Margin="0,6,0,0"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <Button x:Name="AjouterButton" Grid.Column="1" Style="{StaticResource FlatButton}"
                            MinWidth="220" MinHeight="48" FontSize="18" VerticalAlignment="Bottom"
                            Click="OnAjouter">➕ Ajouter</Button>
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MessagesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12"
                                Padding="16" Margin="0,0,0,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Style="{StaticResource FlatButton}" MinHeight="48" MinWidth="60"
                                            FontSize="18" Padding="12,6" ToolTip="Monter"
                                            Click="OnMonter" Tag="{Binding}">↑</Button>
                                    <Button Style="{StaticResource FlatButton}" Margin="8,0,0,0"
                                            MinHeight="48" MinWidth="60" FontSize="18" Padding="12,6"
                                            ToolTip="Descendre"
                                            Click="OnDescendre" Tag="{Binding}">↓</Button>
                                    <Button Style="{StaticResource FlatButton}" Margin="8,0,0,0"
                                            MinHeight="48" MinWidth="110" FontSize="18" Padding="12,6"
                                            ToolTip="Reprendre ce message dans la saisie ci-dessus"
                                            Click="OnModifier" Tag="{Binding}">✏ Modifier</Button>
                                    <Button Style="{StaticResource FlatButton}" Margin="8,0,0,0"
                                            MinHeight="48" MinWidth="70" FontSize="18" Padding="12,6"
                                            Foreground="{StaticResource DangerBrush}"
                                            ToolTip="Retirer ce message"
                                            Click="OnRetirer" Tag="{Binding}">🗑</Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="21" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               Text="{Binding Libelle}"/>
                                    <TextBlock FontSize="16" Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="{Binding Apercu}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock x:Name="MessageText" Style="{StaticResource Hint}" VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource FlatButton}" MinWidth="180" Margin="0,0,12,0"
                        Click="OnDefauts">Remettre par défaut</Button>
                <Button Style="{StaticResource FlatButton}" MinWidth="160" Margin="0,0,12,0"
                        Click="OnRetour">← Retour</Button>
                <Button Style="{StaticResource BigButton}" MinWidth="220"
                        Click="OnEnregistrer">Enregistrer</Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
