<UserControl x:Class="Studio.App.Views.ReglagesIdentiteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="Réglages"/>

        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Margin="0,0,0,16" TextWrapping="Wrap"
                   Text="D'où viennent les photos, et par quel compte elles partent chez le client."/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <StackPanel>

            <!-- D'OÙ VIENNENT LES PHOTOS.
                 Par défaut la carte mémoire, trouvée toute seule : au comptoir, le client
                 tend sa carte, on l'insère, on ouvre. Un dossier fixe ne sert qu'au poste
                 où les photos arrivent toujours au même endroit. -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Texte}" FontSize="19" FontWeight="SemiBold"
                               Text="Les photos"/>
                    <RadioButton x:Name="CarteRadio" GroupName="Source" FontSize="17" Margin="0,12,0,0"
                                 Checked="OnSourceChanged"
                                 Content="La carte mémoire, trouvée toute seule"/>
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="26,2,0,0"
                               Text="Le cas du comptoir : on insère la carte du client et on ouvre."/>
                    <RadioButton x:Name="DossierRadio" GroupName="Source" FontSize="17" Margin="0,12,0,0"
                                 Checked="OnSourceChanged"
                                 Content="Toujours ce dossier"/>
                    <Grid Margin="26,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DossierBox" Grid.Column="0" FontSize="16" Padding="10,8"/>
                        <Button x:Name="ParcourirButton" Grid.Column="1" Style="{StaticResource FlatButton}"
                                MinWidth="140" MinHeight="44" FontSize="15" Margin="10,0,0,0"
                                Click="OnParcourir">Parcourir…</Button>
                    </Grid>
                    <TextBlock x:Name="SourceEtatText" Style="{StaticResource Hint}" FontSize="13"
                               Margin="26,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- LES FORMATS MIS EN AVANT.
                 L'écran existait — c'est celui du Catalogue du Studio complet — mais AUCUN
                 chemin n'y menait depuis Studio Photo Identité, qui n'a pas de Catalogue.
                 Sur le poste identité, c'est pourtant le seul réglage qu'on veuille changer
                 avec la saison. Signalé le 17/08/2026. -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Texte}" FontSize="19" FontWeight="SemiBold"
                               Text="Les formats"/>
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="Les formats qui s'affichent en grand quand on change de document : la norme française, la planche de 6, l'E-Photo… Les 274 autres restent derrière « Autres formats… »."/>
                    <Button Style="{StaticResource FlatButton}" MinWidth="300" MinHeight="46"
                            FontSize="16" HorizontalAlignment="Left" Margin="0,12,0,0"
                            Click="OnFormats">Choisir les formats mis en avant…</Button>
                </StackPanel>
            </Border>

            <!-- LE CADRAGE AUTOMATIQUE. La détection continue de tourner quand il est
                 décoché — elle pose les repères, donc le contrôle de conformité ; c'est le
                 PLACEMENT du cadre qu'on laisse à l'opérateur. -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Texte}" FontSize="19" FontWeight="SemiBold"
                               Text="Le cadrage"/>
                    <!-- ⚠ ENREGISTRÉE AU CLIC, comme le mode sombre juste en dessous.
                         Livrée d'abord en attente du bouton « Enregistrer » du bas, elle
                         donnait un réglage qui paraissait pris et ne l'était pas : on
                         décoche, on revient à l'écran, et la photo se cadre encore. -->
                    <CheckBox x:Name="CadrageAutoCheck" Style="{StaticResource CaseCochable}"
                              Margin="0,12,0,0" Click="OnCadrageAuto">
                        <TextBlock Text="Cadrer automatiquement d'après le visage"
                                   Style="{StaticResource Texte}" FontSize="16"/>
                    </CheckBox>
                    <TextBlock x:Name="CadrageAutoEtatText" Style="{StaticResource Texte}"
                               FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="Décoché, la photo s'ouvre sur un cadre centré, à placer à la main. La hauteur de tête reste mesurée et affichée, et le bouton « Cadrage automatique » de l'écran reste disponible quand on le veut."/>
                </StackPanel>
            </Border>

            <!-- LE DÉTOURAGE DU FOND BLANC.
                 Il ne se réglait QUE dans les Paramètres du Studio complet, que ce
                 logiciel-ci n'a pas — si bien qu'un poste qui ne fait que de l'identité ne
                 pouvait pas allumer le réseau de neurones. Arcueil a tourné des jours sur la
                 découpe par couleur, qui renonce dès que le fond n'est pas uni, et
                 l'exploitant a signalé le 17/08/2026 que « le détourage ne marche pas ».
                 C'est le MÊME écran que celui des Paramètres, pas une copie. -->
            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Texte}" FontSize="19" FontWeight="SemiBold"
                               Text="Le fond blanc"/>
                    <TextBlock x:Name="DetourageResumeText" Style="{StaticResource Hint}"
                               FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <Button Style="{StaticResource FlatButton}" MinWidth="300" MinHeight="46"
                            FontSize="16" HorizontalAlignment="Left" Margin="0,12,0,0"
                            Click="OnDetourage">Méthode et modèle de détourage…</Button>
                </StackPanel>
            </Border>

            <!-- L'HABILLAGE. Ne paraît que là où il veut dire quelque chose : le Studio
                 complet n'a qu'une palette, ce poste-ci en a deux. -->
            <Border x:Name="HabillagePanel" Visibility="Collapsed"
                    Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Texte}" FontSize="19" FontWeight="SemiBold"
                               Text="L'écran"/>
                    <CheckBox x:Name="SombreCheck" Style="{StaticResource CaseCochable}"
                              Margin="0,12,0,0" Click="OnModeSombre">
                        <TextBlock Text="Mode sombre" Style="{StaticResource Texte}" FontSize="16"/>
                    </CheckBox>
                    <TextBlock Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="Le changement est immédiat : la case se coche, l'écran suit. Utile à contre-jour ou en fin de journée."/>
                </StackPanel>
            </Border>

            <!-- LA MISE À JOUR. Ne paraît que dans Studio Photo Identité : le Studio complet
                 a la sienne, dans Paramètres, et sur une autre suite de publications. -->
            <Border x:Name="MajPanel" Visibility="Collapsed"
                    Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Texte}" FontSize="19" FontWeight="SemiBold"
                               Text="Mise à jour"/>
                    <TextBlock x:Name="MajVersionText" Style="{StaticResource Hint}" FontSize="13"
                               Margin="0,4,0,0"/>
                    <TextBlock x:Name="MajEtatText" Style="{StaticResource Texte}" FontSize="15"
                               Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="MajChercherButton" Style="{StaticResource FlatButton}"
                                MinWidth="220" MinHeight="46" FontSize="16"
                                Click="OnChercherLaMaj">Chercher une mise à jour</Button>
                        <Button x:Name="MajInstallerButton" Style="{StaticResource BigButton}"
                                MinWidth="200" MinHeight="46" FontSize="16" Margin="12,0,0,0"
                                Visibility="Collapsed" Click="OnInstallerLaMaj">Installer</Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,8" TextWrapping="Wrap"
                       Text="Le compte qui envoie les photos aux clients. Avec Gmail, il faut un mot de passe D'APPLICATION — pas celui du compte : Google refuse le mot de passe ordinaire pour l'envoi. Il se crée sur le compte Google, validation en deux étapes activée."/>

            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Texte}" FontSize="19"
                               VerticalAlignment="Center" Margin="0,0,18,12" Text="Adresse qui envoie"/>
                    <TextBox x:Name="ExpediteurBox" Grid.Row="0" Grid.Column="1" FontSize="20"
                             Padding="12,10" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Texte}" FontSize="19"
                               VerticalAlignment="Center" Margin="0,0,18,12" Text="Mot de passe d'application"/>
                    <PasswordBox x:Name="MotDePasseBox" Grid.Row="1" Grid.Column="1" FontSize="20"
                                 Padding="12,10" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Texte}" FontSize="19"
                               VerticalAlignment="Center" Margin="0,0,18,12" Text="Nom affiché chez le client"/>
                    <TextBox x:Name="NomBox" Grid.Row="2" Grid.Column="1" FontSize="20"
                             Padding="12,10" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Texte}" FontSize="19"
                               VerticalAlignment="Center" Margin="0,0,18,12" Text="Serveur"/>
                    <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ServeurBox" Grid.Column="0" FontSize="20" Padding="12,10"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Texte}" FontSize="19"
                                   VerticalAlignment="Center" Margin="18,0,10,0" Text="Port"/>
                        <TextBox x:Name="PortBox" Grid.Column="2" FontSize="20" Padding="12,10" MinWidth="110"/>
                    </Grid>

                    <CheckBox x:Name="ActifCheck" Grid.Row="4" Grid.Column="1" FontSize="19"
                              Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0"
                              Click="OnActifChanged"
                              Content="Envoi par courriel actif"/>

                    <TextBlock x:Name="EtatText" Grid.Row="5" Grid.Column="1" Style="{StaticResource Texte}"
                               FontSize="18" TextWrapping="Wrap" Margin="0,16,0,0"/>
                </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Style="{StaticResource Hint}" Margin="0,14,0,0" TextWrapping="Wrap"
                   Text="Les mots joints aux photos se règlent dans le Studio complet (Paramètres → Messages prédéfinis)."/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource FlatButton}" MinWidth="180" MinHeight="52" FontSize="19"
                    Click="OnRetour">Retour</Button>
            <Button x:Name="EssaiButton" Style="{StaticResource FlatButton}" MinWidth="220" MinHeight="52"
                    FontSize="19" Margin="12,0,0,0" Click="OnEssai">Essai d'envoi</Button>
            <Button Style="{StaticResource BigButton}" MinWidth="240" MinHeight="52" FontSize="19"
                    Margin="12,0,0,0" Click="OnEnregistrer">Enregistrer</Button>
        </StackPanel>
    </Grid>
</UserControl>
