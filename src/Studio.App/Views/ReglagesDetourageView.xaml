<UserControl x:Class="Studio.App.Views.ReglagesDetourageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}"
                   Text="Détourage du fond blanc"/>

        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="Deux méthodes. Celle par couleur reconnaît le fond de studio et efface ce qui lui ressemble : environ une seconde, aucune exigence, et elle marche toujours — mais elle renonce dès que le fond n'est pas uniforme. Le réseau de neurones donne un contour bien meilleur — les mèches de cheveux sont tenues — mais il lui faut une carte graphique, et il se compte en secondes."/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20">
                <StackPanel>

                    <!-- Trois choix exclusifs, et RIEN de grisé. La première version
                         mettait deux cases dont la seconde restait désactivée tant que
                         la première n'était pas cochée : le réglage qu'on vient
                         chercher — le modèle puissant — n'était donc pas cochable, et
                         rien à l'écran ne disait pourquoi. -->
                    <RadioButton x:Name="CouleurRadio" GroupName="Detourage"
                                 Checked="OnDetourageChanged">
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource Texte}" FontSize="19" TextWrapping="Wrap"
                                       Text="Méthode par couleur"/>
                            <TextBlock Style="{StaticResource Hint}" FontSize="14" TextWrapping="Wrap"
                                       Text="Environ 1 s par photo. Aucune exigence matérielle. Elle laisse la photo intacte quand le fond n'est pas uni."/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ReseauLegerRadio" GroupName="Detourage" Margin="0,16,0,0"
                                 Checked="OnDetourageChanged">
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource Texte}" FontSize="19" TextWrapping="Wrap"
                                       Text="Réseau de neurones — modèle « lite »"/>
                            <TextBlock Style="{StaticResource Hint}" FontSize="14" TextWrapping="Wrap"
                                       Text="Contour bien meilleur : les mèches de cheveux sont tenues, aucune ombre ne reste. Compter une dizaine de secondes par photo."/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ReseauPuissantRadio" GroupName="Detourage" Margin="0,16,0,0"
                                 Checked="OnModelePuissantChanged">
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource Texte}" FontSize="19" TextWrapping="Wrap"
                                       Text="Réseau de neurones — modèle « portrait », le plus puissant"/>
                            <TextBlock Style="{StaticResource Hint}" FontSize="14" TextWrapping="Wrap"
                                       Text="Le meilleur contour, et le plus gourmand. Il lui faut une carte graphique bien dotée — voir ci-dessous."/>
                        </StackPanel>
                    </RadioButton>

                    <!-- POUR UN POSTE DONT LA CARTE EMPORTE LE LOGICIEL. Ce n'est pas un
                         réglage de confort : à Créteil, le pilote graphique a tué Studio
                         deux fois en plein détourage, et rien dans le code ne rattrape
                         cela. Le processeur est plus lent, mais il ne fait pas tomber
                         l'application. -->
                    <CheckBox x:Name="SurLeProcesseurCheck" Margin="0,20,0,0"
                              Checked="OnSurLeProcesseurChanged" Unchecked="OnSurLeProcesseurChanged">
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Style="{StaticResource Texte}" FontSize="17" TextWrapping="Wrap"
                                       Text="Calculer sur le processeur, sans la carte graphique"/>
                            <TextBlock Style="{StaticResource Hint}" FontSize="14" TextWrapping="Wrap"
                                       Text="À cocher si l'application se ferme toute seule pendant un détourage : c'est le pilote de la carte qui l'emporte, et le processeur ne connaît pas ce défaut. Même modèle, même qualité — compter une dizaine de secondes par photo au lieu de cinq."/>
                        </StackPanel>
                    </CheckBox>

                    <!-- Le minimum requis, en clair : c'est la question qu'on se pose
                         devant cette case, et la seule réponse utile est chiffrée. -->
                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10"
                            Padding="16,12" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Ce qu'il faut comme machine"
                                       Style="{StaticResource Texte}" FontWeight="SemiBold"
                                       FontSize="16" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource Hint}" FontSize="14" TextWrapping="Wrap"
                                       Text="Méthode par couleur — aucune exigence, environ 1 s par photo."/>
                            <TextBlock Style="{StaticResource Hint}" FontSize="14" TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Text="Réseau « lite » (109 Mo) — carte DirectX 12 et 4 Go de mémoire vidéo. Mesuré sur une Quadro P2000 de 5 Go : 4,3 s sur l'aperçu, 9,5 s sur la photo pleine résolution."/>
                            <TextBlock Style="{StaticResource Hint}" FontSize="14" TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Text="Réseau « portrait » (467 Mo) — 8 Go de mémoire vidéo recommandés. Sur 5 Go, il réussit la première photo puis échoue faute de mémoire sur la suivante."/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="MaterielText" Style="{StaticResource Texte}" FontSize="15"
                               Margin="0,16,0,0" TextWrapping="Wrap"/>

                    <TextBlock x:Name="ModelesText" Style="{StaticResource Texte}" FontSize="15"
                               Margin="0,10,0,0" TextWrapping="Wrap"/>

                    <!-- Le modèle s'installait à la main, en copiant 109 Mo dans le
                         dossier de données. Personne ne l'a fait : le poste de Créteil
                         a tourné sans détourage depuis son installation. -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                        <Button x:Name="InstallerModeleButton" Content="Installer le modèle"
                                Click="OnInstallerLeModele" Padding="16,8" FontSize="15"/>
                        <TextBlock x:Name="TelechargementText" Style="{StaticResource Texte}"
                                   FontSize="15" Margin="12,0,0,0" VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock x:Name="DetourageEtatText" Style="{StaticResource Texte}" FontSize="17"
                               Margin="0,14,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource FlatButton}" MinWidth="180" MinHeight="52" FontSize="19"
                    Click="OnRetour">Retour</Button>
            <Button Style="{StaticResource BigButton}" MinWidth="240" MinHeight="52" FontSize="19"
                    Margin="12,0,0,0" Click="OnEnregistrer">Enregistrer</Button>
        </StackPanel>
    </Grid>
</UserControl>
