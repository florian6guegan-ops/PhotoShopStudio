<UserControl x:Class="Studio.App.Views.IdPhotoPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Studio.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Même dégraissage que la planche des tirages : le titre en 34 px et la phrase
             d'explication en dessous prenaient cent vingt pixels pour redire ce que
             l'en-tête de la fenêtre annonce déjà (« France — choisir les photos »). Le
             format visé, lui, compte : il reste, sur la même ligne que les boutons. -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TitleBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       ToolTip="Cliquez sur les photos à traiter. Vous les cadrerez une par une à l'étape suivante."/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource FlatButton}" MinHeight="38" MinWidth="0"
                        FontSize="15" Padding="16,0" Margin="4,0"
                        ToolTip="Tout sélectionner" Click="OnTout">☑  tout</Button>
                <Button Style="{StaticResource FlatButton}" MinHeight="38" MinWidth="0"
                        FontSize="15" Padding="16,0" Margin="4,0"
                        ToolTip="Ne rien sélectionner" Click="OnAucun">☐  aucun</Button>
                <Button x:Name="SortButton" Style="{StaticResource FlatButton}" MinHeight="38"
                        MinWidth="0" FontSize="15" Padding="16,0" Margin="4,0"
                        ToolTip="Choisir le classement des photos : date, nom, poids du fichier."
                        Click="OnTrier" Content="⇅  trier"/>
            </StackPanel>

            <TextBlock x:Name="HintText" Style="{StaticResource Hint}" FontSize="15"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"
                       Text="Cliquez sur les photos à traiter."/>
        </Grid>

        <Grid Grid.Row="1">
            <!-- planche virtualisée et centrée, comme celle des tirages -->
            <ItemsControl x:Name="PhotosGrid"
                          VirtualizingPanel.IsVirtualizing="True"
                          ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True" Focusable="False"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:PlancheVirtualisee/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- La tuile ENTIÈRE est cliquable, pas une case à cocher : au
                             comptoir on désigne une photo du doigt, on ne vise pas un carré
                             de douze pixels dans son coin. -->
                        <Border Margin="6" CornerRadius="10" BorderThickness="5"
                                BorderBrush="{Binding BorderBrush}"
                                Background="{Binding FondBrush}"
                                MouseLeftButtonUp="OnPhotoClicked" Tag="{Binding}"
                                Cursor="Hand">
                            <Grid Width="210" Height="230">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="8,8,8,26"/>
                                <TextBlock Text="{Binding Name}" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="8,0,8,6"/>
                                <!-- La pastille de rang : le client dit « la troisième »,
                                     et rien à l'écran ne le disait. -->
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="16"
                                        Width="32" Height="32" Margin="8"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Visibility="{Binding RangVisibility}">
                                    <TextBlock Text="{Binding Rang}" Foreground="White"
                                               FontSize="16" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="12"
                Padding="12,10" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Left" Style="{StaticResource Valeur}"
                           FontSize="19" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="44"
                            Padding="18,0" FontSize="15" Click="OnRetour">←  Précédent</Button>
                    <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="44"
                            Padding="18,0" FontSize="15" Margin="8,0,0,0"
                            Click="OnAnnuler">✕  Annuler</Button>
                    <Button x:Name="SuivantButton" Style="{StaticResource BigButton}" MinWidth="170"
                            MinHeight="52" FontSize="20" Padding="18,8" Margin="14,0,0,0"
                            Click="OnSuivant" IsEnabled="False">Suivant  →</Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
