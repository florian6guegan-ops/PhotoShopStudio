<UserControl x:Class="Studio.App.Views.IdPhotoPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" DockPanel.Dock="Left" Style="{StaticResource PageTitle}"
                       Text="Sélectionnez les photos"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource FlatButton}" MinHeight="48" MinWidth="120"
                        FontSize="17" Padding="12,6" Margin="0,0,10,0"
                        ToolTip="Tout sélectionner" Click="OnTout">☑ tout</Button>
                <Button Style="{StaticResource FlatButton}" MinHeight="48" MinWidth="120"
                        FontSize="17" Padding="12,6" Margin="0,0,10,0"
                        ToolTip="Ne rien sélectionner" Click="OnAucun">☐ aucun</Button>
                <Button Style="{StaticResource FlatButton}" MinHeight="48" MinWidth="140"
                        FontSize="17" Padding="12,6"
                        ToolTip="Alterner entre le classement par date et par nom"
                        Click="OnTrier">⇅ trier</Button>
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1" x:Name="HintText" Style="{StaticResource Hint}" Margin="0,0,0,12"
                   TextWrapping="Wrap"
                   Text="Cliquez sur les photos à traiter. Vous les cadrerez une par une à l'étape suivante."/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PhotosGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- La tuile ENTIÈRE est cliquable, pas une case à cocher : au
                             comptoir on désigne une photo du doigt, on ne vise pas un carré
                             de douze pixels dans son coin. -->
                        <Border Margin="6" CornerRadius="10" BorderThickness="5"
                                BorderBrush="{Binding BorderBrush}"
                                Background="{Binding FondBrush}"
                                MouseLeftButtonUp="OnPhotoClicked" Tag="{Binding}"
                                Cursor="Hand">
                            <Grid Width="210" Height="230">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="8,8,8,26"/>
                                <TextBlock Text="{Binding Name}" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="8,0,8,6"/>
                                <!-- La pastille de rang : le client dit « la troisième »,
                                     et rien à l'écran ne le disait. -->
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="16"
                                        Width="32" Height="32" Margin="8"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Visibility="{Binding RangVisibility}">
                                    <TextBlock Text="{Binding Rang}" Foreground="White"
                                               FontSize="16" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{StaticResource CardBrush}" CornerRadius="12"
                Padding="16" Margin="0,16,0,0">
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Left" Style="{StaticResource Valeur}"
                           VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource FlatButton}" MinWidth="150" Click="OnRetour">← Précédent</Button>
                    <Button Style="{StaticResource FlatButton}" MinWidth="140" Margin="12,0,0,0"
                            Click="OnAnnuler">✕ Annuler</Button>
                    <Button x:Name="SuivantButton" Style="{StaticResource BigButton}" MinWidth="220"
                            Margin="12,0,0,0" Click="OnSuivant" IsEnabled="False">Suivant  →</Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
