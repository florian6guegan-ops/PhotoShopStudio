<UserControl x:Class="Studio.App.Views.LargeFormatPrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,18,0,10"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,8"/>
        </Style>
        <Style x:Key="Fld" TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- BasedOn explicite : un style nommé ne reprend PAS le style implicite de
             l'application, et ces dix-sept listes seraient restées grises au milieu d'un
             écran sombre. -->
        <Style x:Key="Cbo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>
        <Style x:Key="Chk" TargetType="CheckBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Style="{StaticResource PageTitle}"
                   Text="Impression grand format"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Aperçu : la feuille en blanc, le tirage posé dessus.

                 ClipToBounds sur le Canvas ET sur le Border : un Canvas ne rogne JAMAIS ses
                 enfants. Dès que le tirage débordait de la feuille — le cas où l'avertissement
                 compte le plus — le rectangle de la photo était dessiné par-dessus tout
                 l'écran : titre de la commande, panneau de droite, et jusqu'à l'avertissement
                 jaune qu'il fallait justement lire. -->
            <Border Grid.Column="0" Background="#3A3A3A" CornerRadius="12" Padding="20" Margin="0,0,20,0"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SizeText" Grid.Row="0" Foreground="#DDDDDD" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <Canvas x:Name="PreviewCanvas" Grid.Row="1" Background="Transparent"
                            ClipToBounds="True" SizeChanged="OnPreviewSizeChanged"/>
                    <TextBlock x:Name="WarningText" Grid.Row="2" Foreground="#FFD24A" FontSize="14"
                               TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Width="440">
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Configuration de l'imprimante"
                                   Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="Imprimante"/>
                            <ComboBox x:Name="PrinterCombo" Grid.Row="0" Grid.Column="1"
                                      Style="{StaticResource Cbo}" SelectionChanged="OnPrinterChanged"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="Copies"/>
                            <TextBox x:Name="CopiesBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Fld}"
                                     Text="1" TextChanged="OnSettingChanged"/>

                            <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="0,0,0,10"
                                    Padding="12,8" FontSize="15" Content="Paramètres d'impression…"
                                    Click="OnOpenDriverDialog"
                                    ToolTip="Ouvre la boîte du pilote : type de papier, qualité, format, sans marges."/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Lbl}" Text="Disposition"/>
                            <!-- OnOrientationChanged, et non OnSettingChanged : changer de
                                 disposition oblige à REDEMANDER la taille de feuille au
                                 pilote. Sans cela, portrait et paysage ne changeaient rien. -->
                            <ComboBox x:Name="OrientationCombo" Grid.Row="3" Grid.Column="1"
                                      Style="{StaticResource Cbo}" SelectionChanged="OnOrientationChanged">
                                <ComboBoxItem Content="Portrait" IsSelected="True"/>
                                <ComboBoxItem Content="Paysage"/>
                            </ComboBox>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Gestion des couleurs"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="Profil du document"/>
                            <TextBlock x:Name="DocProfileText" Grid.Row="0" Grid.Column="1"
                                       Style="{StaticResource Lbl}" Text="—"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="Traitement des couleurs"/>
                            <ComboBox x:Name="ColorHandlingCombo" Grid.Row="1" Grid.Column="1"
                                      Style="{StaticResource Cbo}" SelectionChanged="OnColorHandlingChanged">
                                <ComboBoxItem Content="Laisser l'imprimante gérer les couleurs" IsSelected="True"/>
                                <ComboBoxItem Content="Laisser Studio gérer les couleurs"/>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Lbl}" Text="Profil de l'imprimante"/>
                            <ComboBox x:Name="PrinterProfileCombo" Grid.Row="2" Grid.Column="1"
                                      Style="{StaticResource Cbo}" IsEnabled="False"
                                      SelectionChanged="OnSettingChanged"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Lbl}" Text="Mode de rendu"/>
                            <ComboBox x:Name="IntentCombo" Grid.Row="3" Grid.Column="1"
                                      Style="{StaticResource Cbo}" IsEnabled="False"
                                      SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="Colorimétrie relative" IsSelected="True"/>
                                <ComboBoxItem Content="Perception"/>
                                <ComboBoxItem Content="Saturation"/>
                                <ComboBoxItem Content="Colorimétrie absolue"/>
                            </ComboBox>

                            <!-- Sur les deux colonnes, comme « Centrer sur la feuille » : dans la
                                 seule colonne de droite, ce libellé sortait du panneau et
                                 s'affichait « Compensation du point noi ». -->
                            <CheckBox x:Name="BlackPointCheck" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                      Style="{StaticResource Chk}" IsChecked="True" IsEnabled="False"
                                      Content="Compensation du point noir" Click="OnSettingChanged"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Position et taille"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <CheckBox x:Name="CenterCheck" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                      Style="{StaticResource Chk}" IsChecked="True" Content="Centrer sur la feuille"
                                      Click="OnCenterChanged"/>
                            <CheckBox x:Name="CutBorderCheck" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2"
                                      Style="{StaticResource Chk}" Margin="12,0,0,8"
                                      Content="Contour de découpe"
                                      ToolTip="Trace un trait noir de 0,2 mm sur le bord du tirage, à suivre aux ciseaux. Le trait est à cheval sur le bord : la coupe l'emporte."
                                      Click="OnSettingChanged"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="Haut"/>
                            <TextBox x:Name="TopBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Fld}"
                                     Text="0" IsEnabled="False" TextChanged="OnSettingChanged"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Lbl}" Text="Gauche"
                                       Margin="12,0,12,8"/>
                            <TextBox x:Name="LeftBox" Grid.Row="1" Grid.Column="3" Style="{StaticResource Fld}"
                                     Text="0" IsEnabled="False" TextChanged="OnSettingChanged"/>

                            <CheckBox x:Name="FitCheck" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                      Style="{StaticResource Chk}" Content="Ajuster au support"
                                      Click="OnFitChanged"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Lbl}" Text="Échelle"/>
                            <TextBox x:Name="ScaleBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource Fld}"
                                     Text="100" TextChanged="OnScaleTyped"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Lbl}" Text="%"
                                       Margin="12,0,12,8"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Lbl}" Text="Largeur"/>
                            <TextBox x:Name="WidthBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource Fld}"
                                     TextChanged="OnWidthTyped"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Lbl}" Text="Hauteur"
                                       Margin="12,0,12,8"/>
                            <TextBox x:Name="HeightBox" Grid.Row="4" Grid.Column="3" Style="{StaticResource Fld}"
                                     TextChanged="OnHeightTyped"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Lbl}" Text="Unités"/>
                            <ComboBox x:Name="UnitsCombo" Grid.Row="5" Grid.Column="1" Style="{StaticResource Cbo}"
                                      SelectionChanged="OnUnitsChanged">
                                <ComboBoxItem Content="Centimètres" IsSelected="True"/>
                                <ComboBoxItem Content="Millimètres"/>
                                <ComboBoxItem Content="Pouces"/>
                            </ComboBox>
                            <TextBlock x:Name="ResolutionText" Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2"
                                       Style="{StaticResource Lbl}" Margin="12,0,0,8" Text="—"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Padding="20,10" FontSize="16" Margin="0,0,12,0" Click="OnCancel"/>
            <Button x:Name="PrintButton" Content="Imprimer" Padding="28,10" FontSize="16" Click="OnPrint"/>
        </StackPanel>
    </Grid>
</UserControl>
