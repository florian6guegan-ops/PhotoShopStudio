<UserControl x:Class="Studio.App.Views.CustomEnlargementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Saisie" TargetType="TextBox">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Agrandissement — taille personnalisée"
                   Style="{StaticResource PageTitle}" HorizontalAlignment="Center"/>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="32">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,0,0,20"
                           Text="Donnez la taille du tirage fini. Il est facturé au prix du format du catalogue dans lequel il tient."/>

                <!-- Les formats normalisés d'un clic : c'est ce qu'on redemande le plus,
                     et retaper « 42 × 59,4 » se solde tôt ou tard par un millimètre faux. -->
                <ItemsControl x:Name="StandardsList" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource FlatButton}" Margin="4" MinWidth="150"
                                    Content="{Binding Libelle}" Tag="{Binding}"
                                    AutomationProperties.Name="{Binding Libelle}"
                                    Click="OnFormatNormalise"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBox x:Name="LargeurBox" Style="{StaticResource Saisie}"
                             AutomationProperties.Name="Largeur en centimètres"
                             TextChanged="OnTailleTapee"/>
                    <TextBlock Text="×" FontSize="34" Margin="16,0" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="HauteurBox" Style="{StaticResource Saisie}"
                             AutomationProperties.Name="Hauteur en centimètres"
                             TextChanged="OnTailleTapee"/>
                    <TextBlock Text="cm" FontSize="26" Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>

                <!-- Les tailles déjà demandées : au comptoir, c'est presque toujours la même. -->
                <ItemsControl x:Name="RecentesList" Margin="0,20,0,0" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource FlatButton}" Margin="4" MinWidth="120"
                                    Content="{Binding Libelle}" Tag="{Binding}"
                                    AutomationProperties.Name="{Binding Libelle}"
                                    Click="OnTailleRecente"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Le prix AVANT de choisir les photos : c'est ici que l'opérateur
                     l'annonce au client, sans avoir rien engagé. -->
                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="20"
                        Margin="0,28,0,0" MinWidth="620">
                    <StackPanel>
                        <TextBlock x:Name="VerdictText" FontSize="20" FontWeight="SemiBold"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="PrixText" FontSize="40" FontWeight="Bold"
                                   TextAlignment="Center" Margin="0,10,0,0"
                                   Foreground="{StaticResource TitleBrush}"/>
                        <TextBlock x:Name="PaliersText" Style="{StaticResource Hint}" FontSize="16"
                                   TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button x:Name="ContinuerButton" Style="{StaticResource BigButton}" MinWidth="260"
                    Margin="0,0,12,0" IsEnabled="False"
                    AutomationProperties.Name="Choisir les photos" Click="OnContinuer">
                ➜  Choisir les photos
            </Button>
            <Button Style="{StaticResource FlatButton}" MinWidth="200" Margin="0,0,12,0"
                    AutomationProperties.Name="Précédent" Click="OnBack">← Précédent</Button>
            <Button Style="{StaticResource FlatButton}" MinWidth="200"
                    AutomationProperties.Name="Annuler" Click="OnCancel">Annuler</Button>
        </StackPanel>
    </Grid>
</UserControl>
