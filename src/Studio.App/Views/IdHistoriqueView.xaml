<UserControl x:Class="Studio.App.Views.IdHistoriqueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Studio.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TitleBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       Text="Photos récentes — 30 jours"/>

            <TextBlock x:Name="HintText" Style="{StaticResource Hint}" FontSize="15"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"
                       Text="Touchez une photo pour la rouvrir telle qu'elle était."/>
        </Grid>

        <Grid Grid.Row="1">
            <!-- même planche virtualisée que le choix des photos : c'est le même geste,
                 désigner une photo du doigt -->
            <ItemsControl x:Name="PhotosGrid"
                          VirtualizingPanel.IsVirtualizing="True"
                          ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True" Focusable="False"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:PlancheVirtualisee/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="6" CornerRadius="10" BorderThickness="5"
                                BorderBrush="Transparent"
                                Background="{DynamicResource CardBrush}"
                                MouseLeftButtonUp="OnPhotoClicked" Tag="{Binding}"
                                Cursor="Hand" Opacity="{Binding Opacite}">
                            <Grid Width="210" Height="252">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                       Margin="8,8,8,48"/>

                                <StackPanel VerticalAlignment="Bottom" Margin="8,0,8,6">
                                    <TextBlock Text="{Binding Quand}" FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Resume}" FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Ce qui a été fait de cette photo : la planche, le
                                     courriel, ou les deux. C'est ce qui distingue deux
                                     tuiles d'un même client. -->
                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="12"
                                        Padding="8,2" Margin="8" Height="24"
                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Pastille}" Foreground="White"
                                               FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- La photo n'est plus sur le disque : la tuile le dit
                                     plutôt que de s'ouvrir sur une erreur. -->
                                <Border Background="#99000000" CornerRadius="6" Padding="10,6"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding PerdueVisibility}">
                                    <TextBlock Text="fichier effacé" Foreground="White" FontSize="13"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="VideText" Style="{StaticResource Hint}" FontSize="17"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" Visibility="Collapsed"
                       Text="Aucune photo faite ces trente derniers jours.&#10;&#10;Les photos entrent ici dès qu'elles sont imprimées ou envoyées par courriel."/>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" CornerRadius="12"
                Padding="12,10" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Left" Style="{StaticResource Valeur}"
                           FontSize="19" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource FlatButton}" MinWidth="0" MinHeight="44"
                            Padding="18,0" FontSize="15" Click="OnRetour">←  Retour</Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
