<UserControl x:Class="Studio.App.Views.AdjustView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Reglage" TargetType="Slider">
            <Setter Property="Margin" Value="0,2,0,10"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="Minimum" Value="-100"/>
            <Setter Property="Maximum" Value="100"/>
        </Style>
        <Style x:Key="Etiquette" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" Grid.ColumnSpan="2"
                   Style="{StaticResource PageTitle}" Text="Corrections"/>

        <Border Grid.Row="1" Grid.Column="0" Background="#1B1B1B" CornerRadius="12" Margin="0,0,16,0">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="14"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="PreviewHint" Style="{StaticResource Hint}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="Chargement de l'aperçu…"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Lumière" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>

                <TextBlock x:Name="ExposureLabel" Style="{StaticResource Etiquette}" Text="Exposition"/>
                <Slider x:Name="ExposureSlider" Style="{StaticResource Reglage}"
                        Minimum="-200" Maximum="200" ValueChanged="OnChanged"/>

                <TextBlock x:Name="ContrastLabel" Style="{StaticResource Etiquette}" Text="Contraste"/>
                <Slider x:Name="ContrastSlider" Style="{StaticResource Reglage}" ValueChanged="OnChanged"/>

                <TextBlock x:Name="HighlightsLabel" Style="{StaticResource Etiquette}" Text="Hautes lumières"/>
                <Slider x:Name="HighlightsSlider" Style="{StaticResource Reglage}" ValueChanged="OnChanged"/>

                <TextBlock x:Name="ShadowsLabel" Style="{StaticResource Etiquette}" Text="Ombres"/>
                <Slider x:Name="ShadowsSlider" Style="{StaticResource Reglage}" ValueChanged="OnChanged"/>

                <TextBlock x:Name="WhitesLabel" Style="{StaticResource Etiquette}" Text="Blancs"/>
                <Slider x:Name="WhitesSlider" Style="{StaticResource Reglage}" ValueChanged="OnChanged"/>

                <TextBlock x:Name="BlacksLabel" Style="{StaticResource Etiquette}" Text="Noirs"/>
                <Slider x:Name="BlacksSlider" Style="{StaticResource Reglage}" ValueChanged="OnChanged"/>

                <TextBlock Text="Couleur" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,10"/>

                <TextBlock x:Name="TemperatureLabel" Style="{StaticResource Etiquette}" Text="Température"/>
                <Slider x:Name="TemperatureSlider" Style="{StaticResource Reglage}" ValueChanged="OnChanged"/>

                <TextBlock x:Name="TintLabel" Style="{StaticResource Etiquette}" Text="Teinte"/>
                <Slider x:Name="TintSlider" Style="{StaticResource Reglage}" ValueChanged="OnChanged"/>

                <TextBlock x:Name="VibranceLabel" Style="{StaticResource Etiquette}" Text="Vibrance"/>
                <Slider x:Name="VibranceSlider" Style="{StaticResource Reglage}" ValueChanged="OnChanged"/>

                <TextBlock x:Name="SaturationLabel" Style="{StaticResource Etiquette}" Text="Saturation"/>
                <Slider x:Name="SaturationSlider" Style="{StaticResource Reglage}" ValueChanged="OnChanged"/>

                <TextBlock Text="Détail" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,10"/>

                <TextBlock x:Name="ClarityLabel" Style="{StaticResource Etiquette}" Text="Clarté"/>
                <Slider x:Name="ClaritySlider" Style="{StaticResource Reglage}" ValueChanged="OnChanged"/>

                <TextBlock x:Name="SharpnessLabel" Style="{StaticResource Etiquette}" Text="Netteté"/>
                <Slider x:Name="SharpnessSlider" Style="{StaticResource Reglage}"
                        Minimum="0" Maximum="100" ValueChanged="OnChanged"/>

                <CheckBox x:Name="GrayscaleCheck" Style="{StaticResource CaseCochable}" Content="Noir et blanc" Margin="0,10,0,0"
                          FontSize="14" Foreground="{DynamicResource TextBrush}"
                          Checked="OnChanged" Unchecked="OnChanged"/>

                <CheckBox x:Name="RedEyeCheck" Style="{StaticResource CaseCochable}" Content="Enlever les yeux rouges" Margin="0,8,0,0"
                          FontSize="14" Foreground="{DynamicResource TextBrush}"
                          ToolTip="Neutralise le rouge du flash au fond de l'œil. Ne touche qu'aux pupilles, trouvées par le détecteur de visages."
                          Checked="OnChanged" Unchecked="OnChanged"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="ApplyButton" Content="Appliquer" Padding="26,12" FontSize="16"
                    Click="OnApply"/>
            <Button Content="Tout remettre à zéro" Padding="20,12" FontSize="15" Margin="12,0,0,0"
                    Click="OnReset"/>
            <Button Content="Annuler" Padding="20,12" FontSize="15" Margin="12,0,0,0"
                    Click="OnCancel"/>
            <TextBlock x:Name="ScopeText" Style="{StaticResource Hint}"
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
