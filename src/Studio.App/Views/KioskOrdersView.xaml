<UserControl x:Class="Studio.App.Views.KioskOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>

        <!-- Onglet, comme la barre « Ordres / Historique » de DiLand : l'onglet actif est
             plein, l'autre reste sombre. Les opérateurs connaissent ce repère. -->
        <Style x:Key="Onglet" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="fond" Background="{StaticResource PanelBrush}"
                                CornerRadius="10,10,0,0" Padding="28,12" Margin="0,0,4,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="fond" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Le gros bouton rond en tête de ligne : c'est lui qui lance le travail. -->
        <Style x:Key="BoutonRond" TargetType="Button">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="rond" Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="rond" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pastille produit : « 10x15 Brillant × 2 », comme DiLand l'affiche à droite
             de chaque ordre. C'est ce que l'opérateur lit pour savoir quoi charger. -->
        <Style x:Key="Pastille" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <Style x:Key="ActionLigne" TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="Commandes des bornes"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <RadioButton x:Name="OngletOrdres" Style="{StaticResource Onglet}" Content="Ordres"
                         IsChecked="True" Checked="OnTabChanged"/>
            <RadioButton x:Name="OngletHistorique" Style="{StaticResource Onglet}" Content="Historique"
                         Checked="OnTabChanged"
                         ToolTip="Les commandes tirées ou retirées, conservées un mois."/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="2" Style="{StaticResource Hint}"
                   Margin="0,14,0,14" TextWrapping="Wrap"/>

        <!-- Onglet Ordres -->
        <ScrollViewer x:Name="OrdersScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="OrdersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16,14"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Style="{StaticResource BoutonRond}"
                                        Background="{Binding StateBrush}" Content="{Binding StateGlyph}"
                                        Click="OnOpen" Tag="{Binding}" Margin="0,0,16,0"
                                        ToolTip="Ouvre les photos pour les recadrer et les corriger avant de tirer."/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Number}" FontSize="26" FontWeight="Bold"
                                                   Foreground="{StaticResource TitleBrush}"/>
                                        <TextBlock Text="{Binding When}" FontSize="21" Margin="14,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding Total}" FontSize="21" Margin="14,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TitleBrush}"/>
                                        <Border Background="{Binding StateBrush}" CornerRadius="4"
                                                Padding="9,3" Margin="14,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding StateVisibility}">
                                            <TextBlock Text="{Binding StateLabel}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Customer}" FontSize="19" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextBrush}"
                                               Visibility="{Binding CustomerVisibility}"/>
                                </StackPanel>

                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Products}"
                                              VerticalAlignment="Center" MaxWidth="420" Margin="12,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Pastille}">
                                                <TextBlock Text="{Binding}" FontSize="15"
                                                           Foreground="{StaticResource TextBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Ouvrir" Style="{StaticResource ActionLigne}"
                                            Click="OnOpen" Tag="{Binding}"
                                            ToolTip="Ouvre les photos pour les recadrer et les corriger avant de tirer."/>
                                    <Button Content="Reprendre" Style="{StaticResource ActionLigne}"
                                            Click="OnImport" Tag="{Binding}"
                                            IsEnabled="{Binding CanImport}"
                                            ToolTip="Crée la commande telle quelle, sans retouche. DiLand garde la sienne."/>
                                    <Button Content="✕" Style="{StaticResource ActionLigne}"
                                            Click="OnDismiss" Tag="{Binding}"
                                            Background="{StaticResource DangerBrush}" Foreground="White"
                                            ToolTip="Retire la commande de la liste sans la tirer — par exemple si DiLand l'a déjà imprimée."/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Onglet Historique -->
        <ScrollViewer x:Name="HistoryScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
            <ItemsControl x:Name="HistoryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16,12"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="12" CornerRadius="6" Margin="0,0,16,0"
                                        Background="{Binding StateBrush}"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Number}" FontSize="22" FontWeight="Bold"
                                                   Foreground="{StaticResource TitleBrush}"/>
                                        <TextBlock Text="{Binding When}" FontSize="18" Margin="14,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding Total}" FontSize="18" Margin="14,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TitleBrush}"/>
                                        <TextBlock Text="{Binding Customer}" FontSize="18" Margin="14,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}" FontSize="14" Margin="0,3,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StateLabel}" FontSize="15" VerticalAlignment="Center"
                                               Foreground="{Binding StateBrush}"/>
                                    <Button Content="Remettre dans la liste" Style="{StaticResource ActionLigne}"
                                            Click="OnReopen" Tag="{Binding}"
                                            ToolTip="Repasse la commande dans l'onglet Ordres, si elle a été close par erreur."/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel x:Name="ActionsOrdres" Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Actualiser" Padding="22,10" FontSize="15" Click="OnRefresh"/>
            <Button Content="Tout reprendre" Padding="22,10" FontSize="15" Margin="12,0,0,0"
                    Click="OnImportAll"
                    ToolTip="Reprend toutes les commandes de bornes en attente, sans retouche."/>
        </StackPanel>
    </Grid>
</UserControl>
