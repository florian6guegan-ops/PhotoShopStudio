<UserControl x:Class="Studio.App.Views.KioskOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="Commandes des bornes"/>

        <TextBlock x:Name="StatusText" Grid.Row="1" Style="{StaticResource Hint}"
                   Margin="0,0,0,16" TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="OrdersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="20"
                                Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Header}" FontSize="19" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="14"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Ouvrir" Padding="22,10" FontSize="15"
                                            Click="OnOpen" Tag="{Binding}"
                                            ToolTip="Ouvre les photos pour les recadrer et les corriger avant de tirer."/>
                                    <Button Content="Reprendre" Padding="18,10" FontSize="15" Margin="10,0,0,0"
                                            Click="OnImport" Tag="{Binding}"
                                            ToolTip="Crée la commande telle quelle, sans retouche. DiLand garde la sienne."/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Actualiser" Padding="22,10" FontSize="15" Click="OnRefresh"/>
            <Button Content="Tout reprendre" Padding="22,10" FontSize="15" Margin="12,0,0,0"
                    Click="OnImportAll"
                    ToolTip="Reprend toutes les commandes de bornes en attente, sans retouche."/>
            <CheckBox x:Name="ShowTakenCheck" Content="Voir les commandes déjà reprises"
                      VerticalAlignment="Center" Margin="24,0,0,0" FontSize="14"
                      Foreground="{StaticResource TextBrush}"
                      Checked="OnRefresh" Unchecked="OnRefresh"/>
        </StackPanel>
    </Grid>
</UserControl>
