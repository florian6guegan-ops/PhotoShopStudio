<UserControl x:Class="Studio.App.Views.MachineStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Etiquette" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,10,4"/>
        </Style>
        <Style x:Key="Valeur" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource PageTitle}" Text="État des machines"/>
            <Button DockPanel.Dock="Right" Content="Actualiser" Padding="18,8" FontSize="15"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnRefresh"/>
        </DockPanel>

        <TextBlock x:Name="MessageText" Grid.Row="1" Style="{StaticResource Hint}"
                   VerticalAlignment="Top" Margin="0,20,0,0" TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MachinesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <!-- La pastille dit l'état d'un coup d'œil, et les couleurs
                                     sont les MÊMES pour toutes les machines : vert prête,
                                     bleu en train de tirer, orangé un geste à faire, rouge
                                     en panne, gris hors ligne, ardoise en veille. Il fallait
                                     lire chaque ligne pour savoir laquelle réclamait quelque
                                     chose. -->
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" CornerRadius="7" Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Background="{Binding EtatCouleur}"/>
                                    <TextBlock Text="{Binding Titre}" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SousTitre}" FontSize="14"
                                           Foreground="{DynamicResource MutedBrush}" Margin="24,4,0,14"/>

                                <!-- alerte consommables -->
                                <Border Background="#FFF3CD" CornerRadius="8" Padding="12,10" Margin="0,0,0,14"
                                        Visibility="{Binding AlerteVisibility}">
                                    <TextBlock Text="{Binding Alerte}" FontSize="15" TextWrapping="Wrap"
                                               Foreground="#7A5C00"/>
                                </Border>

                                <Grid Visibility="{Binding DetailVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" MinWidth="260"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                        <TextBlock Text="Papier" Style="{StaticResource Etiquette}"/>
                                        <TextBlock Text="{Binding Papier}" Style="{StaticResource Valeur}"/>
                                        <TextBlock Text="Compteur machine" Style="{StaticResource Etiquette}"
                                                   Margin="0,10,10,4"/>
                                        <TextBlock Text="{Binding Compteur}" Style="{StaticResource Valeur}"/>

                                        <TextBlock Text="Consommables" Style="{StaticResource Etiquette}"
                                                   Margin="0,16,10,6"/>
                                        <ItemsControl ItemsSource="{Binding Consommables}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="56"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Nom}" FontSize="15"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Height="18" CornerRadius="9"
                                                                Background="#E6E6E6" HorizontalAlignment="Stretch">
                                                            <Border HorizontalAlignment="Left" CornerRadius="9"
                                                                    Background="{Binding Couleur}"
                                                                    Width="{Binding Largeur}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding Texte}" FontSize="15"
                                                                   FontWeight="SemiBold" TextAlignment="Right"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Tirages restants avec ce rouleau"
                                                   Style="{StaticResource Etiquette}"/>
                                        <ItemsControl ItemsSource="{Binding Formats}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Nom}"
                                                                   FontSize="15" MinWidth="90"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                        <TextBlock Text="{Binding Restants}" FontSize="15"
                                                                   FontWeight="SemiBold" TextAlignment="Right"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
