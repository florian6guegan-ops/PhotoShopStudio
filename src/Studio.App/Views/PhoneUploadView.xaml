<UserControl x:Class="Studio.App.Views.PhoneUploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}" Text="Photos depuis un téléphone"/>

        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,0,0,16"
                           Text="Le client scanne avec l'appareil photo de son téléphone, dans l'ordre."/>

                <!-- Les deux codes côte à côte, NUMÉROTÉS : le code d'envoi ne mène nulle part
                     tant que le téléphone n'est pas sur le réseau du magasin. La colonne WiFi
                     disparaît quand le poste n'a pas de profil sans fil lisible (Ethernet). -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel x:Name="WifiPanel" Margin="0,0,32,0" Visibility="Collapsed">
                        <TextBlock FontSize="20" FontWeight="Bold" TextAlignment="Center"
                                   Margin="0,0,0,8" Foreground="{StaticResource TextBrush}"
                                   Text="1.  Se connecter au WiFi"/>
                        <Border Background="White" Padding="16" CornerRadius="12" HorizontalAlignment="Center">
                            <Image x:Name="WifiQrImage" Width="280" Height="280"/>
                        </Border>
                        <TextBlock x:Name="WifiSsidText" FontSize="20" FontWeight="SemiBold"
                                   TextAlignment="Center" Margin="0,12,0,0"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>

                    <StackPanel x:Name="UploadPanel">
                        <TextBlock x:Name="UploadStepText" FontSize="20" FontWeight="Bold"
                                   TextAlignment="Center" Margin="0,0,0,8"
                                   Foreground="{StaticResource TextBrush}"
                                   Text="Envoyer les photos"/>
                        <Border Background="White" Padding="16" CornerRadius="12" HorizontalAlignment="Center">
                            <Image x:Name="QrImage" Width="280" Height="280"/>
                        </Border>
                        <TextBlock x:Name="UrlText" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"
                                   Margin="0,12,0,0" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="CountText" FontSize="26" FontWeight="Bold" TextAlignment="Center"
                           Margin="0,24,0,0" Foreground="{StaticResource OkBrush}"
                           Text="En attente de photos…"/>

                <!-- APERÇU DES PHOTOS REÇUES. Un compteur ne dit pas si ce sont les bonnes
                     photos, ni si le client s'est trompé d'album : l'opérateur devait ouvrir
                     la grille pour le savoir, donc quitter l'écran du code QR — et le client
                     qui envoyait la suite ne voyait plus rien. La bande défile
                     horizontalement pour ne pas repousser les codes hors de l'écran. -->
                <ScrollViewer x:Name="ApercuScroll" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              MaxWidth="900" Margin="0,16,0,0">
                    <ItemsControl x:Name="ApercuList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="8" Padding="4" Margin="4">
                                    <Image Source="{Binding Vignette}" Width="120" Height="120"
                                           Stretch="Uniform"
                                           ToolTip="{Binding Nom}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16" Margin="0,16,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Hint}" VerticalAlignment="Center"
                           Text="Les photos apparaissent ici au fur et à mesure."/>
                <Button x:Name="OpenButton" DockPanel.Dock="Right" Style="{StaticResource BigButton}"
                        HorizontalAlignment="Right" IsEnabled="False" Click="OnOpenPhotos">
                    ➜  Ouvrir les photos reçues
                </Button>
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource FlatButton}"
                        MinWidth="260" Margin="0,0,12,0" HorizontalAlignment="Right"
                        IsEnabled="False" Click="OnSavePhotos"
                        AutomationProperties.Name="Enregistrer les photos">
                    💾  Enregistrer les photos…
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
