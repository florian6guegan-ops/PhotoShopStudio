<UserControl x:Class="Studio.App.Views.IdShortcutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource PageTitle}"
                   Text="Raccourcis « photo d'identité »"/>

        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Margin="0,0,0,16" TextWrapping="Wrap"
                   Text="Ces formats s'affichent en grand à l'ouverture du module photo d'identité. Les 274 autres restent accessibles par le bouton « Autres formats… »."/>

        <!-- Ajout : une norme du référentiel, ou un produit tiré tel quel (E-Photo) -->
        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" CornerRadius="12"
                Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="DocumentCombo" Grid.Row="0" Grid.Column="0" FontSize="18" Padding="10,8"
                          DisplayMemberPath="Libelle" Margin="0,0,12,8"
                          AutomationProperties.Name="Document à ajouter"/>
                <!-- Le NOMBRE fait partie du raccourci : la boutique vend deux planches
                     françaises, et ce n'est pas le format qui les distingue. « Planche
                     pleine » reste le défaut — c'est ce que faisaient tous les raccourcis
                     avant le 17/08/2026. -->
                <ComboBox x:Name="PhotosCombo" Grid.Row="0" Grid.Column="1" FontSize="18" Padding="10,8"
                          DisplayMemberPath="Libelle" MinWidth="190" Margin="0,0,12,8"
                          ToolTip="Combien de photos poser sur la planche. « Planche pleine » en met autant que le papier peut en porter."
                          AutomationProperties.Name="Photos par planche"/>
                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource FlatButton}"
                        MinWidth="220" MinHeight="48" FontSize="18" Margin="0,0,0,8"
                        Click="OnAjouterDocument">➕ Ajouter ce document</Button>

                <ComboBox x:Name="ProduitCombo" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                          FontSize="18" Padding="10,8"
                          DisplayMemberPath="Libelle" Margin="0,0,12,0"
                          AutomationProperties.Name="Produit à ajouter"/>
                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource FlatButton}"
                        MinWidth="220" MinHeight="48" FontSize="18"
                        Click="OnAjouterProduit">➕ Ajouter ce produit</Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="RaccourcisList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="12"
                                Padding="16" Margin="0,0,0,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Style="{StaticResource FlatButton}" MinHeight="48" MinWidth="60"
                                            FontSize="18" Padding="12,6" ToolTip="Monter"
                                            Click="OnMonter" Tag="{Binding}">↑</Button>
                                    <Button Style="{StaticResource FlatButton}" Margin="8,0,0,0"
                                            MinHeight="48" MinWidth="60" FontSize="18" Padding="12,6"
                                            ToolTip="Descendre"
                                            Click="OnDescendre" Tag="{Binding}">↓</Button>
                                    <Button Style="{StaticResource FlatButton}" Margin="8,0,0,0"
                                            MinHeight="48" MinWidth="70" FontSize="18" Padding="12,6"
                                            Foreground="{DynamicResource DangerBrush}"
                                            ToolTip="Retirer ce raccourci"
                                            Click="OnRetirer" Tag="{Binding}">🗑</Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="22" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Text="{Binding Libelle}"/>
                                    <TextBlock FontSize="17" Foreground="{DynamicResource MutedBrush}"
                                               Text="{Binding Detail}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock x:Name="MessageText" Style="{StaticResource Hint}" VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource FlatButton}" MinWidth="180" Margin="0,0,12,0"
                        Click="OnDefauts">Remettre par défaut</Button>
                <Button Style="{StaticResource FlatButton}" MinWidth="160" Margin="0,0,12,0"
                        Click="OnRetour">← Retour</Button>
                <Button Style="{StaticResource BigButton}" MinWidth="220"
                        Click="OnEnregistrer">Enregistrer</Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
