<Window x:Class="Studio.Identite.FenetreIdentite"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Studio Photo Identité"
        WindowState="Normal" WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource PageBrush}"
        FontFamily="Segoe UI"
        MinWidth="1024" MinHeight="700">

    <!-- L'ÉCHELLE DE L'INTERFACE.

         Les écrans sont élastiques — les colonnes s'étirent — mais leurs TUILES ont une
         taille fixe : cartes de 46 px, polices de 17. En fenêtre réduite, le panneau de
         droite gardait donc sa largeur et se mettait à défiler ; « Imprimer la planche »
         passait hors de vue, et le texte du milieu se coupait au lieu de se replier.
         Signalé le 18/08/2026, juste après la fenêtre flottante.

         Le facteur est posé par SurTaille : 1 tant que la fenêtre est assez grande — le
         plein écran ne change donc pas d'un pixel —, puis proportionnel en dessous. C'est
         un LayoutTransform et non un RenderTransform : la mise en page est REFAITE à
         l'échelle voulue, les textes restent nets et les clics tombent juste. -->
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="EchelleInterface" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- EN-TÊTE, façon maquette : fin, la marque à gauche, « Client suivant » à droite.
             Il ne porte PAS de bouton Retour permanent : le parcours d'identité va toujours
             de l'avant, et le retour appartient à chaque écran. -->
        <!-- L'en-tête TIENT LIEU DE BARRE DE TITRE : la fenêtre n'en a pas, et une fois
             restaurée en mode fenêtre elle serait autrement impossible à déplacer. -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" Padding="16,10"
                MouseLeftButtonDown="OnEnteteAttrapee">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="🪪" FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitreEcran" Text="Photos d'identité"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="STUDIO PHOTO" Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- LE BANDEAU DE MISE À JOUR. Il existait dans le Studio complet et
                         nulle part ailleurs : ce logiciel-ci, né plus tard avec sa propre
                         fenêtre, n'annonçait RIEN. Les postes identité ont tourné deux
                         versions en retard sans que personne à la boutique puisse le savoir.
                         Il n'installe rien : on annonce, l'opérateur décide aux réglages. -->
                    <Border x:Name="MajBanner" CornerRadius="8" Padding="14,8"
                            Margin="0,0,10,0" VerticalAlignment="Center"
                            Cursor="Hand" Visibility="Collapsed"
                            Background="{DynamicResource TitleBrush}"
                            MouseLeftButtonUp="OnMajBannerClicked"
                            ToolTip="Une nouvelle version est disponible. Cliquez pour l'installer depuis les réglages.">
                        <TextBlock x:Name="MajBannerText" Text="⬆  Mise à jour disponible"
                                   Foreground="White" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Button x:Name="BoutonClientSuivant" Style="{StaticResource FlatButton}"
                            MinWidth="200" MinHeight="46" FontSize="17"
                            ToolTip="Repartir de zéro pour le client suivant"
                            Click="OnClientSuivant">⌂  Client suivant</Button>
                    <!-- Les réglages : l'une des deux seules sorties admises de la page. -->
                    <Button x:Name="BoutonReglages" Style="{StaticResource FlatButton}"
                            MinWidth="70" MinHeight="46" FontSize="19" Margin="10,0,0,0"
                            ToolTip="Réglages : d'où viennent les photos, et le compte d'envoi"
                            Click="OnReglages">⚙</Button>
                    <!-- RÉDUIRE ET RESTAURER.
                         La fenêtre n'a pas de barre de titre — WindowStyle="None" — et donc
                         aucun des trois boutons de Windows : impossible de la mettre dans la
                         barre des tâches pour aller voir un dossier, ni de sortir du plein
                         écran. « On ne peut pas réduire l'app non plus », 18/08/2026. -->
                    <Button x:Name="BoutonReduire" Style="{StaticResource FlatButton}"
                            MinWidth="70" MinHeight="46" FontSize="17" Margin="10,0,0,0"
                            ToolTip="Réduire dans la barre des tâches"
                            Click="OnReduire">—</Button>
                    <Button x:Name="BoutonAgrandir" Style="{StaticResource FlatButton}"
                            MinWidth="70" MinHeight="46" FontSize="15" Margin="10,0,0,0"
                            ToolTip="Plein écran ou fenêtre"
                            Click="OnAgrandirOuRestaurer">❐</Button>
                    <Button x:Name="BoutonQuitter" Style="{StaticResource FlatButton}"
                            MinWidth="70" MinHeight="46" FontSize="17" Margin="10,0,0,0"
                            ToolTip="Fermer Studio Photo Identité"
                            Click="OnQuitter">✕</Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- L'écran courant. Le Navigator du Studio est un simple événement : cette
             fenêtre-ci s'y abonne exactement comme le fait la fenêtre du Studio complet. -->
        <!-- LA MARGE, comme la fenêtre du Studio complet (ScreenHost, Margin="24").
             Elle manquait ici : les écrans partagés touchaient les quatre bords, et leur
             rangée de boutons du bas — « Enregistrer », « Retour », la phrase de
             conformité — se collait à l'arête de l'écran, sous la barre des tâches.
             C'est le « certains boutons sont trop bas » signalé le 17/08/2026. -->
        <ContentControl x:Name="HoteEcran" Grid.Row="1" Margin="24,16,24,20"/>

    </Grid>
</Window>
