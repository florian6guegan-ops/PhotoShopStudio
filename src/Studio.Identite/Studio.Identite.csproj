<Project Sdk="Microsoft.NET.Sdk">

  <!--
    STUDIO PHOTO IDENTITÉ — l'application des postes qui ne font QUE des photos d'identité.

    C'est un AUTRE logiciel : son propre exécutable, sa propre fenêtre, sa propre archive,
    son propre raccourci. Destiné à `kodakidpc` (Arcueil), où la DNP est branchée en direct.

    Ce qu'il ne refait PAS : le moteur. Détourage ONNX, pilotage DNP et DE100, catalogue,
    commandes, envoi par courriel, gabarits d'identité — tout vient des mêmes bibliothèques
    que le Studio complet. Une correction du moteur profite aux deux le jour où elle est
    faite ; deux copies auraient divergé en une semaine.

    La référence à Studio.App est délibérée et TEMPORAIRE dans son ampleur : elle donne
    d'un coup la composition des services (AppServices) et les écrans du parcours identité
    déjà éprouvés en boutique. Les écrans seront remplacés un à un par ceux de la maquette,
    sans jamais toucher au Studio qui sert en production.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <ApplicationIcon>..\Studio.App\Assets\studio-photo.ico</ApplicationIcon>
    <AssemblyName>Studio.Identite</AssemblyName>
    <RootNamespace>Studio.Identite</RootNamespace>

    <!-- DÉMARRAGE : le code est compilé D'AVANCE à la publication.

         Une application autonome sans ReadyToRun fait compiler par le processeur, au
         premier lancement, tout ce qu'elle exécute — et WPF en exécute beaucoup avant
         d'afficher quoi que ce soit. C'est ce qui fait qu'un logiciel .NET « met du temps
         à s'ouvrir » là où ID Maker paraît instantané. L'archive grossit ; le démarrage
         y gagne bien davantage.

         Sans effet sur la compilation de tous les jours : cela ne joue qu'au publish. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- le modèle de détection de visage, à côté de l'exécutable comme pour le Studio -->
    <Content Include="..\..\models\face_detection_yunet_2023mar.onnx"
             Link="models\face_detection_yunet_2023mar.onnx"
             CopyToOutputDirectory="PreserveNewest" />

    <!-- L'ÉCRAN D'ATTENTE. WPF l'affiche dès le lancement du processus et le fait
         disparaître de lui-même quand la fenêtre paraît — sans une ligne de code. Entre le
         double-clic et la fenêtre, l'opérateur n'avait rien du tout devant un client, et
         c'est exactement là que se joue l'impression d'instantanéité. -->
    <SplashScreen Include="..\Studio.App\Assets\studio-photo.png" Link="studio-photo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Studio.App\Studio.App.csproj" />
  </ItemGroup>

</Project>
