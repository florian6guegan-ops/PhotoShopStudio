<Application x:Class="Studio.Identite.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Le thème du Studio : les écrans réutilisés y cherchent leurs gabarits de
                     boutons, de listes et de champs. Sans lui, ils sortent sans habillage. -->
                <ResourceDictionary Source="pack://application:,,,/Studio.App;component/Theme.xaml"/>

                <!-- La PALETTE vient par-dessus, et elle est posée au démarrage par
                     App.AppliquerLaPalette : claire ou sombre, selon le réglage du poste.
                     Celle-ci est le défaut, pour que le concepteur d'écran voie quelque
                     chose de juste et que rien ne soit transparent si le démarrage échoue. -->
                <ResourceDictionary Source="ThemeClair.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
